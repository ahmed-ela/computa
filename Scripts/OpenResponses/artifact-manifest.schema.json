{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "file", "kind"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "kind": {"enum": ["response", "sse", "error", "request"]},
          "profile": {"enum": ["standard", "codex-custom-tools", "codex-local-usage"]},
          "expectStatus": {"enum": ["completed", "failed", "incomplete"]}
        }
      }
    }
  }
}
