[Unit]
Description=Kolmogor fixed-operation workspace broker
After=k3s.service
Requires=k3s.service
[Service]
ExecStart=/usr/bin/python3 -I /opt/kolmogor-workspace/accounts/broker.py
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
StateDirectory=kolmogor-broker
RuntimeDirectory=kolmogor-broker
RuntimeDirectoryMode=0755
Restart=on-failure
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
