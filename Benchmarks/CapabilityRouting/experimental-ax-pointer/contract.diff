+    func testElementClickHasADistinctNativeSingleClickContract() throws {
+        let schema = try spec(named: .elementClick)
+        XCTAssertEqual(schema.required, ["snapshot_id", "element_index"])
+        XCTAssertEqual(Set(schema.properties.keys), ["snapshot_id", "element_index"])
+        let snapshot = try XCTUnwrap(schema.properties["snapshot_id"] as? [String: Any])
+        XCTAssertEqual(snapshot["format"] as? String, "uuid")
+        XCTAssertEqual(snapshot["minLength"] as? Int, 36)
+        XCTAssertEqual(snapshot["maxLength"] as? Int, 36)
+        let index = try XCTUnwrap(schema.properties["element_index"] as? [String: Any])
+        XCTAssertEqual(index["type"] as? String, "integer")
+        XCTAssertEqual(index["minimum"] as? Int, 0)
+        let tool = try XCTUnwrap(ComputerV2ToolContract.specs.first { $0["name"] as? String == Tool.elementClick.rawValue })
+        let description = try XCTUnwrap(tool["description"] as? String)
+        for phrase in ["Single left click", "AXPress support is not required", "not capture_id or coordinates",
+                       "including ordinary Chrome", "brokered Chrome tabs are rejected", "Approval required", "fresh AX snapshot"] {
+            XCTAssertTrue(description.contains(phrase), phrase)
+        }
+        XCTAssertEqual(try spec(named: .click).required, ["capture_id", "x", "y"])
+        XCTAssertEqual(try spec(named: .ax).required, ["snapshot_id", "element_index", "ax_action"])
+        for modelID in ["lmstudio-community/Qwen3.5-4B-MLX-4bit", "lmstudio-community/Qwen3.5-9B-MLX-4bit", LocalModelCatalog.defaultModelID] {
+            XCTAssertTrue(ComputerV2ToolContract.specs(for: modelID).contains { $0["name"] as? String == Tool.elementClick.rawValue })
+        }
+    }
+
+    func testElementClickRejectsImageAndExpandedActionArguments() throws {
+        let valid: [String: Any] = ["snapshot_id": snapshotID, "element_index": 0]
+        for key in ["capture_id", "x", "y", "ax_action", "button", "click_count", "modifiers", "process_id", "bundle_id"] {
+            var expanded = valid; expanded[key] = "not allowed"
+            assertFailure(.unexpected(key), .elementClick, expanded)
+        }
+        assertFailure(.missing("snapshot_id"), .elementClick, ["element_index": 0])
+        assertFailure(.missing("element_index"), .elementClick, ["snapshot_id": snapshotID])
+        assertFailure(.missing("capture_id"), .click, valid)
+        assertFailure(.missing("ax_action"), .ax, valid)
+        let call = try ComputerV2ToolContract.validate(tool: Tool.elementClick.rawValue, arguments: valid)
+        XCTAssertNil(call.pointerAction)
+        XCTAssertNil(call.browserMode)
+    }
+
+    func testElementClickRequiresCanonicalUUIDAndExactNonnegativeInteger() throws {
+        let invalidSnapshotIDs: [Any] = ["", "stale", snapshotID + " ", " " + snapshotID,
+            snapshotID.replacingOccurrences(of: "-", with: ""), true, 1, NSNull()]
+        for invalid in invalidSnapshotIDs {
+            assertFailure(.invalid("snapshot_id"), .elementClick, ["snapshot_id": invalid, "element_index": 0])
+        }
+        let invalidIndices: [Any] = [-1, 0.5, true, "0", NSNull(), Double.nan, Double.infinity, NSNumber(value: UInt64.max)]
+        for invalid in invalidIndices {
+            assertFailure(.invalid("element_index"), .elementClick, ["snapshot_id": snapshotID, "element_index": invalid])
+        }
+        for index in [Int64(0), 1, Int64.max] {
+            let call = try ComputerV2ToolContract.validate(tool: Tool.elementClick.rawValue,
+                arguments: ["snapshot_id": snapshotID.lowercased(), "element_index": NSNumber(value: index)])
+            XCTAssertEqual(call.tool, .elementClick)
+        }
+    }
