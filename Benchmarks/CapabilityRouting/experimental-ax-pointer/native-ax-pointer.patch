index 0000000..f5cd15f
--- /dev/null
+++ b/Sources/AutomationCore/AccessibilityPointerTarget.swift
@@ -0,0 +1,352 @@
+import ApplicationServices
+import Foundation
+
+/// An immutable approval capability containing only retained native AX
+/// identities and value-type observation metadata. No mutable session or
+/// backend crosses actors. AX elements are opaque CF references; every AX
+/// read through this token is isolated to MainActor below. The references do
+/// not assert that the live UI is immutable: each dispatch revalidates it.
+public final class AccessibilityPointerTarget: @unchecked Sendable {
+    public let snapshotID: UUID
+    public let elementIndex: Int
+    public let processIdentifier: Int32
+    public let observedWindowFrame: WindowFrame
+
+    private let target: AXUIElement
+    private let window: AXUIElement
+    private let observedTarget: AccessibilityTreeElement
+    private let observedWindow: AccessibilityTreeElement
+    private let limits: AccessibilityTreeLimits
+
+    init(evidence: AccessibilityPointerTargetEvidence) throws {
+        guard CFGetTypeID(evidence.target.storage) == AXUIElementGetTypeID(),
+              CFGetTypeID(evidence.window.storage) == AXUIElementGetTypeID() else {
+            throw AccessibilityPointerTargetError.unavailable
+        }
+        _ = try AccessibilityPointerTargetValidator.point(
+            target: evidence.observedTarget.frame, window: evidence.observedWindow.frame
+        )
+        guard let frame = evidence.observedWindow.frame else {
+            throw AccessibilityPointerTargetError.invalidFrame
+        }
+        snapshotID = evidence.snapshotID
+        elementIndex = evidence.observedTarget.index
+        processIdentifier = evidence.processIdentifier
+        observedWindowFrame = frame
+        target = unsafeDowncast(evidence.target.storage, to: AXUIElement.self)
+        window = unsafeDowncast(evidence.window.storage, to: AXUIElement.self)
+        observedTarget = evidence.observedTarget
+        observedWindow = evidence.observedWindow
+        limits = evidence.limits
+    }
+
+    /// Returns an ephemeral screen-point target, never image coordinates.
+    /// The caller must also validate the task/approval epoch and window
+    /// z-order, then repeat this method immediately adjacent to its single
+    /// synchronous pointer dispatch. Do not retain a returned point across
+    /// an await or treat successful validation as action completion.
+    @MainActor
+    public func validatedPoint() throws -> ScreenPoint {
+        guard AXIsProcessTrusted() else {
+            throw AutomationError.permissionNotGranted(.accessibility)
+        }
+        let runtime = SystemAccessibilityTreeRuntime()
+        return try AccessibilityPointerTargetValidator.validate(
+            AccessibilityPointerTargetEvidence(
+                snapshotID: snapshotID,
+                processIdentifier: processIdentifier,
+                observedTarget: observedTarget,
+                observedWindow: observedWindow,
+                target: AccessibilityElementHandle(target),
+                window: AccessibilityElementHandle(window),
+                limits: limits
+            ),
+            runtime: runtime,
+            pointerRuntime: runtime
+        )
+    }
+}
+
+/// Internal, non-Sendable test boundary. Production tokens copy only the two
+/// verified native handles and immutable values, never this backend evidence.
+struct AccessibilityPointerTargetEvidence {
+    let snapshotID: UUID
+    let processIdentifier: Int32
+    let observedTarget: AccessibilityTreeElement
+    let observedWindow: AccessibilityTreeElement
+    let target: AccessibilityElementHandle
+    let window: AccessibilityElementHandle
+    let limits: AccessibilityTreeLimits
+}
+
+public enum AccessibilityPointerTargetError: Error, Equatable, LocalizedError, Sendable {
+    case unavailable
+    case invalidFrame
+    case changedTarget
+    case wrongWindow
+    case wrongProcess
+    case unverifiedHitTarget
+    case interactiveDescendant
+    case invalidAncestry
+
+    public var errorDescription: String? {
+        switch self {
+        case .unavailable:
+            return "Native Accessibility pointer target verification is unavailable. No input was sent."
+        case .invalidFrame:
+            return "The Accessibility target has no finite, positive frame contained in its window. No input was sent."
+        case .changedTarget:
+            return "The Accessibility target changed since observation. Observe again before clicking."
+        case .wrongWindow:
+            return "The original Accessibility window is not the focused target window. No input was sent."
+        case .wrongProcess:
+            return "The native hit target belongs to a different process. No input was sent."
+        case .unverifiedHitTarget:
+            return "The native hit target is not the observed element or its verified presentation descendant. No input was sent."
+        case .interactiveDescendant:
+            return "The native hit target contains an independently interactive descendant. Observe that target directly."
+        case .invalidAncestry:
+            return "The native hit target's bounded ancestry could not verify the original element and window. No input was sent."
+        }
+    }
+}
+
+/// Kept separate from descriptive AX reads: an unsupported backend must not
+/// accidentally inherit a permissive default for pointer target verification.
+protocol AccessibilityPointerRuntime {
+    func systemElement(at point: ScreenPoint) throws -> AccessibilityElementHandle?
+    func parent(of element: AccessibilityElementHandle) throws -> AccessibilityElementHandle?
+    func processIdentifier(of element: AccessibilityElementHandle) throws -> Int32
+    func pointerRole(of element: AccessibilityElementHandle) throws -> String
+    func hasNoninteractivePointerCapabilities(_ element: AccessibilityElementHandle) throws -> Bool
+}
+
+extension SystemAccessibilityTreeRuntime: AccessibilityPointerRuntime {
+    func systemElement(at point: ScreenPoint) throws -> AccessibilityElementHandle? {
+        var result: AXUIElement?
+        let status = AXUIElementCopyElementAtPosition(
+            AXUIElementCreateSystemWide(), Float(point.x), Float(point.y), &result
+        )
+        guard status == .success else {
+            throw AutomationError.accessibilityFailure(operation: "hit-test AX element", code: status.rawValue)
+        }
+        return result.map { AccessibilityElementHandle($0) }
+    }
+
+    func parent(of element: AccessibilityElementHandle) throws -> AccessibilityElementHandle? {
+        var result: CFTypeRef?
+        let status = AXUIElementCopyAttributeValue(
+            try pointerAXElement(element), kAXParentAttribute as CFString, &result
+        )
+        guard status == .success else {
+            throw AutomationError.accessibilityFailure(operation: "read hit-target AXParent", code: status.rawValue)
+        }
+        guard let result, CFGetTypeID(result) == AXUIElementGetTypeID() else {
+            throw AccessibilityPointerTargetError.invalidAncestry
+        }
+        return AccessibilityElementHandle(result as AnyObject)
+    }
+
+    func processIdentifier(of element: AccessibilityElementHandle) throws -> Int32 {
+        var pid: pid_t = 0
+        let status = AXUIElementGetPid(try pointerAXElement(element), &pid)
+        guard status == .success, pid > 0 else {
+            throw AccessibilityPointerTargetError.wrongProcess
+        }
+        return pid
+    }
+
+    func pointerRole(of element: AccessibilityElementHandle) throws -> String {
+        var result: CFTypeRef?
+        let status = AXUIElementCopyAttributeValue(
+            try pointerAXElement(element), kAXRoleAttribute as CFString, &result
+        )
+        guard status == .success, let role = result as? String, !role.isEmpty,
+              role.utf8.count <= 128 else {
+            throw AccessibilityPointerTargetError.invalidAncestry
+        }
+        return role
+    }
+
+    func hasNoninteractivePointerCapabilities(_ element: AccessibilityElementHandle) throws -> Bool {
+        let native = try pointerAXElement(element)
+        var actions: CFArray?
+        let actionStatus = AXUIElementCopyActionNames(native, &actions)
+        // A failed capability query is unknown, not proof of noninteractivity.
+        guard actionStatus == .success, let actions,
+              let names = actions as? [String] else {
+            throw AccessibilityPointerTargetError.unverifiedHitTarget
+        }
+        var valueSettable = DarwinBoolean(false)
+        let valueStatus = AXUIElementIsAttributeSettable(native, kAXValueAttribute as CFString, &valueSettable)
+        guard valueStatus == .success else {
+            throw AccessibilityPointerTargetError.unverifiedHitTarget
+        }
+        return names.isEmpty && !valueSettable.boolValue
+    }
+
+    private func pointerAXElement(_ element: AccessibilityElementHandle) throws -> AXUIElement {
+        guard CFGetTypeID(element.storage) == AXUIElementGetTypeID() else {
+            throw AutomationError.unexpectedAttributeType(attribute: "AXUIElement")
+        }
+        return unsafeDowncast(element.storage, to: AXUIElement.self)
+    }
+}
+
+enum AccessibilityPointerTargetValidator {
+    static let maximumAncestorCount = 32
+
+    static func validate(
+        _ evidence: AccessibilityPointerTargetEvidence,
+        runtime: any AccessibilityTreeRuntime,
+        pointerRuntime: any AccessibilityPointerRuntime
+    ) throws -> ScreenPoint {
+        guard evidence.observedWindow.role == "AXWindow",
+              !runtime.representsSameElement(evidence.target, evidence.window),
+              evidence.observedTarget.role != "AXWindow",
+              evidence.observedTarget.role != "AXApplication" else {
+            throw AccessibilityPointerTargetError.unverifiedHitTarget
+        }
+        try requireFocusedWindow(evidence, runtime: runtime)
+        guard try pointerRuntime.processIdentifier(of: evidence.window) == evidence.processIdentifier,
+              try pointerRuntime.processIdentifier(of: evidence.target) == evidence.processIdentifier else {
+            throw AccessibilityPointerTargetError.wrongProcess
+        }
+        let window = try runtime.describe(evidence.window, limits: evidence.limits)
+        let target = try runtime.describe(evidence.target, limits: evidence.limits)
+        guard window.role == "AXWindow", window.frame == evidence.observedWindow.frame else {
+            throw AccessibilityPointerTargetError.wrongWindow
+        }
+        guard sameSemantics(target, as: evidence.observedTarget) else {
+            throw AccessibilityPointerTargetError.changedTarget
+        }
+        let point = try point(target: target.frame, window: window.frame)
+        try verifyHit(
+            point: point, target: evidence.target, window: evidence.window,
+            processIdentifier: evidence.processIdentifier, limits: evidence.limits,
+            runtime: runtime, pointerRuntime: pointerRuntime
+        )
+        // Detect changes occurring during native hit-test/ancestry reads.
+        let finalTarget = try runtime.describe(evidence.target, limits: evidence.limits)
+        guard sameSemantics(finalTarget, as: evidence.observedTarget), finalTarget.frame == target.frame else {
+            throw AccessibilityPointerTargetError.changedTarget
+        }
+        let finalWindow = try runtime.describe(evidence.window, limits: evidence.limits)
+        guard finalWindow.role == "AXWindow", finalWindow.frame == window.frame else {
+            throw AccessibilityPointerTargetError.wrongWindow
+        }
+        try requireFocusedWindow(evidence, runtime: runtime)
+        return point
+    }
+
+    private static func requireFocusedWindow(
+        _ evidence: AccessibilityPointerTargetEvidence,
+        runtime: any AccessibilityTreeRuntime
+    ) throws {
+        guard try runtime.applicationIsFrontmost(processIdentifier: evidence.processIdentifier),
+              let focused = try runtime.focusedWindow(processIdentifier: evidence.processIdentifier),
+              runtime.representsSameElement(focused, evidence.window) else {
+            throw AccessibilityPointerTargetError.wrongWindow
+        }
+    }
+
+    static func point(target: WindowFrame?, window: WindowFrame?) throws -> ScreenPoint {
+        guard let target, let window, valid(target), valid(window),
+              target.x >= window.x, target.y >= window.y,
+              target.x + target.width <= window.x + window.width,
+              target.y + target.height <= window.y + window.height else {
+            throw AccessibilityPointerTargetError.invalidFrame
+        }
+        // AX hit-testing takes Float coordinates. Dispatch the exact same
+        // representable point, not a Double point on the other side of an edge.
+        let point = ScreenPoint(
+            x: Double(Float(target.x + target.width / 2)),
+            y: Double(Float(target.y + target.height / 2))
+        )
+        guard point.x.isFinite, point.y.isFinite,
+              contains(point, in: target), contains(point, in: window) else {
+            throw AccessibilityPointerTargetError.invalidFrame
+        }
+        return point
+    }
+
+    static func verifyHit(
+        point: ScreenPoint,
+        target: AccessibilityElementHandle,
+        window: AccessibilityElementHandle,
+        processIdentifier: Int32,
+        limits: AccessibilityTreeLimits,
+        runtime: any AccessibilityTreeRuntime,
+        pointerRuntime: any AccessibilityPointerRuntime
+    ) throws {
+        guard let hit = try pointerRuntime.systemElement(at: point) else {
+            throw AccessibilityPointerTargetError.unverifiedHitTarget
+        }
+        var current = hit
+        var visited = [AccessibilityElementHandle]()
+        var reachedTarget = false
+        for _ in 0 ..< maximumAncestorCount {
+            guard !visited.contains(where: { runtime.representsSameElement($0, current) }) else {
+                throw AccessibilityPointerTargetError.invalidAncestry
+            }
+            visited.append(current)
+            guard try pointerRuntime.processIdentifier(of: current) == processIdentifier else {
+                throw AccessibilityPointerTargetError.wrongProcess
+            }
+            if runtime.representsSameElement(current, target) {
+                reachedTarget = true
+            }
+            if runtime.representsSameElement(current, window) {
+                guard reachedTarget else { throw AccessibilityPointerTargetError.unverifiedHitTarget }
+                return
+            }
+            let role = try pointerRuntime.pointerRole(of: current)
+            guard role != "AXWindow", role != "AXApplication" else {
+                throw AccessibilityPointerTargetError.wrongWindow
+            }
+            if !reachedTarget {
+                // Labels and images may be presentation children of a button
+                // or row. An arbitrary group/control is not such evidence.
+                let description = try runtime.describe(current, limits: limits)
+                guard ["AXStaticText", "AXImage"].contains(description.role ?? ""),
+                      description.role == role,
+                      !description.wasTruncated,
+                      description.supportedActions.isEmpty,
+                      !description.isValueSettable,
+                      description.url == nil, description.urlIdentity == nil,
+                      try pointerRuntime.hasNoninteractivePointerCapabilities(current) else {
+                    throw AccessibilityPointerTargetError.interactiveDescendant
+                }
+            }
+            guard let parent = try pointerRuntime.parent(of: current) else {
+                throw AccessibilityPointerTargetError.invalidAncestry
+            }
+            current = parent
+        }
+        throw AccessibilityPointerTargetError.invalidAncestry
+    }
+
+    static func sameSemantics(_ current: AccessibilityElementDescription, as observed: AccessibilityTreeElement) -> Bool {
+        !current.wasTruncated
+            && current.role == observed.role && current.subrole == observed.subrole
+            && current.title == observed.title && current.elementDescription == observed.elementDescription
+            && current.help == observed.help && current.value == observed.value
+            && current.identifier == observed.identifier && current.domIdentifier == observed.domIdentifier
+            && current.url == observed.url && current.urlIdentity == observed.urlIdentity
+            && current.urlIdentity != .unverifiable && observed.urlIdentity != .unverifiable
+            && current.isEnabled == observed.isEnabled && current.isEnabled != false
+            && Set(current.supportedActions) == Set(observed.supportedActions)
+            && current.isValueSettable == observed.isValueSettable
+    }
+
+    private static func valid(_ frame: WindowFrame) -> Bool {
+        frame.x.isFinite && frame.y.isFinite && frame.width.isFinite && frame.height.isFinite
+            && frame.width > 0 && frame.height > 0
+            && (frame.x + frame.width).isFinite && (frame.y + frame.height).isFinite
+    }
+
+    private static func contains(_ point: ScreenPoint, in frame: WindowFrame) -> Bool {
+        point.x >= frame.x && point.y >= frame.y
+            && point.x < frame.x + frame.width && point.y < frame.y + frame.height
+    }
+}
