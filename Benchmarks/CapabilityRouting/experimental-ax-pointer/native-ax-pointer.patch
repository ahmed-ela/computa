@@ -0,0 +1,392 @@
+import Foundation
+import XCTest
+@testable import AutomationCore
+
+private final class PointerTestNode: NSObject {
+    var role: String
+    var title: String? = "Observed target"
+    var value: String?
+    var identifier: String? = "stable-id"
+    var url: String?
+    var urlIdentity: AccessibilityLinkDestinationIdentity?
+    var frame: WindowFrame?
+    var enabled: Bool? = true
+    var actions = [String]()
+    var settable = false
+    var truncated = false
+    var pid: Int32 = 42
+    weak var parent: PointerTestNode?
+    var children = [PointerTestNode]()
+
+    init(role: String = "AXStaticText", frame: WindowFrame? = WindowFrame(x: 100, y: 100, width: 200, height: 40)) {
+        self.role = role
+        self.frame = frame
+    }
+
+    func add(_ child: PointerTestNode) {
+        children.append(child)
+        child.parent = self
+    }
+}
+
+private final class PointerTestRuntime: AccessibilityTreeRuntime, AccessibilityPointerRuntime {
+    let window: PointerTestNode
+    var focused: PointerTestNode?
+    var frontmost = true
+    var hit: PointerTestNode?
+    var capabilityError = false
+    var descriptionError = false
+    var beforeHit: (() -> Void)?
+    var beforeParent: ((PointerTestNode) -> Void)?
+    var hitPoints = [ScreenPoint]()
+    var parentReads = 0
+    var applicationReads = 0
+    var mutationCount = 0
+
+    init(window: PointerTestNode, hit: PointerTestNode) {
+        self.window = window
+        self.focused = window
+        self.hit = hit
+    }
+
+    func node(_ handle: AccessibilityElementHandle) -> PointerTestNode {
+        handle.storage as! PointerTestNode
+    }
+
+    func applicationElement(processIdentifier: Int32) throws -> AccessibilityElementHandle {
+        applicationReads += 1
+        return AccessibilityElementHandle(window)
+    }
+
+    func applicationIsFrontmost(processIdentifier: Int32) throws -> Bool { frontmost }
+
+    func focusedWindow(processIdentifier: Int32) throws -> AccessibilityElementHandle? {
+        focused.map(AccessibilityElementHandle.init)
+    }
+
+    func describe(_ element: AccessibilityElementHandle, limits: AccessibilityTreeLimits) throws -> AccessibilityElementDescription {
+        if descriptionError { throw AccessibilityPointerTargetError.unavailable }
+        let node = node(element)
+        return AccessibilityElementDescription(
+            role: node.role, subrole: nil, title: node.title, elementDescription: nil,
+            help: nil, identifier: node.identifier, domIdentifier: nil, value: node.value,
+            frame: node.frame, isEnabled: node.enabled, isFocused: false,
+            supportedActions: node.actions, isValueSettable: node.settable,
+            wasTruncated: node.truncated, url: node.url, urlIdentity: node.urlIdentity
+        )
+    }
+
+    func children(of element: AccessibilityElementHandle, limit: Int) throws -> AccessibilityChildBatch {
+        let children = node(element).children
+        return AccessibilityChildBatch(
+            elements: children.prefix(limit).map(AccessibilityElementHandle.init),
+            wasTruncated: children.count > limit
+        )
+    }
+
+    func representsSameElement(_ lhs: AccessibilityElementHandle, _ rhs: AccessibilityElementHandle) -> Bool {
+        node(lhs) === node(rhs)
+    }
+
+    func identityHash(for element: AccessibilityElementHandle) -> Int { ObjectIdentifier(node(element)).hashValue }
+    func supportedActions(for element: AccessibilityElementHandle) throws -> [String] { node(element).actions }
+    func isValueSettable(on element: AccessibilityElementHandle) throws -> Bool { node(element).settable }
+    func perform(action: String, on element: AccessibilityElementHandle) throws { mutationCount += 1 }
+    func set(value: AccessibilitySetValue, on element: AccessibilityElementHandle) throws { mutationCount += 1 }
+
+    func systemElement(at point: ScreenPoint) throws -> AccessibilityElementHandle? {
+        hitPoints.append(point)
+        beforeHit?()
+        return hit.map(AccessibilityElementHandle.init)
+    }
+
+    func parent(of element: AccessibilityElementHandle) throws -> AccessibilityElementHandle? {
+        parentReads += 1
+        let current = node(element)
+        beforeParent?(current)
+        return current.parent.map(AccessibilityElementHandle.init)
+    }
+
+    func processIdentifier(of element: AccessibilityElementHandle) throws -> Int32 { node(element).pid }
+    func pointerRole(of element: AccessibilityElementHandle) throws -> String { node(element).role }
+
+    func hasNoninteractivePointerCapabilities(_ element: AccessibilityElementHandle) throws -> Bool {
+        if capabilityError { throw AccessibilityPointerTargetError.unverifiedHitTarget }
+        return node(element).actions.isEmpty && !node(element).settable
+    }
+}
+
+private final class PointerTestFixture {
+    let window = PointerTestNode(role: "AXWindow", frame: WindowFrame(x: 0, y: 0, width: 800, height: 600))
+    let target = PointerTestNode()
+    let runtime: PointerTestRuntime
+    let session: AccessibilitySession
+    let snapshot: AccessibilityTreeSnapshot
+
+    init(permission: @escaping () -> Bool = { true }) throws {
+        window.add(target)
+        runtime = PointerTestRuntime(window: window, hit: target)
+        session = AccessibilitySession(
+            target: AccessibilityApplicationTarget(processIdentifier: 42),
+            runtime: runtime, accessibilityCheck: permission
+        )
+        snapshot = try session.snapshot()
+    }
+
+    func evidence() throws -> AccessibilityPointerTargetEvidence {
+        try session.pointerTargetEvidence(at: 1, in: snapshot)
+    }
+
+    func validate(_ evidence: AccessibilityPointerTargetEvidence? = nil) throws -> ScreenPoint {
+        try AccessibilityPointerTargetValidator.validate(evidence ?? self.evidence(), runtime: runtime, pointerRuntime: runtime)
+    }
+}
+
+final class AccessibilityPointerTargetTests: XCTestCase {
+    func testExactObservedLabelWithNoAXPressUsesNativePointWithoutDispatchOrTreeRebind() throws {
+        let fixture = try PointerTestFixture()
+        XCTAssertTrue(fixture.snapshot.elements[1].supportedActions.isEmpty)
+        XCTAssertEqual(try fixture.validate(), ScreenPoint(x: 200, y: 120))
+        XCTAssertEqual(fixture.runtime.hitPoints, [ScreenPoint(x: 200, y: 120)])
+        XCTAssertEqual(fixture.runtime.applicationReads, 1, "Validation must not reacquire/rebind a different target tree")
+        XCTAssertEqual(fixture.runtime.mutationCount, 0)
+    }
+
+    func testSameIdentityMayMoveInsideUnchangedWindowAndUsesItsFreshPoint() throws {
+        let fixture = try PointerTestFixture()
+        let evidence = try fixture.evidence()
+        fixture.target.frame = WindowFrame(x: 140, y: 160, width: 200, height: 40)
+        XCTAssertEqual(try fixture.validate(evidence), ScreenPoint(x: 240, y: 180))
+    }
+
+    func testStaticTextAndImagePresentationDescendantsAreAllowed() throws {
+        for role in ["AXStaticText", "AXImage"] {
+            let fixture = try PointerTestFixture()
+            let child = PointerTestNode(role: role)
+            fixture.target.add(child)
+            fixture.runtime.hit = child
+            XCTAssertEqual(try fixture.validate(), ScreenPoint(x: 200, y: 120))
+        }
+    }
+
+    func testAncestorSiblingAndSameLabelReplacementAreNeverRetargeted() throws {
+        for kind in ["ancestor", "sibling", "replacement"] {
+            let fixture = try PointerTestFixture()
+            let evidence = try fixture.evidence()
+            let replacement = PointerTestNode()
+            fixture.window.add(replacement)
+            fixture.runtime.hit = kind == "ancestor" ? fixture.window : replacement
+            if kind == "replacement" {
+                fixture.window.children = [replacement]
+                fixture.target.parent = nil
+            }
+            XCTAssertThrowsError(try fixture.validate(evidence), kind)
+            XCTAssertEqual(fixture.runtime.mutationCount, 0)
+        }
+    }
+
+    func testInteractiveOrUnknownDescendantsAreRejectedEvenInsideTargetFrame() throws {
+        let variants: [(PointerTestNode) -> Void] = [
+            { $0.role = "AXButton" },
+            { $0.role = "AXGroup" },
+            { $0.actions = ["AXPress"] },
+            { $0.settable = true },
+            { $0.url = "https://example.test/action" },
+            { $0.truncated = true },
+        ]
+        for mutate in variants {
+            let fixture = try PointerTestFixture()
+            let child = PointerTestNode()
+            fixture.target.add(child)
+            fixture.runtime.hit = child
+            mutate(child)
+            XCTAssertThrowsError(try fixture.validate()) {
+                XCTAssertEqual($0 as? AccessibilityPointerTargetError, .interactiveDescendant)
+            }
+        }
+    }
+
+    func testFailedCapabilityReadIsNotProofOfNoninteractivity() throws {
+        let fixture = try PointerTestFixture()
+        let child = PointerTestNode()
