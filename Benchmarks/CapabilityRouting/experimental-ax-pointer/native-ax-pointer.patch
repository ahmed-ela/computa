+    func testCyclesMissingParentsAndExcessiveDepthAreBounded() throws {
+        for kind in ["cycle", "missing", "depth"] {
+            let fixture = try PointerTestFixture()
+            var retained = [PointerTestNode]()
+            if kind == "cycle" {
+                fixture.target.parent = fixture.target
+            } else if kind == "missing" {
+                fixture.target.parent = nil
+            } else {
+                var tail = fixture.target
+                for _ in 0 ..< AccessibilityPointerTargetValidator.maximumAncestorCount {
+                    let parent = PointerTestNode(role: "AXGroup")
+                    parent.add(tail)
+                    retained.append(parent)
+                    tail = parent
+                }
+                fixture.window.add(tail)
+            }
+            XCTAssertThrowsError(try fixture.validate()) {
+                XCTAssertEqual($0 as? AccessibilityPointerTargetError, .invalidAncestry)
+            }
+            XCTAssertLessThanOrEqual(fixture.runtime.parentReads, AccessibilityPointerTargetValidator.maximumAncestorCount)
+            withExtendedLifetime(retained) {}
+        }
+    }
