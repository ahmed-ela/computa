{
  "name": "computa",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/download",
      "/download/"
    ]
  },
  "routes": [
    {
      "pattern": "computa.wtf",
      "custom_domain": true
    }
  ],
  "main": "download-worker.js"
}
