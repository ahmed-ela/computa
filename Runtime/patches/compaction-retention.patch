+fn native_read_ledger_keeps_exact_local_records_and_readable_chronology() {
+    let mut original = proven_native_read("first-read", "turn", false);
+    original.extend(proven_native_read("inventory", "turn", true));
+    original.extend(pair("actual-input", "turn", "input completed; outcome unverified"));
+    original.extend(proven_native_read("last-read", "turn", false));
+    let packed = packed_native_reads(&original, "turn", &[7]);
+    assert_eq!(packed.len(), 5);
+    let run = packed[0].metadata.as_ref().unwrap().native_completed_reads.as_ref().unwrap();
+    assert_eq!(run.records.len(), 2);
+    assert_eq!(run.records[0].arguments, r#"{"view":"content","query":"exact \"query\""}"#);
+    assert!(run.display().unwrap().ends_with("Read content; query=\"exact \\\"query\\\"\".\nInventory page."));
+    assert_eq!(&packed[1..], &original[4..]);
+    let expanded = native_read_ledger::expand(&packed, "turn").unwrap();
+    for index in [0, 2, 4, 6] { assert_eq!(expanded.items[index], original[index]); }
+    for index in [1, 3] {
+        assert_eq!(expanded.items[index].metadata, original[index].metadata);
+        let ResponseItem::FunctionCallOutput { output, .. } = &expanded.items[index].item else { unreachable!() };
+        assert_eq!(output.success, Some(true));
+        assert_eq!(output.body, FunctionCallOutputBody::Text(codex_history::native_browser_reads::NATIVE_READ_OMISSION.into()));
+        let mut restored = expanded.items[index].clone();
+        if let (ResponseItem::FunctionCallOutput { output: restored_output, .. }, ResponseItem::FunctionCallOutput { output: original_output, .. }) = (&mut restored.item, &original[index].item) { *restored_output = original_output.clone(); }
+        assert_eq!(restored, original[index]);
+    }
+    // Persisted typed metadata, rather than model-readable prose, reconstructs it.
+    let items: Vec<_> = packed.iter().map(|item| item.item.clone()).collect();
+    let metadata: Vec<_> = packed.iter().map(|item| item.metadata.clone()).collect();
+    let items: Vec<ResponseItem> = serde_json::from_slice(&serde_json::to_vec(&items).unwrap()).unwrap();
+    let metadata: Vec<Option<CodexHarnessMetadata>> = serde_json::from_slice(&serde_json::to_vec(&metadata).unwrap()).unwrap();
+    let reloaded: Vec<_> = items.into_iter().zip(metadata).map(|(item, metadata)| ResponseItemEnvelope { item, metadata }).collect();
+    let after = native_read_ledger::expand(&reloaded, "turn").unwrap();
+    assert_eq!(after.previously_omitted, expanded.previously_omitted);
+    let indexed: Vec<_> = after.items.into_iter().enumerate().collect();
+    let again: Vec<_> = native_read_ledger::pack(&indexed, &expanded.items, "turn", &[7], &after.previously_omitted, &after.prior_run_starts, &after.prior_run_ids).unwrap().into_iter().map(|(_, item)| item).collect();
+    assert_eq!(again[0], packed[0]);
+}
