+        output.body = FunctionCallOutputBody::ContentItems(vec![
+            FunctionCallOutputContentItem::InputText {
+                text: COMPLETE_BROWSER_OBSERVATION_MARKER.to_string(),
+            },
+            FunctionCallOutputContentItem::InputText { text: page.to_string() },
+        ]);
