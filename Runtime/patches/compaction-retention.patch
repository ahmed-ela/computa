+//! Request-local evidence that exact current-turn user text remains in input.
+//! This is not authority to alter history. The local API bridge independently
+//! matches these bytes against its admitted original request and accepted steers.
+
+use std::collections::HashMap;
+
+use codex_api::ResponsesApiRequest;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use sha2::Digest;
+use sha2::Sha256;
+use uuid::Uuid;
+
+use crate::responses_metadata::CURRENT_USER_TEXT_PROOF_KEY;
+
+// Mirror existing bridge admission limits; exceeding any omits the optional
+// proof and leaves its established user-reminder fallback in place.
+const MAX_INPUT_ITEMS: usize = 8_192;
+const MAX_USER_INPUTS: usize = 1_024;
+const MAX_USER_BYTES: usize = 2_000_000;
+const MAX_METADATA_BYTES: usize = 16_384;
+const MAX_HTTP_BODY_BYTES: usize = 2_000_000;
+const DOMAIN: &[u8] = b"computa.current_user_text.v1\0";
+
+/// Called only for an explicitly ordinary native turn, on finalized input before
+/// provenance stripping. Re-ID is irrelevant; indices identify this request.
+pub(super) fn add_to_request(
+    input: &[ResponseItem],
+    thread_id: &str,
+    turn_id: &str,
+    metadata: &mut HashMap<String, String>,
+) {
+    // Defensive removal also makes accidental reuse fail closed. External
+    // client/config metadata is separately forbidden from supplying this key.
+    metadata.remove(CURRENT_USER_TEXT_PROOF_KEY);
+    let Some(proof) = proof(input, thread_id, turn_id) else {
+        return;
+    };
+    metadata.insert(CURRENT_USER_TEXT_PROOF_KEY.to_string(), proof);
+    if !serde_json::to_vec(metadata).is_ok_and(|bytes| bytes.len() <= MAX_METADATA_BYTES) {
+        metadata.remove(CURRENT_USER_TEXT_PROOF_KEY);
+    }
+}
+
+/// Check the finalized HTTP request, after all normal request preparation. An
+/// optional proof must not make a previously admissible bridge body too large.
+/// Requests without the proof keep their existing serialization/error behavior.
+pub(super) fn enforce_http_body_budget(request: &mut ResponsesApiRequest) {
+    if !request
+        .client_metadata
+        .as_ref()
+        .is_some_and(|metadata| metadata.contains_key(CURRENT_USER_TEXT_PROOF_KEY))
+    {
+        return;
+    }
+    if !serde_json::to_vec(&*request).is_ok_and(|bytes| bytes.len() <= MAX_HTTP_BODY_BYTES)
+        && let Some(metadata) = request.client_metadata.as_mut()
+    {
+        metadata.remove(CURRENT_USER_TEXT_PROOF_KEY);
+    }
+}
+
+/// WebSocket deltas can change input positions. This v1 proof is HTTP-only;
+/// suppress it before any incremental input or previous-response shaping.
+pub(super) fn remove_for_websocket(request: &mut ResponsesApiRequest) {
+    if let Some(metadata) = request.client_metadata.as_mut() {
+        metadata.remove(CURRENT_USER_TEXT_PROOF_KEY);
+    }
+}
+
+fn proof(input: &[ResponseItem], thread_id: &str, turn_id: &str) -> Option<String> {
+    if input.len() > MAX_INPUT_ITEMS {
+        return None;
+    }
+    let thread = Uuid::parse_str(thread_id).ok()?.to_string();
+    let turn = Uuid::parse_str(turn_id).ok()?;
+    let mut entries = Vec::<(usize, &str)>::new();
+    let mut bytes = 0usize;
+    for (index, item) in input.iter().enumerate() {
+        let ResponseItem::Message {
+            role,
+            content,
+            phase,
+            internal_chat_message_metadata_passthrough: Some(native),
+            ..
+        } = item
+        else {
+            continue;
+        };
+        if role != "user"
+            || native
+                .turn_id
+                .as_deref()
+                .and_then(|id| Uuid::parse_str(id).ok())
+                != Some(turn)
+        {
+            continue;
+        }
+        let kinds = native.content_item_kinds.as_ref()?;
+        if kinds.len() != content.len() {
+            return None;
+        }
+        if !kinds.iter().any(|kind| kind.0 == "user.text") {
+            continue; // Typed environment/summary data is never human input.
+        }
+        // Multi-part or mixed contextual messages cannot establish the exact
+        // one-input-per-native-message contract. Do not guess a separator.
+        if phase.is_some() || kinds.len() != 1 || kinds[0].0 != "user.text" {
+            return None;
+        }
+        let [ContentItem::InputText { text }] = content.as_slice() else {
+            return None;
+        };
+        bytes = bytes.checked_add(text.len())?;
+        if text.is_empty() || bytes > MAX_USER_BYTES || entries.len() == MAX_USER_INPUTS {
+            return None;
+        }
+        entries.push((index, text));
+    }
+    if entries.is_empty() {
+        return None;
+    }
+    let mut hash = Sha256::new();
+    hash.update(DOMAIN);
+    let canonical_turn = turn.to_string();
+    for value in [thread.as_str(), canonical_turn.as_str(), "turn"] {
+        hash.update((value.len() as u64).to_be_bytes());
+        hash.update(value.as_bytes());
+    }
+    hash.update((entries.len() as u64).to_be_bytes());
+    for (index, text) in &entries {
+        hash.update((*index as u64).to_be_bytes());
+        hash.update((text.len() as u64).to_be_bytes());
+        hash.update(text.as_bytes());
+    }
+    let digest = format!("{:x}", hash.finalize());
+    serde_json::to_string(&serde_json::json!({
+        "indices": entries.iter().map(|(index, _)| *index).collect::<Vec<_>>(),
+        "sha256": digest,
+    }))
+    .ok()
+}
