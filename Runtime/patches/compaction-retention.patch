+        output.body = FunctionCallOutputBody::ContentItems(vec![
+            FunctionCallOutputContentItem::InputText { text: COMPLETE_BROWSER_OBSERVATION_MARKER.to_string() },
+            FunctionCallOutputContentItem::InputText { text: json!({"kind":kind,"completed":true,"outcome":"unverified"}).to_string() },
+            FunctionCallOutputContentItem::InputText { text: body.to_string() },
+        ]);
+    }
+    history
+}
