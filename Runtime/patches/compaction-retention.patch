+/// Keep the historical snapshot placeholder without making padding depend on the build version.
+/// Validate the real header before normalizing it; the placeholder is wider than 0.0.0.
+pub(crate) fn normalize_session_header_version(frame: &str) -> String {
+    let version = crate::version::CODEX_CLI_VERSION;
+    let tag = format!("(v{version})");
+    let prefix = format!("│ >_ OpenAI Codex {tag}");
+    let rows = frame.split('\n').collect::<Vec<_>>();
+    rows.iter()
+        .enumerate()
+        .map(|(index, line)| {
+            if !line.contains(&tag) {
+                return (*line).to_string();
+            }
+            let padding = line
+                .strip_prefix(&prefix)
+                .and_then(|suffix| suffix.strip_suffix('│'))
+                .expect("compiled-version header must retain its title and right border");
+            assert!(
+                padding.chars().all(|character| character == ' '),
+                "header must contain only padding after the compiled version"
+            );
+            let border = rows[index.checked_sub(1).expect("header follows its top border")];
+            assert!(border.starts_with('╭') && border.ends_with('╮'));
+            assert_eq!(
+                line.chars().count(),
+                border.chars().count(),
+                "compiled-version header must align with the real border"
+            );
+            let stable_padding = padding.len()
+                + version
+                    .len()
+                    .checked_sub("0.0.0".len())
+                    .expect("compiled semantic version is at least as long as 0.0.0");
+            format!(
+                "│ >_ OpenAI Codex (v<VERSION>){}│",
+                " ".repeat(stable_padding)
+            )
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
