+fn complete_browser_action_pair(id: &str, kind: &str, page: &str) -> Vec<ResponseItemEnvelope> {
+    let mut history = complete_browser_pair(id, page);
+    if let ResponseItem::FunctionCall { name, arguments, .. } = &mut history[0].item {
+        *name = format!("browser_{kind}");
+        *arguments = if kind == "fill" {
+            json!({"fill_ref":"bfill_current", "text":"exact input e\u{301} 😀"}).to_string()
+        } else {
+            json!({"click_ref":"bclick_current"}).to_string()
+        };
