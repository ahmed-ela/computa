+            if let EventMsg::ItemCompleted(completed) = event.msg {
+                let TurnItem::CommandExecution(item) = completed.item else {
+                    panic!("expected CommandExecution");
+                };
+                return item;
+            }
+        }
+    })
+    .await
+    .expect("command completed")
+}
