+#[test_case::test_case(ReceiptFixture::MixedImages; "mixed_images")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn local_mid_turn_compaction_atomically_preserves_real_current_turn_receipts(
