+        output.body = FunctionCallOutputBody::ContentItems(vec![
+            FunctionCallOutputContentItem::InputText { text: COMPLETE_BROWSER_OBSERVATION_MARKER.to_string() },
+            FunctionCallOutputContentItem::InputText { text: json!({
+                "kind":kind, "label":"Subject", "partial":false,
+                "dispatched":true, "outcome":"unverified"
+            }).to_string() },
+            FunctionCallOutputContentItem::InputText { text: json!({
+                "dispatched":true, "no_replay":true, "result_verified":false, "input_kind":kind,
+                "current_observation":{"status":"available", "text":page}
