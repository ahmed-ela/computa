diff --git a/codex-rs/history/src/native_browser_reads.rs b/codex-rs/history/src/native_browser_reads.rs
new file mode 100644
index 0000000..8582f3f
--- /dev/null
+++ b/codex-rs/history/src/native_browser_reads.rs
@@ -0,0 +1,265 @@
+//! History-only, versioned receipts for completed native browser reads.
+//!
+//! This is deliberately not a public Responses item or a replay format. The
+//! original rollout keeps page bodies; this projection preserves identity and
+//! successful read completion while explicitly omitting old page detail.
+
+use std::collections::HashSet;
+
+use codex_protocol::ResponseItemId;
+use codex_protocol::dynamic_tools::NativeBrowserRead;
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+
+pub const NATIVE_READ_NOTICE: &str = "Completed native browser reads in order; old page content omitted. Not content/absence proof or current references; no replay authority.";
+pub const NATIVE_READ_OMISSION: &str = "Completed native browser read; historical page detail omitted. Not content or absence evidence, current references, or replay authority.";
+
+/// Compact field names are a fixed v1 storage encoding, never model input.
+/// There is no dictionary, schema inference, or user-controlled field mapping.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct NativeCompletedRead {
+    #[serde(rename = "n")]
+    pub ordinal: u8,
+    #[serde(rename = "k")]
+    pub kind: NativeBrowserRead,
+    #[serde(rename = "c")]
+    pub call_id: String,
+    #[serde(rename = "ci", default, skip_serializing_if = "Option::is_none")]
+    pub call_item_id: Option<ResponseItemId>,
+    #[serde(rename = "oi", default, skip_serializing_if = "Option::is_none")]
+    pub output_item_id: Option<ResponseItemId>,
+    #[serde(rename = "a")]
+    pub arguments: String,
+    #[serde(rename = "ct", default, skip_serializing_if = "Option::is_none")]
+    #[schemars(with = "Option<f64>")]
+    pub call_time: Option<serde_json::Number>,
+    #[serde(rename = "ot", default, skip_serializing_if = "Option::is_none")]
+    #[schemars(with = "Option<f64>")]
+    pub output_time: Option<serde_json::Number>,
+    #[serde(rename = "m")]
+    pub call_metadata_present: bool,
+    #[serde(rename = "s")]
+    pub success_present: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema)]
+#[serde(deny_unknown_fields)]
+pub struct NativeCompletedReads {
+    pub version: u8,
+    pub turn_id: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_token_limit: Option<usize>,
+    /// Only the first physical run needs the shared model-visible omission notice.
+    pub notice: bool,
+    pub records: Vec<NativeCompletedRead>,
+}
+
+impl NativeCompletedReads {
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if self.version != 1
+            || self.turn_id.is_empty()
+            || self.turn_id.len() > 256
+            || self.records.is_empty()
+            || self.records.len() > 32
+        {
+            return Err("invalid native read ledger version, turn, or count");
+        }
+        let mut ids = HashSet::new();
+        let mut previous = None;
+        for record in &self.records {
+            if record.ordinal >= 32
+                || previous.is_some_and(|ordinal| record.ordinal != ordinal + 1)
+                || record.call_id.is_empty()
+                || !ids.insert(record.call_id.as_str())
+                || record.call_id.len() > 24 * 1024
+                || record.arguments.len() > 24 * 1024
+                || record
+                    .call_item_id
+                    .as_ref()
+                    .is_some_and(|id| id.is_empty() || id.len() > 24 * 1024)
+                || record
+                    .output_item_id
+                    .as_ref()
+                    .is_some_and(|id| id.is_empty() || id.len() > 24 * 1024)
+            {
+                return Err("invalid native read ledger identity or order");
+            }
+            record.display_line()?;
+            previous = Some(record.ordinal);
+        }
+        if serde_json::to_vec(self)
+            .map_err(|_| "native read ledger serialization failed")?
+            .len()
+            > 24 * 1024
+        {
+            return Err("native read ledger exceeds the canonical receipt bound");
+        }
+        Ok(())
+    }
+
+    pub fn display(&self) -> Result<String, &'static str> {
+        self.validate()?;
+        let mut lines = Vec::new();
+        if self.notice {
+            lines.push(NATIVE_READ_NOTICE.to_string());
+        }
+        for record in &self.records {
+            lines.push(record.display_line()?);
+        }
+        Ok(lines.join("\n"))
+    }
+}
+
+impl NativeCompletedRead {
+    pub fn tool_name(&self) -> &'static str {
+        match self.kind {
+            NativeBrowserRead::ReadV1 => "browser_read",
+            NativeBrowserRead::InventoryV1 => "browser_tabs",
+        }
+    }
+
+    fn display_line(&self) -> Result<String, &'static str> {
+        let value: serde_json::Value =
+            serde_json::from_str(&self.arguments).map_err(|_| "invalid native read arguments")?;
+        let arguments = value
+            .as_object()
+            .ok_or("native read arguments must be an object")?;
+        let cursor = arguments.get("cursor");
+        if cursor.is_some_and(|value| {
+            !value.is_null() && !value.as_str().is_some_and(|value| !value.is_empty())
+        }) {
+            return Err("invalid native read cursor");
+        }
+        match self.kind {
+            NativeBrowserRead::InventoryV1 => {
+                if arguments.keys().any(|key| key != "cursor") {
+                    return Err("unknown native inventory argument");
+                }
+                Ok("Inventory page.".to_string())
+            }
+            NativeBrowserRead::ReadV1 => {
+                if arguments
+                    .keys()
+                    .any(|key| !matches!(key.as_str(), "cursor" | "view" | "query"))
+                {
+                    return Err("unknown native read argument");
+                }
+                let mut text = if cursor.is_some_and(serde_json::Value::is_string) {
+                    "Continue"
+                } else {
+                    "Read"
+                }
+                .to_string();
+                if let Some(view) = arguments.get("view") {
+                    let view = view
+                        .as_str()
+                        .filter(|view| {
+                            matches!(*view, "overview" | "content" | "all" | "headings" | "links")
+                        })
+                        .ok_or("invalid native read view")?;
+                    text.push(' ');
+                    text.push_str(view);
+                }
+                if let Some(query) = arguments.get("query") {
+                    let query = query.as_str().ok_or("invalid native read query")?;
+                    text.push_str("; query=");
+                    text.push_str(
+                        &serde_json::to_string(query)
+                            .map_err(|_| "native query serialization failed")?,
+                    );
+                }
+                text.push('.');
+                Ok(text)
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn run() -> NativeCompletedReads {
+        NativeCompletedReads {
+            version: 1,
+            turn_id: "native-turn".into(),
+            output_token_limit: Some(4096),
+            notice: true,
+            records: vec![NativeCompletedRead {
+                ordinal: 3,
+                kind: NativeBrowserRead::ReadV1,
+                call_id: "call-read".into(),
+                call_item_id: Some(ResponseItemId::from_server("fc_read".into())),
+                output_item_id: Some(ResponseItemId::from_server("fco_read".into())),
+                arguments: "{\"view\":\"content\",\"query\":\"a\\\"b\\ncafé\"}".into(),
+                call_time: Some(serde_json::Number::from(10)),
+                output_time: Some(serde_json::Number::from(11)),
+                call_metadata_present: false,
+                success_present: true,
+            }],
+        }
+    }
+
+    #[test]
+    fn native_completed_reads_roundtrip_keeps_raw_identity_and_escaped_query_data() {
+        let original = run();
+        let encoded = serde_json::to_vec(&original).unwrap();
+        let decoded: NativeCompletedReads = serde_json::from_slice(&encoded).unwrap();
+        assert_eq!(original, decoded);
+        assert_eq!(
+            decoded.display().unwrap(),
+            format!("{NATIVE_READ_NOTICE}\nRead content; query=\"a\\\"b\\ncafé\".")
+        );
+        assert!(decoded.display().unwrap().lines().count() == 2);
+    }
+
+    #[test]
+    fn native_completed_reads_validate_version_count_order_and_closed_arguments() {
+        for changed in [0, 2] {
+            let mut value = run();
+            value.version = changed;
+            assert!(value.validate().is_err());
+        }
+        let mut value = run();
+        value.records.clear();
+        assert!(value.validate().is_err());
+        let mut value = run();
+        value.records[0].ordinal = 32;
+        assert!(value.validate().is_err());
+        for arguments in [
+            r#"{"view":"unknown"}"#,
+            r#"{"query":null}"#,
+            r#"{"cursor":""}"#,
+            r#"{"query":"ok","unknown":true}"#,
+        ] {
+            let mut value = run();
+            value.records[0].arguments = arguments.into();
+            assert!(value.validate().is_err());
+        }
+        let mut value = run();
+        value.records.push(value.records[0].clone());
+        assert!(value.validate().is_err());
+        value.records[1].call_id = "another".into();
+        value.records[1].ordinal = 5;
+        assert!(value.validate().is_err());
+        value.records[1].ordinal = 4;
+        assert!(value.validate().is_ok());
+        let mut encoded = serde_json::to_value(run()).unwrap();
+        encoded["unexpected"] = true.into();
+        assert!(serde_json::from_value::<NativeCompletedReads>(encoded).is_err());
+    }
+
+    #[test]
+    fn native_completed_reads_inventory_claims_only_a_page_and_never_a_count() {
+        let mut value = run();
+        value.records[0].kind = NativeBrowserRead::InventoryV1;
+        value.records[0].arguments = r#"{"cursor":null}"#.into();
+        assert!(value.display().unwrap().ends_with("Inventory page."));
+        value.records[0].arguments = r#"{"cursor":"exact-token"}"#.into();
+        assert!(value.display().unwrap().ends_with("Inventory page."));
+        value.records[0].arguments = r#"{"count":2}"#.into();
+        assert!(value.validate().is_err());
+    }
+}
