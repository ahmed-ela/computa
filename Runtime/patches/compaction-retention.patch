+/// Apply the external-provider wire projection without changing canonical history.
+pub(crate) fn prepare_input_for_non_openai_provider(input: &mut [ResponseItem]) {
+    for item in input {
+        // Local compaction stores typed historical notes as contextual user
+        // fragments. External providers lose that provenance below; preserve
+        // their assistant origin instead of granting generated notes user
+        // authority. Only a complete, purely typed text summary is eligible.
+        // Mixed or malformed provenance must never reclassify genuine user text.
+        if let ResponseItem::Message {
+            role,
+            content,
+            internal_chat_message_metadata_passthrough,
+            ..
+        } = item
+            && role == "user"
+            && !content.is_empty()
+            && content
+                .iter()
+                .all(|part| matches!(part, codex_protocol::models::ContentItem::InputText { .. }))
+            && internal_chat_message_metadata_passthrough
+                .as_ref()
+                .and_then(|metadata| metadata.content_item_kinds.as_ref())
+                .is_some_and(|kinds| {
+                    kinds.len() == content.len()
+                        && kinds.iter().all(|kind| kind.0 == "compaction.summary")
+                })
+        {
+            *role = "assistant".to_string();
+            for part in content {
+                if let codex_protocol::models::ContentItem::InputText { text } = part {
+                    *part = codex_protocol::models::ContentItem::OutputText {
+                        text: std::mem::take(text),
+                    };
+                }
+            }
+        }
+        item.clear_internal_chat_message_metadata_passthrough();
+        if let ResponseItem::FunctionCall {
+            encrypted_function_args,
+            ..
+        } = item
+        {
+            *encrypted_function_args = None;
+        }
+    }
+}
