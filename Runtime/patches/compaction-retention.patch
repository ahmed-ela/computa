+fn external_receipt_bytes(history: &[ResponseItemEnvelope]) -> usize {
+    let mut items: Vec<_> = history.iter().map(|entry| entry.item.clone()).collect();
+    prepare_input_for_non_openai_provider(&mut items);
+    serde_json::to_vec(&items).unwrap().len()
+}
