+// Keep the original regressions on the strict, unprojected provider path.
+fn current_turn_receipts(
+    history: &[ResponseItemEnvelope],
+    turn_id: &str,
+) -> Result<Vec<ResponseItemEnvelope>> {
+    super::current_turn_receipts(history, turn_id, ReceiptProvider::OpenAI)
+}
+
+fn pair(id: &str, turn: &str, text: &str) -> Vec<ResponseItemEnvelope> {
+    [
+        json!({"type":"function_call", "id":format!("fc_{id}"), "call_id":id,
+            "name":"computer", "arguments":"{\"action\":\"status\"}"}),
+        json!({"type":"function_call_output", "id":format!("fco_{id}"),
+            "call_id":id, "output":text}),
+    ]
+    .into_iter()
+    .map(|value| {
+        let mut item: ResponseItem = serde_json::from_value(value).unwrap();
+        item.set_turn_id_if_missing(turn);
+        ResponseItemEnvelope {
+            item,
+            metadata: Some(CodexHarnessMetadata::default()),
+        }
+    })
+    .collect()
+}
+
+const REALISTIC_TURN: &str = "00000000-1234-5678-9abc-000000000001";
+
+fn realistic_mixed_receipts(count: usize, text: &str) -> Vec<ResponseItemEnvelope> {
+    (0..count)
+        .flat_map(|index| {
+            let id = format!("call_{index:016}");
+            let mut items = pair(&id, REALISTIC_TURN, text);
+            if let ResponseItem::FunctionCall {
+                name, arguments, ..
+            } = &mut items[0].item
+            {
+                *name = "computer_v2_snapshot".to_string();
+                *arguments = json!({"sequence":index}).to_string();
+            }
+            items[1]
+                .item
+                .set_id(Some(codex_protocol::ResponseItemId::with_suffix(
+                    "fco",
+                    format!("00000000-1234-5678-9abc-{index:012}"),
+                )));
+            items[1].item.set_create_time_if_missing(
+                serde_json::Number::from_f64(1_790_301_234.567 + index as f64).unwrap(),
+            );
+            if let ResponseItem::FunctionCallOutput { output, .. } = &mut items[1].item {
+                output.success = Some(index % 7 != 0);
+                if index == 0 || index == count - 1 {
+                    output.body = FunctionCallOutputBody::ContentItems(vec![
+                        FunctionCallOutputContentItem::InputText {
+                            text: text.to_string(),
+                        },
+                        observation_image(),
+                    ]);
+                }
+            }
+            items
+        })
+        .collect()
+}
+
+fn assert_external_receipt_bounds(retained: &[ResponseItemEnvelope]) {
+    let mut canonical = retained.to_vec();
+    let latest_output = canonical
+        .iter()
+        .rposition(|envelope| matches!(envelope.item, ResponseItem::FunctionCallOutput { .. }));
+    for (index, envelope) in canonical.iter_mut().enumerate() {
+        if let ResponseItem::FunctionCallOutput { output, .. } = &envelope.item {
+            let text_limit = if Some(index) == latest_output {
+                MAX_LATEST_OUTPUT_TEXT_BYTES
+            } else {
+                MAX_OUTPUT_TEXT_BYTES
+            };
+            assert!(output_text_bytes(&output.body) <= text_limit);
+        }
+        if let ResponseItem::FunctionCallOutput { output, .. } = &mut envelope.item
+            && let FunctionCallOutputBody::ContentItems(items) = &mut output.body
+        {
+            for item in items {
+                if let FunctionCallOutputContentItem::InputImage { image, .. } = item {
+                    *image = ImageReference::Inline {
+                        image_url: String::new(),
+                    };
+                }
+            }
+        }
+        if matches!(envelope.item, ResponseItem::FunctionCallOutput { .. }) {
+            let serialized_limit = if Some(index) == latest_output {
+                MAX_LATEST_OUTPUT_BYTES
+            } else {
+                MAX_OUTPUT_BYTES
+            };
+            assert!(serde_json::to_vec(&envelope.item).unwrap().len() <= serialized_limit);
+        }
+    }
+    let items: Vec<_> = canonical.iter().map(|envelope| &envelope.item).collect();
+    let metadata: Vec<_> = canonical
+        .iter()
+        .map(|envelope| &envelope.metadata)
+        .collect();
+    let canonical_bytes =
+        serde_json::to_vec(&items).unwrap().len() + serde_json::to_vec(&metadata).unwrap().len();
+    assert!(canonical_bytes <= MAX_CANONICAL_RECEIPT_BYTES);
+    let mut projected: Vec<_> = canonical
+        .into_iter()
+        .map(|envelope| envelope.item)
+        .collect();
+    prepare_input_for_non_openai_provider(&mut projected);
+    let wire_bytes = serde_json::to_vec(&projected).unwrap().len();
+    assert!(wire_bytes <= MAX_RECEIPT_BYTES);
+}
