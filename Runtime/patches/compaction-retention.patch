+#[test]
+fn native_read_ledger_joins_only_exact_reasoning_gaps_between_serial_completed_pairs() {
+    let first = proven_native_read("first", "turn", false);
+    let second = proven_native_read("second", "turn", false);
+    let last = pair("latest", "turn", "complete");
+    for (gap_json, identity, joins) in [
+        (json!({"type":"reasoning","summary":[]}), None, false),
+        (json!({"type":"reasoning","summary":[]}), Some("turn"), true),
+        (json!({"type":"reasoning","summary":[]}), Some("foreign"), false),
+        (json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"Intervening assistant evidence"}]}), Some("turn"), false),
+        (json!({"type":"message","role":"user","content":[{"type":"input_text","text":"New restriction"}]}), Some("turn"), false),
+        (json!({"type":"other"}), None, false),
+    ] {
+        let mut gap: ResponseItem = serde_json::from_value(gap_json).unwrap();
+        if let Some(identity) = identity { gap.set_turn_id_if_missing(identity); }
+        let source = vec![first[0].clone(),first[1].clone(),gap.into(),second[0].clone(),second[1].clone(),last[0].clone(),last[1].clone()];
+        let indexed = [0,1,3,4,5,6].into_iter().map(|i|(i,source[i].clone())).collect::<Vec<_>>();
+        let packed = native_read_ledger::pack(&indexed,&source,"turn",&[6],&HashSet::new(),&HashSet::new(),&HashMap::new()).unwrap();
+        assert_eq!(packed.len(),if joins {3} else {4});
+        let packed:Vec<_>=packed.into_iter().map(|(_,item)|item).collect();
+        assert_eq!(super::current_turn_receipts(&packed,"turn",ReceiptProvider::External).unwrap(),packed);
+    }
+    for client_authored in [false, true] {
+        let mut gap: ResponseItem = serde_json::from_value(json!({"type":"reasoning","summary":[]})).unwrap();
+        gap.set_turn_id_if_missing("turn");
+        let gap = ResponseItemEnvelope { item: gap, metadata: Some(CodexHarnessMetadata { client_authored, ..Default::default() }) };
+        let source = vec![first[0].clone(),first[1].clone(),gap,second[0].clone(),second[1].clone(),last[0].clone(),last[1].clone()];
+        let indexed = [0,1,3,4,5,6].into_iter().map(|i|(i,source[i].clone())).collect::<Vec<_>>();
+        let packed = native_read_ledger::pack(&indexed,&source,"turn",&[6],&HashSet::new(),&HashSet::new(),&HashMap::new()).unwrap();
+        assert_eq!(packed.len(), if client_authored {4} else {3});
+    }
+    // Even a reasoning item inside the call/output pair prevents eligibility.
+    let gap:ResponseItem=serde_json::from_value(json!({"type":"reasoning","summary":[]})).unwrap();
+    let source=vec![first[0].clone(),gap.into(),first[1].clone()];
+    let indexed=vec![(0,source[0].clone()),(2,source[2].clone())];
+    assert_eq!(native_read_ledger::pack(&indexed,&source,"turn",&[],&HashSet::new(),&HashSet::new(),&HashMap::new()).unwrap(),indexed);
+}
