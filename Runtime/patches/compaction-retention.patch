+            let DynamicToolCallOutputContentItem::InputText { text } = &mut response.content_items[0] else { unreachable!() };
+            let mut body: Value = serde_json::from_str(text).unwrap();
+            match variant {
+                0 => { response.native_browser_read = None; }
+                1 => { response.success = false; }
+                2 => body["content_evidence"] = json!("page_observed"),
+                3 => body["returned"] = json!(2),
+                4 => body["unexpected"] = json!(true),
+                5 => body["tabs"][0]["availability"] = json!("authorized"),
+                6 => body["next_cursor"] = json!("unissued"),
+                7 => { body.as_object_mut().unwrap().remove("next_cursor"); },
+                8 => { let first = body["tabs"][0].clone(); body["tabs"].as_array_mut().unwrap().push(first); body["count"]=json!(2); body["returned"]=json!(2); },
+                _ => body["tabs"][0]["title"] = json!("x".repeat(257)),
+            }
+            *text = body.to_string();
+            assert_output_unchanged(&tool, response, None);
+        }
+        let mut empty = inventory_response();
+        let DynamicToolCallOutputContentItem::InputText { text } = &mut empty.content_items[0] else { unreachable!() };
+        let mut body: Value = serde_json::from_str(text).unwrap();
+        body["tabs"] = json!([]); body["count"] = json!(0); body["returned"] = json!(0);
+        body["inventory_state"] = json!("no_matching_human_tabs"); body["authentication_evidence"] = json!("not_observed");
+        body["next"] = json!("No page or authentication was observed; bind or open within user scope.");
+        *text = body.to_string();
+        assert_output_unchanged(&tool, empty, Some(NativeBrowserRead::InventoryV1));
+    }
+
+    #[test]
+    fn inventory_proof_preserves_native_paginated_and_final_partial_pages() {
+        let tool = ToolName::new(None, "browser_tabs".to_string());
+        // Count describes the retained inventory, while returned describes only
+        // this page. Neither a proof nor a final page makes tab metadata into
+        // observed page content or a complete copy of the earlier pages.
+        for (truncated, next_cursor, tab_id) in [
+            (true, Some("8E27AB4B-0A55-4BE4-8EFD-A18C85FB41F7"), "first-page-tab"),
+            (true, Some("ACB91EAA-E978-40F2-907C-859E04737F59"), "middle-page-tab"),
+            (false, None, "last-page-tab"),
+        ] {
+            let mut response = inventory_response();
+            let DynamicToolCallOutputContentItem::InputText { text } = &mut response.content_items[0] else { unreachable!() };
+            let mut body: Value = serde_json::from_str(text).unwrap();
+            body["count"] = json!(3);
+            body["returned"] = json!(1);
+            body["truncated"] = json!(truncated);
+            body["next_cursor"] = json!(next_cursor);
+            body["tabs"][0]["tab_id"] = json!(tab_id);
+            body["binding_state"] = json!("bound_current_turn");
+            body["tabs"][0]["availability"] = json!("bound_here");
+            // URL omission and a bounded title fragment are native metadata
+            // variants, not a reason to rewrite or reject the successful read.
+            let row = body["tabs"][0].as_object_mut().unwrap();
+            row.remove("url");
+            row.insert("url_omitted".to_string(), json!(true));
+            row.insert("title_truncated".to_string(), json!(true));
+            row.insert("title".to_string(), json!("e\u{301} 🙂 ".repeat(20)));
+            *text = serde_json::to_string_pretty(&body).unwrap();
+            assert_output_unchanged(&tool, response, Some(NativeBrowserRead::InventoryV1));
+        }
+    }
+}
