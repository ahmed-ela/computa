+#[test_case::test_case(20; "twenty_mixed_receipts")]
+#[test_case::test_case(13; "thirteen_receipts_latest_synced_ax_and_image")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn local_mid_turn_compaction_preserves_realistic_receipts_in_provider_budget(
+    pair_count: usize,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let mut provider = built_in_model_providers(/*openai_base_url*/ None)["openai"].clone();
+    provider.name = "Local realistic receipt budget test".to_string();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    let mut builder = test_codex()
+        .with_config(move |config| {
+            config.model_provider = provider;
+            config.model_context_window = Some(32_768);
+            config.model_auto_compact_token_limit = Some(6144);
+        })
+        .with_model_info_override("gpt-5.5", |info| {
+            info.truncation_policy = TruncationPolicyConfig::tokens(/*limit*/ 10_000);
+            info.input_modalities = vec![InputModality::Text, InputModality::Image];
+        });
+    let mut test = builder.build_with_auto_env(&server).await?;
+    test.codex = test.thread_manager.start_thread(StartThreadOptions {
+        dynamic_tools: vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+            name: "computer_v2_snapshot".to_string(),
+            description: "Read-only synthetic observation; no desktop access.".to_string(),
+            input_schema: json!({"type":"object","properties":{"sequence":{"type":"integer"}},"required":["sequence"]}),
+            defer_loading: false,
+        })],
+        ..StartThreadOptions::new(test.config.clone())
+    }).await?.thread;
+    let mut mocks = Vec::new();
+    for index in 0..pair_count {
+        mocks.push(
+            mount_sse_once(
+                &server,
+                sse(vec![
+                    ev_function_call(
+                        &format!("call_{index:016}"),
+                        "computer_v2_snapshot",
+                        &json!({"sequence":index}).to_string(),
+                    ),
+                    ev_completed_with_tokens(
+                        &format!("response-{index}"),
+                        if index == pair_count - 1 { 7000 } else { 10 },
+                    ),
+                ]),
+            )
+            .await,
+        );
+    }
+    let summary = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message(
+                "summary",
+                "The observations completed; answer without repeating any tool.",
+            ),
+            ev_completed_with_tokens("summary", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let continuation = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("final", "ALL_RECEIPTS_RETAINED"),
+            ev_completed_with_tokens("final", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let mut png = std::io::Cursor::new(Vec::new());
+    image::DynamicImage::new_rgb8(/*w*/ 1, /*h*/ 1).write_to(&mut png, image::ImageFormat::Png)?;
+    let image_url = format!(
+        "data:image/png;base64,{}",
+        BASE64_STANDARD.encode(png.into_inner())
+    );
+    // The latest result has distinct capture metadata, a synchronized AX tree,
+    // and pixels. Its AX text alone exceeds the former shared 2 KiB cap.
+    let capture_metadata = "CAPTURE id=synthetic-capture-12 width=1280 height=900 screenshot_freshness=retained_original";
+    let latest_ax = format!(
+        "AXSNAPSHOT id=synthetic-ax-12 capture_id=synthetic-capture-12 shown=37 total=37 source_truncated=0 output_truncated=0 parents=[0:-]\n#0 role=\"AXWebArea\" label=\"Records\" actions=[] parent=-\n{}",
+        (1..=36).map(|index| format!("#{index} role=\"AXStaticText\" value=\"Record {index:02} status: pending review\" actions=[] parent=0\n")).collect::<String>()
+    );
+    assert!(latest_ax.len() > 3 * 1024);
+    assert!(capture_metadata.len() + latest_ax.len() <= 4096);
+    let mut dispatched = Vec::new();
+    let mut compactions = 0;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: format!("Perform the {pair_count} synthetic observations once, then answer."),
+            text_elements: vec![],
+        }]))
+        .await?;
+    loop {
+        match wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::DynamicToolCallRequest(_)
+                    | EventMsg::ItemCompleted(_)
+                    | EventMsg::Error(_)
+                    | EventMsg::TurnComplete(_)
+            )
+        })
+        .await
+        {
+            EventMsg::DynamicToolCallRequest(request) => {
+                let index = dispatched.len();
+                assert!(index < pair_count, "no completed action may be replayed");
+                assert_eq!(request.call_id, format!("call_{index:016}"));
+                assert_eq!(request.arguments, json!({"sequence":index}));
+                dispatched.push(request.call_id.clone());
+                let mut content_items = vec![DynamicToolCallOutputContentItem::InputText {
+                    text: format!("observed-{index}:{}:end", "diagnostic ".repeat(220)),
+                }];
+                if pair_count == 13 && index == pair_count - 1 {
+                    content_items = vec![
+                        DynamicToolCallOutputContentItem::InputText {
+                            text: capture_metadata.to_string(),
+                        },
+                        DynamicToolCallOutputContentItem::InputText {
+                            text: latest_ax.clone(),
+                        },
+                    ];
+                }
+                if index == 0 || index == pair_count - 1 {
+                    content_items.push(DynamicToolCallOutputContentItem::InputImage {
+                        image_url: image_url.to_string(),
+                    });
+                }
+                test.codex
+                    .submit(Op::DynamicToolResponse {
+                        id: request.call_id,
+                        response: DynamicToolResponse {
+                            native_browser_read: None,
+                            content_items,
+                            success: index != 7,
+                        },
+                    })
+                    .await?;
+            }
+            EventMsg::ItemCompleted(event)
+                if matches!(event.item, TurnItem::ContextCompaction(_)) =>
+            {
+                compactions += 1
+            }
+            EventMsg::Error(error) => panic!("unexpected receipt-budget failure: {error:?}"),
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    assert_eq!(
+        dispatched,
+        (0..pair_count)
+            .map(|index| format!("call_{index:016}"))
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(compactions, 1);
+    for mock in mocks.iter().chain([&summary, &continuation]) {
+        assert_eq!(mock.requests().len(), 1);
+    }
+    let original = tool_items(summary.single_request().input());
+    let mut retained = tool_items(continuation.single_request().input());
+    assert_eq!(original.len(), pair_count * 2);
+    assert_eq!(retained.len(), pair_count * 2);
+    for (before, after) in original.iter().zip(&retained) {
+        let mut expected = before.clone();
+        if expected["type"] == "function_call_output" {
+            expected["output"] = after["output"].clone();
+        }
+        assert_eq!(&expected, after);
+        assert!(
+            after
+                .get("internal_chat_message_metadata_passthrough")
+                .is_none()
+        );
+    }
+    assert_eq!(
+        serde_json::to_string(&retained)?
+            .matches(image_url.as_str())
+            .count(),
+        1
+    );
+    if pair_count == 13 {
+        assert_eq!(
+            retained.last(),
+            original.last(),
+            "the latest capture metadata, complete AX header/body and original image must all reach continuation unchanged"
+        );
+        let payload: FunctionCallOutputPayload =
+            serde_json::from_value(retained.last().unwrap()["output"].clone())?;
+        let texts: Vec<_> = payload
+            .content_items()
+            .unwrap()
+            .iter()
+            .filter_map(|item| match item {
+                FunctionCallOutputContentItem::InputText { text } => Some(text.as_str()),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(texts, vec![capture_metadata, latest_ax.as_str()]);
+    }
+    for item in &mut retained {
+        if let Some(parts) = item["output"].as_array_mut() {
+            for part in parts {
+                if part["type"] == "input_image" {
+                    part["image_url"] = json!("");
+                }
+            }
+        }
+    }
+    let wire_bytes = serde_json::to_vec(&retained)?.len();
+    assert!(wire_bytes <= 12 * 1024);
+    let history = test.codex.conversation_history_snapshot().await;
+    let canonical: Vec<_> = history
+        .items()
+        .filter(|item| {
+            matches!(
+                item,
+                ResponseItem::FunctionCall { .. } | ResponseItem::FunctionCallOutput { .. }
+            )
+        })
+        .collect();
+    assert_eq!(canonical.len(), pair_count * 2);
+    assert!(canonical.iter().all(|item| item.turn_id().is_some()));
+    let failure = canonical.iter().find_map(|item| match item {
+        ResponseItem::FunctionCallOutput {
+            call_id: Some(id),
+            output,
+            ..
+        } if id == "call_0000000000000007" => Some(output.success),
+        _ => None,
+    });
+    assert_eq!(failure, Some(Some(false)));
+    test.codex.flush_rollout().await?;
+    let rollout =
+        std::fs::read_to_string(test.codex.rollout_path().expect("isolated fixture rollout"))?;
+    let mut checkpoints = 0;
+    for line in rollout.lines() {
+        if let codex_history::RolloutItem::Compacted(checkpoint) =
+            codex_rollout::parse_rollout_line(line)?.item
+        {
+            checkpoints += 1;
+            let mut receipts: Vec<_> = checkpoint
+                .replacement_history
+                .expect("atomic replacement history")
+                .into_iter()
+                .filter(|envelope| {
+                    matches!(
+                        envelope.item,
+                        ResponseItem::FunctionCall { .. } | ResponseItem::FunctionCallOutput { .. }
+                    )
+                })
+                .collect();
+            assert_eq!(receipts.len(), pair_count * 2);
+            for envelope in &mut receipts {
+                if let ResponseItem::FunctionCallOutput { output, .. } = &mut envelope.item
+                    && let Some(parts) = output.content_items_mut()
+                {
+                    for part in parts {
+                        if let FunctionCallOutputContentItem::InputImage { image, .. } = part {
+                            *image = ImageReference::Inline {
+                                image_url: String::new(),
+                            };
+                        }
+                    }
+                }
+            }
+            let items: Vec<_> = receipts.iter().map(|envelope| &envelope.item).collect();
+            let metadata: Vec<_> = receipts.iter().map(|envelope| &envelope.metadata).collect();
+            let canonical_bytes =
+                serde_json::to_vec(&items)?.len() + serde_json::to_vec(&metadata)?.len();
+            assert!(canonical_bytes <= 24 * 1024);
+        }
+    }
+    assert_eq!(checkpoints, 1);
+    Ok(())
+}
