+#[test]
+fn native_read_proof_is_canonical_only_and_keeps_fallback_budget() {
+    use codex_protocol::dynamic_tools::NativeBrowserRead;
+    for proof in [None, Some(NativeBrowserRead::ReadV1), Some(NativeBrowserRead::InventoryV1)] {
+        // Generic metadata may imitate the field but is never the typed accessor.
+        let original: Box<dyn ToolOutput> = Box::new(NativeReadProofTestOutput {
+            proof, generic_metadata: serde_json::json!({"native_browser_read":"read_v1"}),
+        });
+        let boxed: Box<dyn ToolOutput> = Box::new(original);
+        assert_eq!(boxed.native_browser_read(), proof, "Box forwarding preserves typed provenance only");
+        let response = AnyToolResult {
+            call_id:"exact-native-call".to_string(),
+            payload:ToolPayload::Function { arguments:"{ \"view\": \"content\" }".to_string() },
+            result: boxed, post_tool_use_payload:None,
+        }.into_response();
+        let metadata = response.metadata.as_ref().unwrap();
+        assert_eq!(metadata.native_browser_read, proof);
+        assert_eq!(metadata.history_truncation_token_limit, Some(123));
+        let serialized = serde_json::to_value(&response.item).unwrap();
+        assert_eq!(serialized["call_id"], "exact-native-call");
+        assert!(!serialized.to_string().contains("native_browser_read"));
+        assert!(!serialized.to_string().contains("nativeBrowserRead"));
+        let metadata_roundtrip: CodexHarnessMetadata = serde_json::from_value(serde_json::to_value(metadata).unwrap()).unwrap();
