+#[test]
+fn websocket_suppresses_http_proof_before_any_input_delta_without_other_changes() {
+    let mut request = http_request();
+    assert!(
+        request
+            .client_metadata
+            .as_ref()
+            .unwrap()
+            .contains_key(CURRENT_USER_TEXT_PROOF_KEY)
+    );
+    let mut expected = request.clone();
+    expected
+        .client_metadata
+        .as_mut()
+        .unwrap()
+        .remove(CURRENT_USER_TEXT_PROOF_KEY);
+    remove_for_websocket(&mut request);
+    assert_eq!(request, expected);
+    // A subsequent delta/rebase cannot carry a proof for the original indexes.
+    request.input.clear();
+    let payload = codex_api::ResponseCreateWsRequest::from(&request);
+    assert!(
+        !payload
+            .client_metadata
+            .unwrap()
+            .contains_key(CURRENT_USER_TEXT_PROOF_KEY)
+    );
+    remove_for_websocket(&mut request);
+    request.client_metadata = None;
+    remove_for_websocket(&mut request);
+    assert!(request.client_metadata.is_none());
+}
