+// Offline, opt-in evidence export only: no model, server, tool execution, or application state.
+// The directory must already be private; create_new prevents overwriting any prior evidence.
+#[cfg(unix)]
+#[test]
+#[ignore = "requires explicit private rollout and output paths for the recorded 13-pair regression"]
+fn export_recorded_receipts_with_latest_priority() {
+    use std::fs::File;
+    use std::fs::OpenOptions;
+    use std::io::Read;
+    use std::io::Write;
+    use std::os::unix::fs::OpenOptionsExt;
+    use std::os::unix::fs::PermissionsExt;
+    use std::path::PathBuf;
+
+    fn key(item: &ResponseItem) -> Option<(bool, &str)> {
+        match item {
+            ResponseItem::FunctionCall { call_id, .. } => Some((false, call_id)),
+            ResponseItem::FunctionCallOutput { call_id, .. } => Some((
+                true,
+                call_id
+                    .as_deref()
+                    .expect("recorded output lacks call identity"),
+            )),
+            _ => None,
+        }
+    }
+
+    fn same_except_body(original: &ResponseItem, bounded: &ResponseItem) -> bool {
+        let mut comparable = original.clone();
+        if let (
+            ResponseItem::FunctionCallOutput { output, .. },
+            ResponseItem::FunctionCallOutput {
+                output: bounded_output,
+                ..
+            },
+        ) = (&mut comparable, bounded)
+        {
+            output.body = bounded_output.body.clone();
+        }
+        comparable == *bounded
+    }
+
+    let source = PathBuf::from(
+        std::env::var_os("HEYDASH_RECEIPT_REPLAY_ROLLOUT")
+            .expect("explicit recorded rollout path required"),
+    );
+    let destination = PathBuf::from(
+        std::env::var_os("HEYDASH_RECEIPT_REPLAY_OUTPUT")
+            .expect("explicit private output path required"),
+    );
+    assert!(
+        source.is_absolute() && destination.is_absolute(),
+        "paths must be absolute"
+    );
+    let parent = destination.parent().expect("output parent required");
+    let parent_metadata =
+        std::fs::symlink_metadata(parent).expect("private output directory required");
+    assert!(
+        parent_metadata.is_dir() && parent_metadata.permissions().mode() & 0o077 == 0,
+        "output parent must be an existing private directory"
+    );
+    let source_metadata = std::fs::symlink_metadata(&source).expect("recorded rollout required");
+    const MAX_SOURCE_BYTES: u64 = 64 * 1024 * 1024;
+    assert!(
+        source_metadata.is_file() && source_metadata.len() <= MAX_SOURCE_BYTES,
+        "recorded rollout must be a bounded regular file"
+    );
+    let mut source_text = String::new();
+    File::open(&source)
+        .expect("recorded rollout could not be opened")
+        .take(MAX_SOURCE_BYTES + 1)
+        .read_to_string(&mut source_text)
+        .expect("recorded rollout could not be read");
+    assert!(
+        source_text.len() as u64 <= MAX_SOURCE_BYTES,
+        "recorded rollout grew beyond bound"
+    );
+    let mut checkpoint = None;
+    for line in source_text.lines() {
+        let value: serde_json::Value = serde_json::from_str(line)
+            .unwrap_or_else(|_| panic!("recorded rollout contains invalid JSON"));
+        if value.get("type").and_then(serde_json::Value::as_str) == Some("compacted") {
+            assert!(
+                checkpoint.is_none(),
+                "recorded regression must have exactly one checkpoint"
+            );
+            checkpoint = Some(
+                serde_json::from_value::<codex_history::CompactedItem>(
+                    value
+                        .get("payload")
+                        .expect("checkpoint payload required")
+                        .clone(),
+                )
+                .unwrap_or_else(|_| panic!("checkpoint structure is invalid")),
+            );
+        }
+    }
+    let checkpoint = checkpoint.expect("recorded regression checkpoint required");
+    let replacement = checkpoint
+        .replacement_history
+        .expect("canonical replacement required");
+    let guardian = checkpoint
+        .guardian_history
+        .expect("original guardian history required")
+        .0;
+    let canonical: Vec<_> = replacement
+        .iter()
+        .filter(|entry| key(&entry.item).is_some())
+        .collect();
+    assert!(
+        canonical.len() == 26,
+        "expected exactly thirteen recorded pairs"
+    );
+    let turn_id = canonical[0]
+        .turn_id()
+        .expect("recorded turn identity required")
+        .to_string();
+    assert!(!turn_id.is_empty(), "recorded turn identity is empty");
+    let mut canonical_keys = HashSet::new();
+    for entry in &canonical {
+        assert!(
+            entry.turn_id() == Some(turn_id.as_str()),
+            "canonical turns differ"
+        );
+        assert!(
+            canonical_keys.insert(key(&entry.item).expect("recorded key required")),
+            "canonical receipt identity is duplicated"
+        );
+    }
+
+    // Guardian records hold original bodies, while the canonical replacement holds harness
+    // metadata. Match exact function identities and every field except the truncated body
+    // before restoring that body. Never export any message, summary, or reasoning item.
+    let mut matched = HashSet::new();
+    let mut restored = Vec::with_capacity(guardian.len());
+    for item in guardian {
+        let metadata = if let Some(item_key) = key(&item) {
+            let canonical = canonical
+                .iter()
+                .find(|entry| key(&entry.item) == Some(item_key))
+                .expect("original function has no canonical match");
+            assert!(
+                matched.insert((item_key.0, item_key.1.to_string())),
+                "original receipt identity is duplicated"
+            );
+            assert!(
+                same_except_body(&item, &canonical.item),
+                "original and canonical identity, arguments, success, or metadata differ"
+            );
+            canonical.metadata.clone()
+        } else {
+            None
+        };
+        restored.push(ResponseItemEnvelope { item, metadata });
+    }
+    assert!(matched.len() == 26, "original receipt set is incomplete");
+    let original_receipts: Vec<_> = restored
+        .iter()
+        .filter(|entry| key(&entry.item).is_some())
+        .collect();
+    assert!(
+        original_receipts
+            .iter()
+            .zip(&canonical)
+            .all(|(original, saved)| key(&original.item) == key(&saved.item)),
+        "canonical receipt order differs from original history"
+    );
+    let retained = super::current_turn_receipts(&restored, &turn_id, ReceiptProvider::External)
+        .unwrap_or_else(|_| panic!("native receipt retention rejected the recorded history"));
+    assert!(retained.len() == 26, "native receipt count changed");
+    assert!(
+        retained
+            .iter()
+            .zip(&original_receipts)
+            .all(
+                |(actual, original)| same_except_body(&original.item, &actual.item)
+                    && actual.metadata == original.metadata
+            ),
+        "native receipt identity, order, success, or metadata changed"
+    );
+    assert_external_receipt_bounds(&retained);
+    assert!(
+        retained.last() == original_receipts.last().copied(),
+        "newest recorded observation was not preserved completely"
+    );
+    let repeated = super::current_turn_receipts(&retained, &turn_id, ReceiptProvider::External)
+        .unwrap_or_else(|_| panic!("native recompaction rejected its own receipts"));
+    assert!(
+        repeated == retained,
+        "native recompaction changed already-bounded evidence"
+    );
+    let latest = retained.last().expect("latest receipt required");
+    let ResponseItem::FunctionCallOutput { output, .. } = &latest.item else {
+        panic!("latest receipt is not a function output")
+    };
+    assert!(
+        latest_observation_image(output).ok().flatten().is_some(),
+        "recorded regression requires its unchanged latest image"
+    );
+    let latest_text_bytes = output_text_bytes(&output.body);
+    let mut items: Vec<_> = retained.into_iter().map(|entry| entry.item).collect();
+    prepare_input_for_non_openai_provider(&mut items);
+    let export = json!({
+        "schema_version": 1,
+        "mode": "native_latest_priority_receipts",
+        "pair_count": 13,
+        "latest_output_preserved": true,
+        "latest_text_bytes": latest_text_bytes,
+        "recompaction_identical": true,
+        "identity_success_order_and_metadata_verified": true,
+        "provider": "external",
+        "items": items,
+    });
+    let bytes = serde_json::to_vec(&export).expect("native receipt export serialization failed");
+    let mut output_file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(destination)
+        .expect("new private output file could not be created");
+    output_file
+        .write_all(&bytes)
+        .expect("private receipt export write failed");
+    output_file
+        .sync_all()
+        .expect("private receipt export sync failed");
+}
