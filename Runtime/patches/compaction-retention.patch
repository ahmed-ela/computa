+fn normalize_update_available_snapshot(
+    cell: &UpdateAvailableHistoryCell,
+    action: UpdateAction,
+) -> String {
+    let width: u16 = 110;
+    let lines = render_lines(&cell.display_lines(width));
+    assert!(
+        lines.len() >= 7,
+        "update card must retain all five logical content rows"
+    );
+    let inner_width = lines[0]
+        .chars()
+        .count()
+        .checked_sub(4)
+        .expect("update card includes borders and padding");
+    assert_eq!(lines[0], format!("╭{}╮", "─".repeat(inner_width + 2)));
+    let last = lines.len() - 1;
+    assert_eq!(lines[last], format!("╰{}╯", "─".repeat(inner_width + 2)));
+    let mut content = lines[1..last]
+        .iter()
+        .map(|line| {
+            line.strip_prefix("│ ")
+                .and_then(|line| line.strip_suffix(" │"))
+                .expect("update card row must retain its border and padding")
+                .trim_end_matches(' ')
+                .to_string()
+        })
+        .collect::<Vec<_>>();
+    let instruction = format!("Run {} to update.", action.command_str());
+    let mut unwrapped_content = [
+        format!(
+            "✨\u{200A}Update available! {} -> 9.9.9",
+            crate::version::CODEX_CLI_VERSION
+        ),
+        instruction,
+        String::new(),
+        "See full release notes:".to_string(),
+        "https://github.com/openai/codex/releases/latest".to_string(),
+    ];
+    assert_eq!(
+        content[0], unwrapped_content[0],
+        "update notice must contain the exact compiled version and expected latest version"
+    );
+    assert_eq!(
+        content[1..content.len() - 3].join(" "),
+        unwrapped_content[1],
+        "wrapped update instruction must retain the entire exact command"
+    );
+    assert_eq!(
+        content[content.len() - 3..],
+        unwrapped_content[2..],
+        "update card must retain its blank row and release notes"
+    );
+    let content_width = |line: &str| line_width(&Line::from(line.to_string()));
+    assert_eq!(
+        inner_width,
+        unwrapped_content
+            .iter()
+            .map(|line| content_width(line))
+            .max()
+            .unwrap()
+            .min(usize::from(width.saturating_sub(4)))
+            .max(1),
+        "update card border must match the clamped unwrapped content width"
+    );
+    for (line, body) in lines[1..last].iter().zip(&content) {
+        assert_eq!(
+            line,
+            &format!(
+                "│ {body}{} │",
+                " ".repeat(inner_width - content_width(body))
+            ),
+            "update card must retain exact compiled-version padding"
+        );
+    }
+    unwrapped_content[0] = "✨\u{200A}Update available! 0.0.0 -> 9.9.9".to_string();
+    content[0] = unwrapped_content[0].clone();
+    let stable_inner_width = unwrapped_content
+        .iter()
+        .map(|line| content_width(line))
+        .max()
+        .unwrap()
+        .min(usize::from(width.saturating_sub(4)))
+        .max(1);
+    let mut stable_fixture = vec![format!("╭{}╮", "─".repeat(stable_inner_width + 2))];
+    stable_fixture.extend(content.iter().map(|body| {
+        format!(
+            "│ {body}{} │",
+            " ".repeat(stable_inner_width - content_width(body))
+        )
+    }));
+    stable_fixture.push(format!("╰{}╯", "─".repeat(stable_inner_width + 2)));
+    stable_fixture.join("\n")
+}
