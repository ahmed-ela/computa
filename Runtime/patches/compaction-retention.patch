+
+enum ReceiptFixture {
+    TextOnly,
+    MixedImages,
+}
+
+#[derive(Clone, Copy)]
+enum ReceiptFailure {
+    PairOverflow,
+    SummaryTooLarge,
+}
+
+#[derive(Clone, Copy)]
+enum OverflowRecoveryFixture {
+    Recovered,
+    SecondStep,
+    RetryStillTooLarge,
+    NoReduction,
+    UnrelatedError,
+}
+
+#[test_case::test_case(OverflowRecoveryFixture::Recovered; "preserves_completed_action")]
+#[test_case::test_case(OverflowRecoveryFixture::SecondStep; "resets_only_after_successful_step")]
+#[test_case::test_case(OverflowRecoveryFixture::RetryStillTooLarge; "one_retry_only")]
+#[test_case::test_case(OverflowRecoveryFixture::NoReduction; "requires_smaller_history")]
+#[test_case::test_case(OverflowRecoveryFixture::UnrelatedError; "typed_overflow_only")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn local_context_overflow_recovery(fixture: OverflowRecoveryFixture) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let mut provider = built_in_model_providers(None)["openai"].clone();
+    provider.name = "Local exact context fixture".to_string();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    provider.stream_max_retries = Some(0);
+    provider.request_max_retries = Some(0);
+    let mut builder = test_codex()
+        .with_config(move |config| {
+            config.model_provider = provider;
+            config.model_context_window = Some(32_768);
+            // Reported usage and the new result's coarse estimate remain below
+            // this limit; only the provider's exact preflight detects overflow.
+            config.model_auto_compact_token_limit = Some(12_288);
+        })
+        .with_model_info_override("gpt-5.5", |info| {
+            info.truncation_policy = TruncationPolicyConfig::tokens(10_000);
+        });
+    let mut test = builder.build_with_auto_env(&server).await?;
+    test.codex = test
+        .thread_manager
+        .start_thread(StartThreadOptions {
+            dynamic_tools: vec![DynamicToolSpec::Function(DynamicToolFunctionSpec {
+                name: "status".to_string(),
+                description: "Synthetic fixture action, must execute only once per call."
+                    .to_string(),
+                input_schema: json!({"type":"object", "properties":{}}),
+                defer_loading: false,
+            })],
+            ..StartThreadOptions::new(test.config.clone())
+        })
+        .await?
+        .thread;
+    let overflow = || {
+        sse_failed(
+            "too-large",
+            "context_length_exceeded",
+            "Exact request does not fit.",
+        )
+    };
+    let mut responses = vec![
+        sse(vec![
+            ev_function_call("action-0", "status", "{}"),
+            ev_completed_with_tokens("first", 100),
+        ]),
+        if matches!(fixture, OverflowRecoveryFixture::UnrelatedError) {
+            sse_failed("unrelated", "invalid_request", "Unrelated provider error.")
+        } else {
+            overflow()
+        },
+    ];
+    if !matches!(fixture, OverflowRecoveryFixture::UnrelatedError) {
+        let summary = if matches!(fixture, OverflowRecoveryFixture::NoReduction) {
+            "Unhelpful oversized summary. ".repeat(1800)
+        } else {
+            "The synthetic action completed. Use its retained receipt; do not repeat it."
+                .to_string()
+        };
+        responses.push(sse(vec![
+            ev_assistant_message("summary-0", &summary),
+            ev_completed_with_tokens("compact-0", 100),
+        ]));
+        if !matches!(fixture, OverflowRecoveryFixture::NoReduction) {
+            responses.push(
+                if matches!(fixture, OverflowRecoveryFixture::RetryStillTooLarge) {
+                    overflow()
+                } else if matches!(fixture, OverflowRecoveryFixture::SecondStep) {
+                    sse(vec![
+                        ev_function_call("action-1", "status", "{}"),
+                        ev_completed_with_tokens("second", 100),
+                    ])
+                } else {
+                    sse(vec![
+                        ev_assistant_message("answer", "RECEIPT_VERIFIED"),
+                        ev_completed_with_tokens("done", 100),
+                    ])
+                },
+            );
+        }
+        if matches!(fixture, OverflowRecoveryFixture::SecondStep) {
+            responses.extend([
+                overflow(),
+                sse(vec![
+                    ev_assistant_message(
+                        "summary-1",
+                        "Both synthetic actions completed. Answer from the two receipts.",
+                    ),
+                    ev_completed_with_tokens("compact-1", 100),
+                ]),
+                sse(vec![
+                    ev_assistant_message("answer", "RECEIPTS_VERIFIED"),
+                    ev_completed_with_tokens("done", 100),
+                ]),
+            ]);
+        }
+    }
+    let expected_requests = responses.len();
+    let request_log = mount_sse_sequence(&server, responses).await;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Perform each requested synthetic action once and report verified results."
+                .to_string(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let mut calls = Vec::new();
+    let mut compactions = 0;
+    let mut errors = 0;
+    loop {
+        match wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::DynamicToolCallRequest(_)
+                    | EventMsg::ItemCompleted(_)
+                    | EventMsg::Error(_)
+                    | EventMsg::TurnComplete(_)
+            )
+        })
+        .await
+        {
+            EventMsg::DynamicToolCallRequest(request) => {
+                assert_eq!(
+                    request.call_id,
+                    format!("action-{}", calls.len()),
+                    "completed actions must never replay"
+                );
+                calls.push(request.call_id.clone());
+                test.codex
+                    .submit(Op::DynamicToolResponse {
+                        id: request.call_id,
+                        response: DynamicToolResponse {
+                            content_items: vec![DynamicToolCallOutputContentItem::InputText {
+                                text: format!(
+                                    "verified-prefix:{}:verified-suffix",
+                                    "observation ".repeat(1400)
+                                ),
+                            }],
+                            success: true,
+                        },
+                    })
+                    .await?;
+            }
+            EventMsg::ItemCompleted(event)
+                if matches!(event.item, TurnItem::ContextCompaction(_)) =>
+            {
+                compactions += 1
+            }
+            EventMsg::Error(_) => errors += 1,
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    let second_step = matches!(fixture, OverflowRecoveryFixture::SecondStep);
+    let succeeded = matches!(
+        fixture,
+        OverflowRecoveryFixture::Recovered | OverflowRecoveryFixture::SecondStep
+    );
+    assert_eq!(calls.len(), if second_step { 2 } else { 1 });
+    assert_eq!(errors, if succeeded { 0 } else { 1 });
+    assert_eq!(
+        compactions,
+        if second_step {
+            2
+        } else if matches!(fixture, OverflowRecoveryFixture::UnrelatedError) {
+            0
+        } else {
+            1
+        }
+    );
+    let requests = request_log.requests();
+    assert_eq!(
+        requests.len(),
+        expected_requests,
+        "no extra sampling or compaction retries"
+    );
+    if !matches!(
+        fixture,
+        OverflowRecoveryFixture::NoReduction | OverflowRecoveryFixture::UnrelatedError
+    ) {
+        // Request 1 failed; request 2 summarizes; request 3 continues with the
+        // exact original call ID and arguments, and its genuine bounded result.
+        let original = tool_items(requests[1].input());
+        let retained = tool_items(requests[3].input());
+        assert_eq!(original.len(), 2);
+        assert_eq!(retained.len(), 2);
+        assert_eq!(retained[0], original[0]);
+        assert_eq!(retained[1]["call_id"], original[1]["call_id"]);
+        let output = retained[1]["output"].to_string();
+        assert!(output.contains("verified-prefix"));
+        assert!(output.contains("verified-suffix"));
+        assert!(
+            serde_json::to_vec(&requests[3].input())?.len()
+                < serde_json::to_vec(&requests[1].input())?.len()
+        );
+    }
+    Ok(())
+}
