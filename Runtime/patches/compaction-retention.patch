+    let mut unmarked = pair("unmarked", "current", &"AXSNAPSHOT actual output ".repeat(300));
+    if let ResponseItem::FunctionCall { name, .. } = &mut unmarked[0].item {
+        *name = "browser_read".to_string();
+    }
+    assert!(current_turn_receipts(&unmarked, "current").is_ok());
