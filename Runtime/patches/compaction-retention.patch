+    let mut checkpoints = 0;
+    for line in rollout.lines() {
+        if let codex_history::RolloutItem::Compacted(checkpoint) =
+            codex_rollout::parse_rollout_line(line)?.item
+        {
+            checkpoints += 1;
+            let mut receipts: Vec<_> = checkpoint
+                .replacement_history
+                .expect("atomic replacement history")
+                .into_iter()
+                .filter(|envelope| {
+                    matches!(
+                        envelope.item,
+                        ResponseItem::FunctionCall { .. } | ResponseItem::FunctionCallOutput { .. }
+                    )
+                })
+                .collect();
+            assert_eq!(receipts.len(), pair_count * 2);
+            for envelope in &mut receipts {
+                if let ResponseItem::FunctionCallOutput { output, .. } = &mut envelope.item
+                    && let Some(parts) = output.content_items_mut()
+                {
+                    for part in parts {
+                        if let FunctionCallOutputContentItem::InputImage { image, .. } = part {
+                            *image = ImageReference::Inline {
+                                image_url: String::new(),
