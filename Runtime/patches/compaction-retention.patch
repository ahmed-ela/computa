+// Only this dynamic-response path can create the wrapper. Page text, generic
+// MCP metadata and imported response items cannot mint native read provenance.
+struct NativeBrowserReadOutput {
+    inner: FunctionToolOutput,
+    proof: NativeBrowserRead,
+}
+
+impl ToolOutput for NativeBrowserReadOutput {
+    fn log_output(&self) -> String { self.inner.log_output() }
+    fn success_for_logging(&self) -> bool { self.inner.success_for_logging() }
+    fn native_browser_read(&self) -> Option<NativeBrowserRead> { Some(self.proof) }
+    fn to_response_item(&self, call_id: &str, payload: &ToolPayload) -> ResponseInputItem {
+        self.inner.to_response_item(call_id, payload)
+    }
+    fn post_tool_use_response(&self, call_id: &str, payload: &ToolPayload) -> Option<Value> {
+        self.inner.post_tool_use_response(call_id, payload)
+    }
+}
+
+fn dynamic_tool_output(tool: &ToolName, response: DynamicToolResponse) -> Box<dyn ToolOutput> {
+    let proof = accepted_native_browser_read(tool, &response);
+    let output = FunctionToolOutput::from_content(
+        response.content_items.into_iter().map(FunctionCallOutputContentItem::from).collect(),
+        Some(response.success),
+    );
+    match proof {
+        Some(proof) => boxed_tool_output(NativeBrowserReadOutput { inner: output, proof }),
+        None => boxed_tool_output(output),
+    }
+}
+
+fn accepted_native_browser_read(tool: &ToolName, response: &DynamicToolResponse) -> Option<NativeBrowserRead> {
+    if !response.success || tool.namespace.is_some() { return None; }
+    let proof = response.native_browser_read?;
+    let valid = match (proof, tool.name.as_str(), response.content_items.as_slice()) {
+        (NativeBrowserRead::ReadV1, "browser_read", [
+            DynamicToolCallOutputContentItem::InputText { text: marker },
+            DynamicToolCallOutputContentItem::InputText { text: page },
+        ]) => marker == r#"{"retention":"complete_browser_observation_v1"}"#
+            && page.starts_with("AXSNAPSHOT ")
+            && page.lines().any(|line| line.starts_with("READ "))
+            && page.lines().any(|line| line.starts_with("BROWSER_ACTION_REFERENCES "))
+            && marker.len() + 1 + page.len() <= 4_096
+            && serde_json::to_vec(&response.content_items).is_ok_and(|bytes| bytes.len() <= 4_608),
+        (NativeBrowserRead::InventoryV1, "browser_tabs", [DynamicToolCallOutputContentItem::InputText { text }]) => {
+            text.len() <= 8_192 && valid_native_inventory(text)
+        }
+        _ => false,
+    };
+    valid.then_some(proof)
+}
+
+fn valid_native_inventory(text: &str) -> bool {
+    let Ok(Value::Object(body)) = serde_json::from_str::<Value>(text) else { return false; };
+    let required = ["browser", "tabs", "count", "binding_state", "returned", "truncated", "next_cursor", "consistency", "content_evidence"];
+    let optional = ["inventory_state", "authentication_evidence", "next"];
+    if !required.iter().all(|key| body.contains_key(*key))
+        || body.keys().any(|key| !required.contains(&key.as_str()) && !optional.contains(&key.as_str()))
+        || body.get("browser").and_then(Value::as_str) != Some("computa_builtin")
+        || body.get("consistency").and_then(Value::as_str) != Some("retained_metadata")
+        || body.get("content_evidence").and_then(Value::as_str) != Some("metadata_only")
+        || !matches!(body.get("binding_state").and_then(Value::as_str), Some("bound_current_turn" | "unbound_current_turn")) { return false; }
+    let (Some(count), Some(returned), Some(truncated), Some(tabs)) = (
+        body.get("count").and_then(Value::as_u64), body.get("returned").and_then(Value::as_u64),
+        body.get("truncated").and_then(Value::as_bool), body.get("tabs").and_then(Value::as_array),
+    ) else { return false; };
+    if returned != tabs.len() as u64 || returned > count || truncated && (returned == 0 || returned >= count) { return false; }
+    if !match body.get("next_cursor") {
+        Some(Value::Null) => !truncated,
+        Some(Value::String(cursor)) => truncated && !cursor.is_empty() && cursor.len() <= 128,
+        _ => false,
+    } { return false; }
+    if count == 0 && !truncated {
+        if body.get("inventory_state").and_then(Value::as_str) != Some("no_matching_human_tabs")
+            || body.get("authentication_evidence").and_then(Value::as_str) != Some("not_observed")
+            || !body.get("next").and_then(Value::as_str).is_some_and(|text| !text.is_empty()) { return false; }
+    } else if optional.iter().any(|key| body.contains_key(*key)) { return false; }
+    let mut identities = std::collections::HashSet::new();
+    tabs.iter().all(|row| {
+        let Some(row) = row.as_object() else { return false; };
+        let Some(id) = row.get("tab_id").and_then(Value::as_str) else { return false; };
+        let required = ["tab_id", "title", "title_truncated", "availability"];
+        row.len() == 5 && required.iter().all(|key| row.contains_key(*key))
+            && !id.is_empty() && id.len() <= 256 && identities.insert(id)
+            && row.get("title").and_then(Value::as_str).is_some_and(|title| title.len() <= 256)
+            && row.get("title_truncated").and_then(Value::as_bool).is_some()
+            && matches!(row.get("availability").and_then(Value::as_str), Some("available" | "busy" | "bound_here"))
+            && match (row.get("url"), row.get("url_omitted")) {
+                (Some(Value::String(url)), None) => !url.is_empty() && url.len() <= 2_048,
+                (None, Some(Value::Bool(true))) => true,
+                _ => false,
+            }
+    })
+}
