+                        .await?;
+                }
+                EventMsg::Error(error) => panic!("unexpected turn failure: {error:?}"),
+                EventMsg::TurnComplete(_) => break,
+                _ => {}
+            }
+        }
+    }
+    assert_eq!(dynamic_calls, vec!["prior-status", "current-status"]);
+    for mock in [
+        &previous,
+        &previous_done,
+        &current,
+        &summary_one,
+        &continuation,
+        &summary_two,
+        &final_request,
