+        {"type":"function_call", "name":"browser_read", "call_id":"call-exact", "arguments":"{ \"cursor\": null }"},
+        {"type":"function_call_output", "call_id":"call-exact", "output":"Current tool evidence; outcome unverified."},
+        {"type":"message", "role":"user", "content":[{"type":"input_text", "text":"Do not send or modify settings.\n"}]}
+    ])).unwrap();
+    let mut projected = canonical.clone();
+    super::prepare_input_for_non_openai_provider(&mut projected);
+    assert_eq!(projected.len(), canonical.len());
+    for index in [0, 2, 3, 4] {
+        assert_eq!(projected[index], canonical[index]);
+    }
+    let ResponseItem::Message {
+        role,
+        content: actual,
+        ..
+    } = &projected[1]
+    else {
+        panic!("expected typed summary message");
+    };
+    assert_eq!(role, "assistant");
+    assert_eq!(
+        actual,
+        &content
+            .map(|text| ContentItem::OutputText { text: text.into() })
+            .to_vec()
+    );
+}
+
 fn test_model_client(session_source: SessionSource) -> ModelClient {
     test_model_client_with_thread_id(ThreadId::new(), session_source)
 }
