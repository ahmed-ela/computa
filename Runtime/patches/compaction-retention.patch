+        std::fs::symlink_metadata(&destination)?
+            .file_type()
+            .is_file()
+    );
+    assert_eq!((staged.dev(), staged.ino()), (before.dev(), before.ino()));
+    assert_eq!(staged.permissions().mode(), before.permissions().mode());
+    assert_eq!(
+        (staged.mtime(), staged.mtime_nsec()),
+        (before.mtime(), before.mtime_nsec())
+    );
+    assert_eq!(staged.nlink(), before.nlink() + 1);
+    let canonical_package = std::fs::canonicalize(&package_dir)?;
+    assert_eq!(
+        std::fs::canonicalize(&destination)?,
+        canonical_package.join("bin").join("codex-app-server")
+    );
+    assert_ne!(
+        std::fs::canonicalize(&destination)?,
+        std::fs::canonicalize(&source)?
+    );
+    assert!(canonical_package.join("codex-package.json").is_file());
+    assert_eq!(std::fs::read(&destination)?, std::fs::read(&source)?);
+
+    std::fs::remove_file(&destination)?;
+    let after = std::fs::metadata(&source)?;
+    assert_eq!((after.dev(), after.ino()), (before.dev(), before.ino()));
+    assert_eq!(after.permissions().mode(), before.permissions().mode());
+    assert_eq!(
+        (after.mtime(), after.mtime_nsec()),
+        (before.mtime(), before.mtime_nsec())
+    );
+    assert_eq!(after.nlink(), before.nlink());
+    tmp.close()?;
+    Ok(())
+}
+
+#[test]
+fn test_package_staging_rejects_existing_destination() -> Result<()> {
+    let tmp = TempDir::new()?;
+    let source = tmp.path().join("source");
+    let destination = tmp.path().join("destination");
+    std::fs::write(&source, b"source contents")?;
+    std::fs::write(&destination, b"existing contents")?;
+    std::fs::set_permissions(&source, std::fs::Permissions::from_mode(0o751))?;
+    std::fs::set_permissions(&destination, std::fs::Permissions::from_mode(0o640))?;
+    let source_before = std::fs::metadata(&source)?;
+    let destination_before = std::fs::metadata(&destination)?;
+
+    let error = stage_with_permissions(&source, &destination).unwrap_err();
+
+    assert_eq!(error.kind(), std::io::ErrorKind::AlreadyExists);
+    assert_eq!(std::fs::read(&source)?, b"source contents");
+    assert_eq!(std::fs::read(&destination)?, b"existing contents");
+    let source_after = std::fs::metadata(&source)?;
+    let destination_after = std::fs::metadata(&destination)?;
+    assert_eq!(source_after.nlink(), source_before.nlink());
+    assert_eq!(
+        source_after.permissions().mode(),
+        source_before.permissions().mode()
+    );
+    assert_eq!(destination_after.ino(), destination_before.ino());
+    assert_eq!(
+        destination_after.permissions().mode(),
+        destination_before.permissions().mode()
+    );
+    tmp.close()?;
+    Ok(())
 }
 
