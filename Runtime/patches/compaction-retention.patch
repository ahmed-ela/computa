+//! One summarizing recovery for an exact loopback-provider context rejection.
+//! The turn loop owns the per-model-step attempt bound; this module never runs tools.
+
+use std::sync::Arc;
+
+use crate::client::ModelClientSession;
+use crate::compact::InitialContextInjection;
+use crate::context::world_state::WorldState;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use codex_analytics::CompactionPhase;
+use codex_analytics::CompactionReason;
+use codex_features::Feature;
+use codex_model_provider::RemoteCompactionSupport;
+use codex_protocol::error::Result as CodexResult;
+
+pub(super) enum Recovery {
+    Reduced,
+    Unavailable,
+}
+
+pub(super) async fn compact_for_retry(
+    sess: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    client_session: &mut ModelClientSession,
+    world_state: &Arc<WorldState>,
+) -> CodexResult<Recovery> {
+    let turn_context = &step_context.turn;
+    if turn_context.config.features.enabled(Feature::TokenBudget)
+        || turn_context.provider.info().is_openai()
+        || !matches!(
+            turn_context.provider.capabilities().remote_compaction,
+            RemoteCompactionSupport::Unsupported
+        )
+        || crate::guardian::is_basic_session_source(&turn_context.session_source)
+    {
+        return Ok(Recovery::Unavailable);
+    }
+    let Some(endpoint) = turn_context
+        .provider
+        .info()
+        .base_url
+        .as_deref()
+        .and_then(|value| url::Url::parse(value).ok())
+    else {
+        return Ok(Recovery::Unavailable);
+    };
+    let loopback = matches!(endpoint.scheme(), "http" | "https")
+        && match endpoint.host() {
+            Some(url::Host::Ipv4(address)) => address.is_loopback(),
+            Some(url::Host::Ipv6(address)) => address.is_loopback(),
+            Some(url::Host::Domain(domain)) => domain.eq_ignore_ascii_case("localhost"),
+            None => false,
+        };
+    if !loopback {
+        return Ok(Recovery::Unavailable);
+    }
+    // Cached usage was marked full by the overflow path. Compare actual provider
+    // projections instead. This is only a progress guard, not a tokenizer: MLX
+    // must still check the complete retry plus output allowance before generation.
+    let Some(before) = input_bytes(sess, step_context).await else {
+        return Ok(Recovery::Unavailable);
+    };
+    super::run_auto_compact(
+        sess,
+        Arc::clone(step_context),
+        /*fallback_step_context*/ None,
+        client_session,
+        InitialContextInjection::BeforeLastUserMessage {
+            world_state: Arc::clone(world_state),
+            step_context: Arc::clone(step_context),
+        },
+        CompactionReason::ContextLimit,
+        CompactionPhase::MidTurn,
+    )
+    .await?;
+    Ok(
+        if input_bytes(sess, step_context)
+            .await
+            .is_some_and(|after| after < before)
+        {
+            Recovery::Reduced
+        } else {
+            Recovery::Unavailable
+        },
+    )
+}
+
+async fn input_bytes(sess: &Session, step_context: &StepContext) -> Option<usize> {
+    let mut input = sess
+        .clone_history()
+        .await
+        .for_prompt(&step_context.settings.model_info.input_modalities);
+    crate::client::prepare_input_for_non_openai_provider(&mut input);
+    serde_json::to_vec(&input).ok().map(|bytes| bytes.len())
+}
