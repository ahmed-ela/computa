+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn local_mid_turn_compaction_preserves_large_native_code_write_without_replay() -> Result<()>
+{
+    skip_if_target_windows!(Ok(()), "uses a POSIX-only native write fixture");
+    skip_if_no_network!(Ok(()));
+    skip_if_sandbox!(Ok(()));
+    let server = start_mock_server().await;
+    let mut provider = built_in_model_providers(None)["openai"].clone();
+    provider.name = "Local native code-write receipt test".to_string();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    let mut builder = test_codex()
+        .with_config(move |config| {
+            config.model_provider = provider;
+            config
+                .features
+                .enable(Feature::UnifiedExec)
+                .expect("test config should enable unified exec");
+            config.model_context_window = Some(32_768);
+            config.model_auto_compact_token_limit = Some(6144);
+        })
+        .with_model_info_override("gpt-5.5", |info| {
+            info.truncation_policy = TruncationPolicyConfig::tokens(10_000);
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    let original_version = test
+        .codex
+        .conversation_history_snapshot()
+        .await
+        .history_version();
+    let call_id = "native-large-code-write";
+    let expected_source = format!(
+        "# Native large-call compaction fixture\nVALUE = \"{}\"\n",
+        "x".repeat(8 * 1024)
+    );
+    // The actual built-in executor writes the code. An append-only side effect
+    // also exposes replay even if repeating the write would leave identical bytes.
+    let command = format!(
+        "printf '%s' '{expected_source}' > ledger.py && printf '%s\\n' 'native-large-code-write' >> ledger.executions && printf '%s\\n' 'NATIVE_WRITE_COMPLETE'"
+    );
+    let arguments = json!({
+        "cmd": command,
+        "login": false,
+        "tty": false,
+        "yield_time_ms": 10_000,
+        "max_output_tokens": 1024,
+    })
+    .to_string();
+    assert!((8 * 1024..9 * 1024).contains(&arguments.len()));
+    let write = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_function_call(call_id, "exec_command", &arguments),
+            // Force same-turn compaction after the real native command completes.
+            ev_completed_with_tokens("write-response", 7000),
+        ]),
+    )
+    .await;
+    let summary = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message(
+                "msg_write_summary",
+                "The code write completed. Use its receipt without repeating it.",
+            ),
+            ev_completed_with_tokens("summary-response", 10),
+        ]),
+    )
+    .await;
+    let continuation = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("msg_write_done", "DONE"),
+            ev_completed_with_tokens("done-response", 10),
+        ]),
+    )
+    .await;
+    let (sandbox_policy, permission_profile) =
+        turn_permission_fields(PermissionProfile::Disabled, test.config.cwd.as_path());
+    test.codex
+        .start_or_steer_turn(
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "Write ledger.py once, then report the result without repeating the write."
+                    .to_string(),
+                text_elements: vec![],
+            }])
+            .with_thread_settings(ThreadSettingsOverrides {
+                approval_policy: Some(AskForApproval::Never),
+                sandbox_policy: Some(sandbox_policy),
+                permission_profile,
+                ..Default::default()
+            }),
+        )
+        .await?;
+    let mut lifecycle = Vec::new();
+    let mut turn_id = None;
+    loop {
+        match wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::ExecCommandBegin(_)
+                    | EventMsg::ExecCommandEnd(_)
+                    | EventMsg::ItemCompleted(_)
+                    | EventMsg::Error(_)
+                    | EventMsg::TurnComplete(_)
+            )
+        })
+        .await
+        {
+            EventMsg::ExecCommandBegin(event) => {
+                assert_eq!(event.call_id, call_id);
+                assert!(
+                    turn_id.is_none(),
+                    "the native write must execute exactly once"
+                );
+                turn_id = Some(event.turn_id);
+                lifecycle.push("begin");
+            }
+            EventMsg::ExecCommandEnd(event) => {
+                assert_eq!(event.call_id, call_id);
+                assert_eq!(Some(&event.turn_id), turn_id.as_ref());
+                assert_eq!(event.exit_code, 0);
+                assert_eq!(event.status, ExecCommandStatus::Completed);
+                assert_eq!(event.stdout, "NATIVE_WRITE_COMPLETE\n");
+                assert!(event.stderr.is_empty());
+                lifecycle.push("end");
+            }
+            EventMsg::ItemCompleted(event)
+                if matches!(event.item, TurnItem::ContextCompaction(_)) =>
+            {
+                assert_eq!(Some(&event.turn_id), turn_id.as_ref());
+                lifecycle.push("compaction");
+            }
+            EventMsg::Error(error) => {
+                panic!("unexpected native write or compaction failure: {error:?}")
+            }
+            EventMsg::TurnComplete(event) => {
+                assert_eq!(Some(&event.turn_id), turn_id.as_ref());
+                assert!(event.error.is_none());
+                lifecycle.push("complete");
+                break;
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(lifecycle, ["begin", "end", "compaction", "complete"]);
+    // Independently read durable executor files; neither the mock answer nor a
+    // successful tool receipt is sufficient evidence that the write happened once.
+    let source_path = test.workspace_path_uri("ledger.py")?;
+    let execution_path = test.workspace_path_uri("ledger.executions")?;
+    assert_eq!(
+        test.fs()
+            .read_file_text(&source_path, Default::default(), None)
+            .await?,
+        expected_source
+    );
+    assert_eq!(
+        test.fs()
+            .read_file_text(&execution_path, Default::default(), None)
+            .await?,
+        "native-large-code-write\n"
+    );
+    for mock in [&write, &summary, &continuation] {
+        assert_eq!(
+            mock.requests().len(),
+            1,
+            "no extra sampling or compaction retries"
+        );
+    }
+    let original = tool_items(summary.single_request().input());
+    let retained = tool_items(continuation.single_request().input());
+    assert_eq!(original.len(), 2);
+    assert_eq!(original[0]["type"], "function_call");
+    assert_eq!(original[0]["call_id"], call_id);
+    assert_eq!(original[0]["name"], "exec_command");
+    assert_eq!(original[0]["arguments"], arguments);
+    assert_eq!(original[1]["type"], "function_call_output");
+    assert_eq!(original[1]["call_id"], call_id);
+    assert_eq!(
+        retained, original,
+        "retain the exact large call and genuine native result"
+    );
+    let history = test.codex.conversation_history_snapshot().await;
+    assert_eq!(history.history_version(), original_version + 1);
+    let native_receipts: Vec<_> = history
+        .items()
+        .filter_map(|item| match item {
+            ResponseItem::FunctionCall { call_id: id, .. }
+            | ResponseItem::FunctionCallOutput {
+                call_id: Some(id), ..
+            } if id == call_id => Some(item),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(native_receipts.len(), 2);
+    assert!(
+        matches!(native_receipts[0], ResponseItem::FunctionCall { arguments: retained_arguments, .. } if retained_arguments == &arguments)
+    );
+    assert!(matches!(
+        native_receipts[1],
+        ResponseItem::FunctionCallOutput { .. }
+    ));
+    Ok(())
+}
