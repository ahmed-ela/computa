+#[tokio::test]
+async fn producer_transcript_keeps_head_tail_when_broadcast_lags_and_poll_drains()
+-> anyhow::Result<()> {
+    let StreamingOutputHarness {
+        process,
+        stdout_tx,
+        exit_tx,
+        transcript,
+        context,
+        rx_event,
+    } = unstreamed_output_harness().await?;
+    // Hold a slow UI receiver while the real producer publishes >64 chunks.
+    let mut slow_receiver = process.output_receiver();
+    let mut expected = HeadTailBuffer::default();
+    for index in 0..96 {
+        let mut chunk = vec![b'a' + (index % 26) as u8; 16384];
+        // Retain invalid bytes and split UTF-8 exactly as the producer saw them;
+        // the completed item applies the established lossy UTF-8 conversion.
+        chunk[0] = 0xff;
+        chunk[1..5].copy_from_slice("😀".as_bytes());
+        chunk[16383] = 0xc3;
+        expected.push_chunk(&chunk);
+        stdout_tx.send(chunk).expect("producer chunk");
+        wait_for_captured_output(&process, expected.total_bytes()).await;
+        let polled = UnifiedExecProcessManager::collect_output_until_deadline(
+            process.output_handles(),
+            /*pause_state*/ None,
+            Instant::now(),
+        )
+        .await;
+        assert_eq!(polled.total_bytes(), 16384);
+    }
+    assert!(matches!(
+        slow_receiver.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Lagged(_))
+    ));
+    drop(slow_receiver);
+    drop(stdout_tx);
+    exit_tx.send(0).expect("send exit");
+    wait_for_output_closed(&process).await;
+    assert_eq!(
+        transcript.lock().await.retained_bytes(),
+        UNIFIED_EXEC_OUTPUT_MAX_BYTES
+    );
+    assert_eq!(
+        transcript.lock().await.omitted_bytes(),
+        96 * 16384 - UNIFIED_EXEC_OUTPUT_MAX_BYTES
+    );
+    assert_eq!(*transcript.lock().await, expected);
+    assert_eq!(
+        process
+            .output_handles()
+            .output_buffer
+            .lock()
+            .await
+            .total_bytes(),
+        0
+    );
+    start_streaming_output(&process, &context);
+    #[allow(deprecated)]
+    let cwd = context.step_context.turn.cwd.clone().into();
+    spawn_exit_watcher(
+        Arc::clone(&process),
+        &context,
+        vec!["proof".to_string()],
+        cwd,
+        /*process_id*/ 123,
+        /*plugin_attribution*/ None,
+        Instant::now(),
+        /*network_denial_monitor*/ None,
+        /*plugin_metrics_sidecar*/ None,
+    );
+    let item = completed_command(&rx_event).await;
+    assert_eq!(
+        item.aggregated_output,
+        Some(String::from_utf8_lossy(&expected.to_bytes_with_omission_marker()).into_owned())
+    );
+    assert_eq!(*transcript.lock().await, expected);
+    Ok(())
+}
