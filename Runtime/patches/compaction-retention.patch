+        .iter()
+        .find(|item| item["type"] == "function_call" && item["call_id"] == "current-plan")
+        .expect("the genuine current planning call")
+        .clone();
+    let plan_output = summary_two
+        .single_request()
+        .function_call_output("current-plan");
+    assert_eq!(plan_output["output"], "Plan updated");
+    let final_receipts = tool_items(final_request.single_request().input());
+    match fixture {
+        ReceiptFixture::TextOnly => {
+            // Once the planning call completes, the prior observation uses the older-output
+            // budget. Derive its exact expected excerpt from the genuine first retained receipt.
+            let mut historical_payload: FunctionCallOutputPayload =
+                serde_json::from_value(output["output"].clone())?;
+            truncate_function_output_payload(
+                &mut historical_payload,
+                TruncationPolicy::Bytes(1920),
+                |_| 0,
+            );
+            assert!(
+                historical_payload
+                    .body
+                    .to_text()
+                    .expect("historical text remains")
+                    .len()
+                    <= 2048
+            );
+            output["output"] = serde_json::to_value(historical_payload)?;
+            assert_eq!(final_receipts, vec![call, output, plan_call, plan_output])
+        }
+        ReceiptFixture::MixedImages => {
+            assert_eq!(final_receipts.len(), 4);
+            assert_eq!(final_receipts[0], call);
+            assert_eq!(final_receipts[2..], [plan_call, plan_output]);
+            let final_output: FunctionCallOutputPayload =
+                serde_json::from_value(final_receipts[1]["output"].clone())?;
+            let text = final_output
+                .body
+                .to_text()
+                .expect("historical text remains");
+            assert!(text.contains("[omitted 1 historical image items during context compaction; obtain a fresh capture for image-dependent actions]"));
+            assert!(
+                text.contains("actual failure prefix:") && text.ends_with(":actual failure suffix")
+            );
+            assert!(text.len() <= 2048);
+            assert!(!serde_json::to_string(&final_receipts)?.contains("input_image"));
+        }
+    }
+    let original_reply = current
+        .single_request()
+        .input()
+        .into_iter()
+        // Native request construction intentionally strips unprefixed legacy IDs (e.g. "m0").
+        // Supply a valid ID and require that same genuine identity through both replacements.
+        .find(|item| item["role"] == "assistant" && item["id"] == "msg_previous")
+        .expect("the original completed prior assistant reply");
+    for request in [
+        continuation.single_request(),
+        final_request.single_request(),
+    ] {
+        let input = request.input();
+        let text_position = |text: &str| {
+            input
+                .iter()
+                .position(|item| {
+                    item["content"]
+                        .as_array()
+                        .is_some_and(|parts| parts.iter().any(|part| part["text"] == text))
+                })
+                .expect("the unchanged historical or current user message")
+        };
+        let matching_replies: Vec<_> = input
+            .iter()
+            .enumerate()
+            .filter(|(_, item)| **item == original_reply)
+            .collect();
+        assert_eq!(matching_replies.len(), 1);
+        let reply_position = matching_replies[0].0;
+        assert!(text_position("Previous task") < reply_position);
+        assert!(
+            reply_position < text_position("New task: status once, then update plan and report")
+        );
+    }
+    Ok(())
+}
+
+fn tool_items(input: Vec<Value>) -> Vec<Value> {
+    input
+        .into_iter()
+        .filter(|item| {
+            matches!(
+                item["type"].as_str(),
+                Some("function_call" | "function_call_output")
+            )
+        })
+        .collect()
+}
