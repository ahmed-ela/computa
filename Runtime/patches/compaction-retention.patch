+fn minimum_receipt_candidate(history: &[ResponseItemEnvelope], omit_context: bool) -> Vec<ResponseItemEnvelope> {
+    let mut result = history.to_vec();
+    let latest = history.len() - 1;
+    for index in (1..history.len()).step_by(2) {
+        let ResponseItem::FunctionCallOutput { output, .. } = &history[index].item else { unreachable!() };
+        let browser = browser_observation_retention(&history[index - 1].item, output, index == latest).unwrap();
+        let mut body = if index == latest && browser.as_ref().is_some_and(|value| value.complete) { output.clone() }
+            else if let Some(observation) = browser { historical_browser_output(output, &observation, 256) }
+            else { bounded_output(output, 256, false).unwrap() };
+        if omit_context && index != latest { omit_historical_browser_context(&mut body); }
+        let ResponseItem::FunctionCallOutput { output, .. } = &mut result[index].item else { unreachable!() }; *output = body;
+    }
+    result
+}
