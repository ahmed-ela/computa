+    let capture_metadata = "CAPTURE id=synthetic-capture-12 width=1280 height=900 screenshot_freshness=retained_original";
+    let latest_ax = format!(
+        "AXSNAPSHOT id=synthetic-ax-12 capture_id=synthetic-capture-12 shown=37 total=37 source_truncated=0 output_truncated=0 parents=[0:-]\n#0 role=\"AXWebArea\" label=\"Records\" actions=[] parent=-\n{}",
+        (1..=36).map(|index| format!("#{index} role=\"AXStaticText\" value=\"Record {index:02} status: pending review\" actions=[] parent=0\n")).collect::<String>()
+    );
