+        "operation_kind":kind, "operation_complete":true, "no_replay":true, "result_verified":false,
+        "current_observation":{"status":"available","view":"overview", "snapshot_id":"00000000-0000-4000-8000-000000000001","text":page},
+        "next":"Use this observation; continue only its next_cursor. Operation complete; do not repeat it."
+    });
+    if kind == "navigate" { body["navigation_complete"] = json!(true); }
+    else {
+        let object = body.as_object_mut().unwrap();
+        object.extend(json!({"browser":"computa_builtin","tab_id":"observed-tab", "tab_handle":"00000000-0000-4000-8000-000000000002",
+            "bound":true,"ownership":"task_created","already_bound":false,"profile":"shared_human"}).as_object().unwrap().clone());
