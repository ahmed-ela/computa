+fn message(role: &str, turn: &str, text: &str) -> ResponseItemEnvelope {
+    let mut item: ResponseItem = serde_json::from_value(json!({
+        "type":"message", "id":format!("{turn}-{role}"), "role":role,
+        "content":[{"type":if role == "assistant" { "output_text" } else { "input_text" }, "text":text}]
+    })).unwrap();
+    item.set_turn_id_if_missing(turn);
+    item.into()
+}
+
+#[test]
+fn preserves_real_replies_at_their_own_user_boundaries_without_current_or_summary_replay() {
+    let user = message("user", "old", "Reply ACK");
+    let answer = message("assistant", "old", "ACK");
+    let current = message("user", "current", "Now answer a different question");
+    let summary = message(
+        "user",
+        "current",
+        &format!("{}\nSummary", super::super::SUMMARY_PREFIX),
+    );
+    let original = vec![
+        user.clone(),
+        answer.clone(),
+        current.clone(),
+        message("assistant", "current", "summary-only"),
+    ];
+    let mut replacement = vec![user.clone(), current.clone(), summary.clone()];
+    assert_eq!(
+        restore_prior_replies(&mut replacement, &original, "current"),
+        1
+    );
+    assert_eq!(replacement, vec![user, answer, current, summary]);
+}
+
+#[test]
+fn bounded_unicode_excerpts_are_stable_across_repeated_compaction() {
+    let users: Vec<_> = (0..8)
+        .map(|i| message("user", &i.to_string(), "Question"))
+        .collect();
+    let original: Vec<_> = users
+        .iter()
+        .enumerate()
+        .flat_map(|(i, user)| {
+            [
+                user.clone(),
+                message(
+                    "assistant",
+                    &i.to_string(),
+                    &format!("start:{}:end", "診断".repeat(2000)),
+                ),
+            ]
+        })
+        .collect();
+    let mut replacement = users.clone();
+    let count = restore_prior_replies(&mut replacement, &original, "current");
+    assert!(count > 0 && count <= 4);
+    let replies: Vec<_> = replacement
+        .iter()
+        .filter(
+            |item| matches!(&item.item, ResponseItem::Message { role, .. } if role == "assistant"),
+        )
+        .collect();
+    assert!(
+        replies
+            .iter()
+            .map(|item| serde_json::to_vec(&item.item).unwrap().len())
+            .sum::<usize>()
+            <= 4096
+    );
+    for reply in replies {
+        let ResponseItem::Message { content, .. } = &reply.item else {
+            unreachable!()
+        };
+        let [ContentItem::OutputText { text }] = content.as_slice() else {
+            unreachable!()
+        };
+        assert!(
+            text.len() <= 1024
+                && text.starts_with("start:")
+                && text.ends_with(":end")
+                && text.contains("truncated")
+        );
+    }
+    let mut again = users;
+    restore_prior_replies(&mut again, &replacement, "current");
+    assert_eq!(again, replacement);
+}
+
+#[test]
+fn missing_user_identity_and_latest_commentary_are_not_substituted() {
+    let user = message("user", "old", "Question");
+    let mut latest = message("assistant", "old", "incomplete commentary");
+    if let ResponseItem::Message { phase, .. } = &mut latest.item {
+        *phase = Some(MessagePhase::Commentary);
+    }
+    let original = vec![
+        message("assistant", "orphan", "no matching user"),
+        user.clone(),
+        message("assistant", "old", "earlier"),
