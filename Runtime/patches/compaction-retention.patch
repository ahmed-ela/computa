index 0000000..69c562b
--- /dev/null
+++ b/codex-rs/core/src/compact_assistant_history.rs
@@ -0,0 +1,121 @@
+//! Keep bounded real assistant replies beside their surviving historical user messages.
+//! Without these role boundaries, small local models can answer old requests again. These are
+//! excerpts of actual text, not fabricated acknowledgments or proof that a tool action succeeded.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::ResponseItem;
+use codex_utils_output_truncation::TruncationPolicy;
+use codex_utils_output_truncation::truncate_text;
+
+pub(super) fn restore_prior_replies(
+    replacement: &mut Vec<ResponseItemEnvelope>,
+    original: &[ResponseItemEnvelope],
+    current_turn: &str,
+) -> usize {
+    let mut user_boundaries = HashMap::new();
+    for (index, envelope) in replacement.iter().enumerate() {
+        if let Some(turn) = envelope.turn_id()
+            && turn != current_turn
+            && !turn.is_empty()
+            && let Some(user) = super::compacted_user_message(&envelope.item, None)
+        {
+            // Rebuilt user IDs may differ. Require a unique exact text/turn match instead;
+            // a truncated or ambiguous boundary is not safe to attach an old reply to.
+            let mut matches = original.iter().enumerate().filter(|(_, prior)| {
+                prior.turn_id() == Some(turn)
+                    && super::compacted_user_message(&prior.item, None)
+                        .is_some_and(|prior| prior.message == user.message)
+            });
+            user_boundaries.remove(turn);
+            if let Some((source, _)) = matches.next()
+                && matches.next().is_none()
+            {
+                let end = original
+                    .iter()
+                    .enumerate()
+                    .skip(source + 1)
+                    .find(|(_, next)| super::compacted_user_message(&next.item, None).is_some())
+                    .map_or(original.len(), |(index, _)| index);
+                user_boundaries.insert(turn.to_string(), (index, source, end));
+            }
+        }
+    }
+    let mut seen = HashSet::new();
+    let mut retained = Vec::new();
+    let mut bytes = 0;
+    for (source_index, envelope) in original.iter().enumerate().rev() {
+        let Some(turn) = envelope.turn_id() else {
+            continue;
+        };
+        let Some(&(boundary, start, end)) = user_boundaries.get(turn) else {
+            continue;
+        };
+        let ResponseItem::Message {
+            role,
+            phase,
+            internal_chat_message_metadata_passthrough,
+            ..
+        } = &envelope.item
+        else {
+            continue;
+        };
+        if role != "assistant" || !seen.insert(turn) {
+            continue;
+        }
+        // None is the native compatibility case for local models without phase metadata.
+        // Do not substitute an older message for an unsupported latest assistant message.
+        if source_index <= start
+            || source_index >= end
+            || !matches!(phase, None | Some(MessagePhase::FinalAnswer))
+            || internal_chat_message_metadata_passthrough
+                .as_ref()
+                .and_then(|metadata| metadata.content_item_kinds.as_ref())
+                .is_some_and(|kinds| kinds.iter().any(|kind| kind.0 == "compaction.summary"))
+        {
+            continue;
+        }
+        let mut reply = envelope.clone();
+        let ResponseItem::Message { content, .. } = &mut reply.item else {
+            continue;
+        };
+        let [ContentItem::OutputText { text }] = content.as_mut_slice() else {
+            continue;
+        };
+        if text.trim().is_empty() {
+            continue;
+        }
+        if text.len() > 1024 {
+            *text = truncate_text(text, TruncationPolicy::Bytes(896));
+        }
+        if text.len() > 1024 {
+            continue;
+        }
+        let Ok(size) = serde_json::to_vec(&reply.item).map(|item| item.len()) else {
+            continue;
+        };
+        if size > 2048 || bytes + size > 4096 {
+            continue;
+        }
+        bytes += size;
+        retained.push((boundary, reply));
+        if retained.len() == 4 {
+            break;
+        }
+    }
+    // Reverse-index insertion preserves order and places replies before the current task/summary.
+    retained.sort_by_key(|(boundary, _)| std::cmp::Reverse(*boundary));
+    let count = retained.len();
+    for (boundary, reply) in retained {
+        replacement.insert(boundary + 1, reply);
+    }
+    count
+}
