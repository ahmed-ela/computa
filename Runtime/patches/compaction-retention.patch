+fn stage_with_permissions(source: &Path, destination: &Path) -> std::io::Result<()> {
+    // Keep the package alias while reusing the executable's existing inode on
+    // the same filesystem. Never chmod a hard link: that would change the source.
+    let staging = match std::fs::hard_link(source, destination) {
+        Ok(()) => "hardlink",
+        Err(error) if error.kind() == std::io::ErrorKind::CrossesDevices => {
+            std::fs::copy(source, destination)?;
+            std::fs::set_permissions(destination, std::fs::metadata(source)?.permissions())?;
+            "copy_exdev"
+        }
+        Err(error) => return Err(error),
+    };
+    let source_metadata = std::fs::metadata(source)?;
+    let destination_metadata = std::fs::metadata(destination)?;
+    eprintln!(
+        "zshForkFixtureStage={staging} executable={} sourceDevice={} sourceInode={} destinationDevice={} destinationInode={}",
+        destination
+            .file_name()
+            .unwrap_or_default()
+            .to_string_lossy(),
+        source_metadata.dev(),
+        source_metadata.ino(),
+        destination_metadata.dev(),
+        destination_metadata.ino()
+    );
+    Ok(())
+}
