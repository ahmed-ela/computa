+fn complete_browser_lifecycle_pair(id: &str, kind: &str, page: &str) -> Vec<ResponseItemEnvelope> {
+    let mut history = complete_browser_pair(id, page);
+    if let ResponseItem::FunctionCall { name, arguments, .. } = &mut history[0].item {
+        *name = format!("browser_{kind}");
+        *arguments = if kind == "bind" { r#"{ "tab_id": "observed-tab" }"#.to_string() }
+            else { r#"{ "url": "https://example.test/observed" }"#.to_string() };
