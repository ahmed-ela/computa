+fn assert_receipt_bounds(retained: &[ResponseItemEnvelope]) {
+    let mut text_receipts = retained.to_vec();
+    let mut images = 0;
+    let latest_output = text_receipts
+        .iter()
+        .rposition(|envelope| matches!(envelope.item, ResponseItem::FunctionCallOutput { .. }));
+    for (index, envelope) in text_receipts.iter_mut().enumerate() {
+        if let ResponseItem::FunctionCallOutput { output, .. } = &mut envelope.item {
+            let text_limit = if Some(index) == latest_output {
+                MAX_LATEST_OUTPUT_TEXT_BYTES
+            } else {
+                MAX_OUTPUT_TEXT_BYTES
+            };
+            assert!(output_text_bytes(&output.body) <= text_limit);
+            if let FunctionCallOutputBody::ContentItems(items) = &mut output.body {
+                for item in items {
+                    if matches!(item, FunctionCallOutputContentItem::InputImage { .. }) {
+                        images += 1;
+                        assert!(serde_json::to_vec(item).unwrap().len() <= MAX_LATEST_IMAGE_BYTES);
+                        if let FunctionCallOutputContentItem::InputImage { image, .. } = item {
+                            *image = ImageReference::Inline {
+                                image_url: String::new(),
+                            };
+                        }
+                    }
+                }
+            }
+            let serialized_limit = if Some(index) == latest_output {
+                MAX_LATEST_OUTPUT_BYTES
+            } else {
+                MAX_OUTPUT_BYTES
+            };
+            assert!(serde_json::to_vec(&envelope.item).unwrap().len() <= serialized_limit);
+        }
+    }
+    assert!(images <= 1);
+    assert!(
+        text_receipts
+            .iter()
+            .map(|item| serde_json::to_vec(&item.item).unwrap().len())
+            .sum::<usize>()
+            <= MAX_RECEIPT_BYTES
+    );
+}
