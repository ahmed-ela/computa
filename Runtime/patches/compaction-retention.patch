+                "contentItems":[{"type":"inputText","text":"already completed"}],
+                "success":true,"nativeBrowserRead":proof
+            }));
+            assert!(error.is_none());
+            assert!(result.success);
+            assert_eq!(result.native_browser_read, None);
+            assert_eq!(result.content_items, vec![DynamicToolCallOutputContentItem::InputText { text:"already completed".to_string() }]);
+        }
+    }
+
+    #[test]
+    fn completed_continuation_proof_survives_native_response_decode() {
+        let body = json!({"contentItems":[{"type":"inputText","text":"unchanged completed page"}],
+            "success":true,"nativeBrowserRead":"continue_v1"});
+        let (result, error) = decode_response(body.clone());
+        assert!(error.is_none());
+        assert_eq!(result.native_browser_read, Some(codex_protocol::dynamic_tools::NativeBrowserRead::ContinueV1));
+        assert_eq!(serde_json::to_value(result).unwrap(), body);
+    }
+}
