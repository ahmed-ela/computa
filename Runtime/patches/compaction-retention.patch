+    let mut multiple = image_pair("multiple", "caption");
+    if let ResponseItem::FunctionCallOutput { output, .. } = &mut multiple[1].item {
+        output
+            .content_items_mut()
+            .unwrap()
+            .push(observation_image());
+    }
+    assert!(
+        current_turn_receipts(&multiple, "current")
+            .unwrap_err()
+            .to_string()
+            .contains("multiple observation images")
