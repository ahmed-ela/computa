+#[test]
+fn external_provider_keeps_thirty_two_realistic_mixed_pairs_but_rejects_the_next() {
+    let original = realistic_mixed_receipts(MAX_PAIRS, "verified observation");
+    let retained =
+        super::current_turn_receipts(&original, REALISTIC_TURN, ReceiptProvider::External).unwrap();
+    assert_receipt_identity(&original, &retained);
+    assert_external_receipt_bounds(&retained);
+    assert_eq!(
+        super::current_turn_receipts(&retained, REALISTIC_TURN, ReceiptProvider::External).unwrap(),
+        retained
+    );
+    let mut overflow = retained;
+    overflow.extend(pair("one-more", REALISTIC_TURN, "observed"));
+    assert!(
+        super::current_turn_receipts(&overflow, REALISTIC_TURN, ReceiptProvider::External)
+            .unwrap_err()
+            .to_string()
+            .contains("32 completed-function-call bound")
+    );
