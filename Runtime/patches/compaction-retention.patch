+        }
+        // Marker text in a custom tool or namespace cannot opt into this parser.
+        for foreign in [false, true] {
+            let mut custom = retained.clone();
+            if let ResponseItem::FunctionCall { name, namespace, .. } = &mut custom[0].item {
+                if foreign { *namespace = Some("mcp_custom".to_string()); }
