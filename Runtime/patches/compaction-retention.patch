+                    "unquoted_role" => *text = text.replace("role=\"AXButton\"", "role=AXButton"),
+                    "missing_defaults" => *text = text.replace(&format!("{}\n", HISTORICAL_BROWSER_ROW_DEFAULTS), ""),
+                    "unknown_line" => text.push_str("\ncomplete browser prose"),
+                    "duplicate_url" => *text = text.replacen("observed_url=", "observed_url=\"one\"\nobserved_url=", 1),
+                    _ => {},
