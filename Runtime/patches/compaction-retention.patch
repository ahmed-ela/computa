+#[test]
+fn proof_preserves_order_multiplicity_unicode_and_does_not_follow_item_ids() {
+    let input = vec![human("first"), human("e\u{301}"), human("first")];
+    let original = parsed(&input);
+    assert_eq!(original["indices"], json!([0, 1, 2]));
+    let mut changed = input.clone();
+    changed.swap(0, 1);
+    assert_ne!(parsed(&changed)["sha256"], original["sha256"]);
+    changed = input.clone();
+    changed[1] = human("é");
+    assert_ne!(parsed(&changed)["sha256"], original["sha256"]);
+    changed = input.clone();
+    changed.pop();
+    assert_ne!(parsed(&changed)["sha256"], original["sha256"]);
+    let mut reidentified = input.clone();
+    for item in &mut reidentified {
+        item.set_id(Some(codex_protocol::ResponseItemId::new("msg")));
+    }
+    let reloaded: Vec<ResponseItem> =
+        serde_json::from_slice(&serde_json::to_vec(&reidentified).unwrap()).unwrap();
+    assert_eq!(parsed(&reloaded), original);
+    let framed_a = parsed(&[human("ab"), human("c")]);
+    let framed_b = parsed(&[human("a"), human("bc")]);
+    assert_ne!(framed_a["sha256"], framed_b["sha256"]);
