+    // Serial responses make the latest completed output unambiguously receipt-8.
+    // Only the ninth result crosses the automatic-compaction threshold.
+    let mut first_requests = Vec::new();
+    for index in 0..9 {
+        first_requests.push(
+            mount_sse_once(
+                &server,
+                sse(vec![
+                    ev_function_call(
+                        &format!("receipt-{index}"),
+                        "status",
+                        &json!({"sequence":index}).to_string(),
+                    ),
+                    ev_completed_with_tokens(
+                        &format!("response-{index}"),
+                        if index == 8 { 7000 } else { 10 },
+                    ),
+                ]),
+            )
+            .await,
+        );
+    }
+    let summary_one = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message(
+                "msg_summary_one",
+                "Nine requests finished. Continue with request ten.",
+            ),
+            ev_completed_with_tokens("summary_one", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let continuation = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_function_call("receipt-9", "status", "{\"sequence\":9}"),
+            ev_completed_with_tokens("tenth_call", /*total_tokens*/ 7000),
+        ]),
+    )
+    .await;
+    let summary_two = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("msg_summary_two", "All ten requests finished. Answer now."),
+            ev_completed_with_tokens("summary_two", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let final_request = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("msg_final", "TEN_RECEIPTS_RETAINED"),
+            ev_completed_with_tokens("final", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let mut capture_images = std::collections::HashMap::new();
+    for index in [6usize, 8, 9] {
+        let mut png = std::io::Cursor::new(Vec::new());
+        let pixels = image::RgbImage::from_pixel(
+            /*width*/ 1,
+            /*height*/ 1,
+            image::Rgb([index as u8, 0, 0]),
+        );
+        image::DynamicImage::ImageRgb8(pixels).write_to(&mut png, image::ImageFormat::Png)?;
+        capture_images.insert(
+            index,
+            format!(
+                "data:image/png;base64,{}",
+                BASE64_STANDARD.encode(png.into_inner())
+            ),
+        );
+    }
+    assert_ne!(capture_images[&6], capture_images[&8]);
+    assert_ne!(capture_images[&8], capture_images[&9]);
+    let mut dispatched = Vec::new();
+    let mut compactions = 0;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text:
+                "Run the ten synthetic status requests once each, retaining their genuine results."
+                    .to_string(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    loop {
+        match wait_for_event(&test.codex, |event| {
+            matches!(
+                event,
+                EventMsg::DynamicToolCallRequest(_)
+                    | EventMsg::ItemCompleted(_)
+                    | EventMsg::Error(_)
+                    | EventMsg::TurnComplete(_)
+            )
+        })
+        .await
+        {
+            EventMsg::DynamicToolCallRequest(request) => {
+                let index = request.arguments["sequence"]
+                    .as_u64()
+                    .expect("fixture sequence") as usize;
+                assert_eq!(
+                    index,
+                    dispatched.len(),
+                    "serial fixture dispatch order must be exact"
+                );
+                assert!(
+                    index < 10,
+                    "no completed tool may be dispatched a second time"
+                );
+                assert!(
+                    !dispatched.contains(&request.call_id),
+                    "no completed tool may be dispatched a second time"
+                );
+                assert_eq!(request.call_id, format!("receipt-{index}"));
+                assert_eq!(request.arguments, json!({"sequence":index}));
+                dispatched.push(request.call_id.clone());
+                let text = if index == 9 {
+                    "tenth status completed".to_string()
+                } else {
+                    // Nine full results exceed 12 KiB; the compactor must budget all pairs,
+                    // never solve that bound by forgetting one or rerunning its action.
+                    format!(
+                        "status-{index}-prefix:{}:status-{index}-suffix",
+                        "diagnostic ".repeat(180)
+                    )
+                };
+                let mut content_items = vec![DynamicToolCallOutputContentItem::InputText { text }];
+                if let Some(image_url) = capture_images.get(&index) {
+                    content_items.push(DynamicToolCallOutputContentItem::InputImage {
+                        image_url: image_url.clone(),
+                    });
+                }
+                test.codex
+                    .submit(Op::DynamicToolResponse {
+                        id: request.call_id,
+                        response: DynamicToolResponse {
+                            content_items,
+                            success: index != 4,
+                        },
+                    })
+                    .await?;
+            }
+            EventMsg::ItemCompleted(event)
+                if matches!(event.item, TurnItem::ContextCompaction(_)) =>
+            {
+                compactions += 1
+            }
+            EventMsg::Error(error) => {
+                panic!("unexpected compaction or continuation failure: {error:?}")
+            }
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    assert_eq!(
+        dispatched,
+        (0..10)
+            .map(|index| format!("receipt-{index}"))
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(compactions, 2);
+    for mock in
+        first_requests
+            .iter()
+            .chain([&summary_one, &continuation, &summary_two, &final_request])
+    {
+        assert_eq!(mock.requests().len(), 1);
+    }
+    let original = tool_items(summary_one.single_request().input());
+    let first_receipts = tool_items(continuation.single_request().input());
+    let final_receipts = tool_items(final_request.single_request().input());
+    assert_eq!(original.len(), 18);
+    assert_eq!(first_receipts.len(), 18);
+    assert_eq!(final_receipts.len(), 20);
+    // All identities remain exact. The formerly-latest image changes into an explicit
+    // historical omission only after the tenth result supplies a fresh capture.
+    for item in &first_receipts {
+        if item["type"] == "function_call_output" && item["call_id"] == "receipt-8" {
+            continue;
+        }
+        let after = final_receipts
+            .iter()
+            .find(|other| other["type"] == item["type"] && other["call_id"] == item["call_id"])
+            .unwrap();
+        assert_eq!(
+            after, item,
+            "repeated compaction must not degrade unchanged receipts"
+        );
+    }
+    for index in 0..9 {
+        let id = format!("receipt-{index}");
+        let call = |items: &[Value]| {
+            items
+                .iter()
+                .find(|item| item["type"] == "function_call" && item["call_id"] == id)
+                .unwrap()
+                .clone()
+        };
+        assert_eq!(
+            call(&first_receipts),
+            call(&original),
+            "call identity and arguments must be exact"
+        );
+        let output = first_receipts
+            .iter()
+            .find(|item| item["type"] == "function_call_output" && item["call_id"] == id)
+            .unwrap();
+        let payload: FunctionCallOutputPayload = serde_json::from_value(output["output"].clone())?;
+        let text = payload.body.to_text().expect("real retained text");
+        assert!(
+            text.contains(&format!("status-{index}-prefix:"))
+                && text.ends_with(&format!(":status-{index}-suffix"))
+        );
+        if index < 8 {
+            assert!(
+                text.contains("truncated"),
+                "older long results must yield budget to the newest observation"
+            );
+        }
+        if index == 6 {
+            assert!(text.contains("[omitted 1 historical image items during context compaction; obtain a fresh capture for image-dependent actions]"));
+        }
+    }
+    for (receipts, latest_id, expected_image) in [
+        (&first_receipts, "receipt-8", &capture_images[&8]),
+        (&final_receipts, "receipt-9", &capture_images[&9]),
+    ] {
+        let latest = receipts
+            .iter()
+            .find(|item| item["type"] == "function_call_output" && item["call_id"] == latest_id)
+            .unwrap();
+        let latest_payload: FunctionCallOutputPayload =
+            serde_json::from_value(latest["output"].clone())?;
+        let images: Vec<_> = latest_payload
+            .content_items()
+            .expect("fresh image-bearing output")
+            .iter()
+            .filter_map(|item| match item {
+                FunctionCallOutputContentItem::InputImage {
+                    image: ImageReference::Inline { image_url },
+                    ..
+                } => Some(image_url.as_str()),
+                _ => None,
+            })
+            .collect();
+        assert_eq!(
+            images,
+            vec![expected_image.as_str()],
+            "the fresh capture must reach the next model request byte-exact once"
+        );
+        let serialized = serde_json::to_string(receipts)?;
+        assert_eq!(serialized.matches("data:image/png;base64,").count(), 1);
+        assert_eq!(serialized.matches("input_image").count(), 1);
+        let mut text_receipts = (*receipts).clone();
+        for item in &mut text_receipts {
+            if let Some(parts) = item["output"].as_array_mut() {
+                for part in parts {
+                    if part["type"] == "input_image" {
+                        part["image_url"] = json!("");
+                    }
+                }
+            }
+        }
+        let bytes = text_receipts
+            .iter()
+            .map(serde_json::to_vec)
+            .collect::<std::result::Result<Vec<_>, _>>()?;
+        assert!(bytes.iter().map(Vec::len).sum::<usize>() <= 12 * 1024);
+    }
+    let retired_capture = final_receipts
+        .iter()
+        .find(|item| item["type"] == "function_call_output" && item["call_id"] == "receipt-8")
+        .unwrap();
+    assert!(serde_json::to_string(retired_capture)?.contains("[omitted 1 historical image items during context compaction; obtain a fresh capture for image-dependent actions]"));
+    let history = test.codex.conversation_history_snapshot().await;
+    assert_eq!(history.history_version(), initial_history_version + 2);
+    let failure = history
+        .items()
+        .find_map(|item| match item {
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(id),
+                output,
+                ..
+            } if id == "receipt-4" => Some(output),
+            _ => None,
+        })
+        .expect("the genuine failed result remains in native history");
+    assert_eq!(failure.success, Some(false));
+    Ok(())
+}
+
+#[test_case::test_case(ReceiptFailure::PairOverflow; "pair_overflow")]
+#[test_case::test_case(ReceiptFailure::SummaryTooLarge; "summary_exceeds_window")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn receipt_bounds_stop_without_continuation_or_history_replacement(
+    failure: ReceiptFailure,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let mut provider = built_in_model_providers(/*openai_base_url*/ None)["openai"].clone();
+    provider.name = "Local receipt overflow test".to_string();
+    provider.base_url = Some(format!("{}/v1", server.uri()));
+    provider.supports_websockets = false;
+    let mut builder = test_codex().with_config(move |config| {
+        config.model_provider = provider;
+        config.update_plan_enabled = true;
+        config.model_context_window = Some(match failure {
+            ReceiptFailure::PairOverflow => 32_768,
+            ReceiptFailure::SummaryTooLarge => 8192,
+        });
+        config.model_auto_compact_token_limit = Some(6144);
+    });
+    let test = builder.build_with_auto_env(&server).await?;
+    let original_version = test
+        .codex
+        .conversation_history_snapshot()
+        .await
+        .history_version();
+    let call_count = match failure {
+        ReceiptFailure::PairOverflow => 33,
+        ReceiptFailure::SummaryTooLarge => 1,
+    };
+    let mut events: Vec<_> = (0..call_count)
+        .map(|index| ev_function_call(&format!("plan-{index}"), "update_plan", "{\"plan\":[]}"))
+        .collect();
+    events.push(ev_completed_with_tokens(
+        "overflow", /*total_tokens*/ 7000,
+    ));
+    let first = mount_sse_once(&server, sse(events)).await;
+    let oversized_summary = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("msg_oversized_summary", &"S".repeat(50 * 1024)),
+            ev_completed_with_tokens("summary", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let unexpected = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("unexpected", "must not sample"),
+            ev_completed_with_tokens("unexpected", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Run the read-only planning fixture".to_string(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let error = wait_for_event(&test.codex, |event| matches!(event, EventMsg::Error(_))).await;
+    let EventMsg::Error(error) = error else {
+        unreachable!()
+    };
+    let expected_error = match failure {
+        ReceiptFailure::PairOverflow => "32 completed-function-call bound",
+        ReceiptFailure::SummaryTooLarge => "effective context window",
+    };
+    assert!(
+        error.message.contains(expected_error),
+        "unexpected error: {error:?}"
+    );
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert_eq!(first.requests().len(), 1);
+    assert_eq!(
+        oversized_summary.requests().len(),
+        match failure {
+            ReceiptFailure::PairOverflow => 0,
+            ReceiptFailure::SummaryTooLarge => 1,
+        }
+    );
+    assert_eq!(unexpected.requests().len(), 0);
+    let history = test.codex.conversation_history_snapshot().await;
+    assert_eq!(
+        history.history_version(),
+        original_version,
+        "rejected compaction must not replace live history"
+    );
+    let history_items: Vec<_> = history
+        .items()
+        .map(serde_json::to_value)
+        .collect::<std::result::Result<_, _>>()?;
+    if matches!(failure, ReceiptFailure::SummaryTooLarge) {
+        let summary = history_items
+            .iter()
+            .find(|item| item["id"] == "msg_oversized_summary")
+            .expect("failed compactor output remains explicitly classified");
+        assert_eq!(
+            summary["internal_chat_message_metadata_passthrough"]["content_item_kinds"],
+            json!(["compaction.summary"])
+        );
+    }
+    for index in 0..call_count {
+        let id = format!("plan-{index}");
+        for kind in ["function_call", "function_call_output"] {
+            assert_eq!(
+                history_items
+                    .iter()
+                    .filter(|item| item["type"] == kind && item["call_id"] == id)
+                    .count(),
+                1
+            );
+        }
+    }
+    test.codex.flush_rollout().await?;
+    let rollout =
+        std::fs::read_to_string(test.codex.rollout_path().expect("isolated fixture rollout"))?;
+    for line in rollout.lines() {
+        assert!(
+            !matches!(
+                codex_rollout::parse_rollout_line(line)?.item,
+                codex_history::RolloutItem::Compacted(_)
+            ),
+            "rejected compaction must not persist a replacement checkpoint"
+        );
+    }
+    Ok(())
+}
