+fn native_continuation_keeps_latest_page_atomic_and_exact_call_identity_on_reload() {
+    let mut original = proven_native_read("legacy-read", "current", false);
+    original.extend(proven_native_read("inventory", "current", true));
+    original.extend(proven_native_continuation("continue-old", "current", "opaque e\u{301} 🙂"));
+    let mut current = complete_browser_pair("continue-latest", "AXSNAPSHOT id=current\n#1 role=AXStaticText label=\"exact current page\"\n");
+    if let ResponseItem::FunctionCall { name, arguments, .. } = &mut current[0].item {
+        *name = "browser_continue".into();
+        *arguments = r#"{ "cursor" : "latest\\literal" }"#.into();
+    }
+    current[1].metadata.as_mut().unwrap().native_browser_read = Some(codex_protocol::dynamic_tools::NativeBrowserRead::ContinueV1);
+    original.extend(current.clone());
+    original.extend(pair("later-nonbrowser", "current", "actual later result"));
+    let packed = packed_native_reads(&original, "current", &[7, 9]);
+    let mut retained = super::current_turn_receipts(&packed, "current", ReceiptProvider::External).unwrap();
+    assert!(retained.iter().any(|item| item == &current[1]), "latest continuation page stays exact despite later work");
+    for _ in 0..3 {
+        assert_external_receipt_bounds(&retained);
+        let expanded = native_read_ledger::expand(&retained, "current").unwrap();
+        let calls: Vec<_> = expanded.items.iter().filter(|item| matches!(item.item, ResponseItem::FunctionCall { .. })).collect();
+        let originals: Vec<_> = original.iter().filter(|item| matches!(item.item, ResponseItem::FunctionCall { .. })).collect();
+        assert_eq!(calls, originals, "names, raw arguments, local IDs, timestamps and order are exact");
+        assert!(retained.iter().any(|item| item.metadata.as_ref().and_then(|m|m.native_completed_reads.as_ref()).is_some_and(|run|
+            run.records.iter().any(|record| record.kind == codex_protocol::dynamic_tools::NativeBrowserRead::ContinueV1))));
+        let items: Vec<ResponseItem> = serde_json::from_value(serde_json::to_value(retained.iter().map(|e|&e.item).collect::<Vec<_>>()).unwrap()).unwrap();
+        let metadata: Vec<Option<CodexHarnessMetadata>> = serde_json::from_value(serde_json::to_value(retained.iter().map(|e|&e.metadata).collect::<Vec<_>>()).unwrap()).unwrap();
+        let reloaded: Vec<_> = items.into_iter().zip(metadata).map(|(item,metadata)|ResponseItemEnvelope{item,metadata}).collect();
+        let again = super::current_turn_receipts(&reloaded, "current", ReceiptProvider::External).unwrap();
+        assert_eq!(serde_json::to_value(again.iter().map(|e|(&e.item,&e.metadata)).collect::<Vec<_>>()).unwrap(), serde_json::to_value(reloaded.iter().map(|e|(&e.item,&e.metadata)).collect::<Vec<_>>()).unwrap());
+        retained = again;
+    }
+}
