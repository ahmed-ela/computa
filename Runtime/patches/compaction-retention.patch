+        call_id:"exact-native-call".to_string(),
+        payload:ToolPayload::Function { arguments:"{}".to_string() },
+        result:Box::new(PostToolUseFeedbackOutput { original,
+            model_visible:crate::tools::context::FunctionToolOutput::from_text("hook changed output".to_string(), Some(true)),
+        }), post_tool_use_payload:None,
+    }.into_response();
+    let metadata = response.metadata.unwrap();
