+/// A native app-server receipt, never inferred from tool text or model arguments.
+/// Core accepts it only for the pending matching successful built-in read.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "snake_case")]
+#[ts(export_to = "v2/")]
+pub enum NativeBrowserRead {
+    ReadV1,
+    InventoryV1,
+    ContinueV1,
+}
+
+/// The split continuation contract accepts one opaque cursor only. This checks
+/// shape, not cursor authority; the native browser owns lifetime and admission.
+pub fn valid_native_browser_continue_arguments(arguments: &JsonValue) -> bool {
+    arguments.as_object().is_some_and(|arguments| {
+        arguments.len() == 1
+            && arguments.get("cursor").and_then(JsonValue::as_str)
+                .is_some_and(|cursor| !cursor.is_empty() && cursor.len() <= 2_048)
+    })
+}
+
+/// Optional forward-compatible evidence must not change an already completed
+/// tool result when a client supplies an unknown or malformed proof value.
+pub fn deserialize_native_browser_read<'de, D>(deserializer: D) -> Result<Option<NativeBrowserRead>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    let value = JsonValue::deserialize(deserializer)?;
+    Ok(serde_json::from_value(value).ok())
+}
