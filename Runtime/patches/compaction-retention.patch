--- /dev/null
+++ b/codex-rs/core/src/unified_exec/execution_completion_tests.rs
@@ -0,0 +1,80 @@
+use super::ExecutionCompletion;
+use super::ExecutionOutcome;
+use pretty_assertions::assert_eq;
+use std::task::Poll;
+use tokio::time::Duration;
+use tokio::time::timeout;
+
+#[tokio::test]
+async fn approval_waits_before_watcher_owner() {
+    let completion = ExecutionCompletion::default();
+    let wait = completion.wait_for_owner();
+    tokio::pin!(wait);
+    assert_eq!(futures::poll!(&mut wait), Poll::Pending);
+    completion.owner_ready();
+    assert!(
+        timeout(Duration::from_secs(1), wait)
+            .await
+            .expect("ready owner")
+    );
+}
+
+#[tokio::test]
+async fn approval_releases_after_watcher_owner() {
+    let completion = ExecutionCompletion::default();
+    completion.owner_ready();
+    assert!(
+        timeout(Duration::from_secs(1), completion.wait_for_owner())
+            .await
+            .expect("ready owner")
+    );
+}
+
+#[tokio::test]
+async fn closed_startup_does_not_dispatch_approval() {
+    let completion = ExecutionCompletion::default();
+    let wait = completion.wait_for_owner();
+    tokio::pin!(wait);
+    assert_eq!(futures::poll!(&mut wait), Poll::Pending);
+    drop(completion.finish_on_drop());
+    completion.owner_ready();
+    assert!(
+        !timeout(Duration::from_secs(1), wait)
+            .await
+            .expect("closed owner")
+    );
+}
+
+#[tokio::test]
+async fn user_cancel_before_completion_wins_once() {
+    let completion = ExecutionCompletion::default();
+    completion.cancel();
+    completion.cancelled().await;
+    assert_eq!(completion.claim(), Some(ExecutionOutcome::UserCancelled));
+    assert_eq!(completion.claim(), None);
+    completion.finish();
+    completion.completed().await;
+    assert_eq!(completion.claim(), None);
+}
+
+#[tokio::test]
+async fn process_completion_before_user_cancel_retains_process_exit() {
+    let completion = ExecutionCompletion::default();
+    assert_eq!(completion.claim(), Some(ExecutionOutcome::ProcessExit));
+    completion.cancel();
+    assert_eq!(completion.claim(), None);
+    completion.finish();
+    completion.completed().await;
+    completion.cancel();
+    assert_eq!(completion.claim(), None);
+}
+
+#[tokio::test]
+async fn owner_finish_unblocks_cancel_without_watcher() {
+    let completion = ExecutionCompletion::default();
+    completion.cancel();
+    let guard = completion.finish_on_drop();
+    drop(guard);
+    completion.completed().await;
+    assert_eq!(completion.claim(), None);
+}
