+            .collect();
+        history.extend(complete_browser_pair("latest", &page));
+        let mut generic = history.clone();
+        if let ResponseItem::FunctionCall { name, .. } = &mut generic[count * 2].item {
+            *name = "generic_read".to_string();
+        }
+        if super::current_turn_receipts(&generic, "current", ReceiptProvider::External).is_ok()
+            && let Err(error) = super::current_turn_receipts(&history, "current", ReceiptProvider::External)
+        {
+            assert!(error.to_string().contains("complete latest browser observation"));
+            demonstrated = true;
+            break;
+        }
+    }
+    assert!(demonstrated, "atomic retention must fail before generic lossy truncation at the same cap");
+}
