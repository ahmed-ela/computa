+#[test]
+fn nine_browser_calls_keep_every_action_and_failure_with_shared_bounded_text() {
+    let operations = [
+        "open", "open", "snapshot", "click", "capture", "click", "capture", "click", "capture",
+    ];
+    let mut history = Vec::new();
+    for (index, operation) in operations.iter().enumerate() {
+        let text = format!(
+            "actual {operation} result:{}:actual result end",
+            "x".repeat(4000)
+        );
+        let mut entries = if *operation == "capture" {
+            image_pair(&format!("call-{index}"), &text)
+        } else {
+            pair(&format!("call-{index}"), "current", &text)
+        };
+        if let ResponseItem::FunctionCall {
+            name, arguments, ..
+        } = &mut entries[0].item
+        {
+            *name = format!("computer_v2_{operation}");
+            *arguments = "{}".to_string();
+        }
+        if let ResponseItem::FunctionCallOutput { output, .. } = &mut entries[1].item {
+            output.success = Some(index != 3);
+        }
+        history.extend(entries);
+    }
+    let retained = current_turn_receipts(&history, "current").unwrap();
+    assert_receipt_identity(&history, &retained);
+    assert_receipt_bounds(&retained);
+    assert_eq!(
+        current_turn_receipts(&retained, "current").unwrap(),
+        retained
+    );
+    for index in [4, 6] {
+        let serialized = serde_json::to_string(&retained[index * 2 + 1].item).unwrap();
+        assert!(serialized.contains("omitted 1 historical image items"));
+        assert!(!serialized.contains("input_image"));
+    }
+    let ResponseItem::FunctionCallOutput { output, .. } = &retained[17].item else {
+        unreachable!()
+    };
+    assert_eq!(
+        latest_observation_image(output).unwrap(),
+        Some(&observation_image())
+    );
