+    )
+    .await;
+    let previous_done = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("msg_previous", "previous task done"),
+            ev_completed_with_tokens("r1", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let current = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_function_call("current-status", "status", "{}"),
+            ev_completed_with_tokens("r2", /*total_tokens*/ 7000),
+        ]),
+    )
+    .await;
+    let summary_one = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("m1", "Status finished. Report its result."),
+            ev_completed_with_tokens("r3", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let continuation = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_function_call("current-plan", "update_plan", &plan_args),
+            ev_completed_with_tokens("r4", /*total_tokens*/ 7000),
+        ]),
+    )
+    .await;
+    let summary_two = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("m2", "Status and plan finished. Answer now."),
+            ev_completed_with_tokens("r5", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let final_request = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("m3", "DONE"),
+            ev_completed_with_tokens("r6", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+
+    let long_status = format!(
+        "actual failure prefix:{}:actual failure suffix",
+        "diagnostic ".repeat(1600)
+    );
+    // Preparation validates/decode images before sending them; use an encoded PNG with valid CRCs
+    // rather than a placeholder that would legitimately become an image-preparation error string.
+    let mut png = std::io::Cursor::new(Vec::new());
+    image::DynamicImage::new_rgb8(/*w*/ 1, /*h*/ 1).write_to(&mut png, image::ImageFormat::Png)?;
+    let image_url = format!(
+        "data:image/png;base64,{}",
+        BASE64_STANDARD.encode(png.into_inner())
+    );
+    let mut dynamic_calls = Vec::new();
+    for (prompt, expected_id, output) in [
+        ("Previous task", "prior-status", "old status"),
+        (
+            "New task: status once, then update plan and report",
+            "current-status",
+            long_status.as_str(),
+        ),
+    ] {
+        test.codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: prompt.to_string(),
+                text_elements: vec![],
+            }]))
+            .await?;
+        loop {
+            match wait_for_event(&test.codex, |event| {
+                matches!(
+                    event,
+                    EventMsg::DynamicToolCallRequest(_)
+                        | EventMsg::Error(_)
+                        | EventMsg::TurnComplete(_)
+                )
+            })
+            .await
+            {
+                EventMsg::DynamicToolCallRequest(request) => {
+                    assert_eq!(request.call_id, expected_id);
+                    dynamic_calls.push(request.call_id.clone());
+                    let mut content_items = vec![DynamicToolCallOutputContentItem::InputText {
+                        text: output.to_string(),
+                    }];
+                    if expected_id == "current-status"
+                        && matches!(fixture, ReceiptFixture::MixedImages)
+                    {
+                        // Genuine supplied fixture images, never desktop observation or action.
+                        let image = DynamicToolCallOutputContentItem::InputImage {
+                            image_url: image_url.clone(),
+                        };
+                        content_items.push(image);
+                    }
+                    test.codex
+                        .submit(Op::DynamicToolResponse {
+                            id: request.call_id,
+                            response: DynamicToolResponse {
+                                native_browser_read: None,
+                                content_items,
+                                success: false,
+                            },
+                        })
+                        .await?;
+                }
+                EventMsg::Error(error) => panic!("unexpected turn failure: {error:?}"),
+                EventMsg::TurnComplete(_) => break,
+                _ => {}
+            }
+        }
+    }
+    assert_eq!(dynamic_calls, vec!["prior-status", "current-status"]);
+    for mock in [
+        &previous,
+        &previous_done,
+        &current,
+        &summary_one,
+        &continuation,
+        &summary_two,
+        &final_request,
+    ] {
+        assert_eq!(mock.requests().len(), 1);
+    }
+    let first_input = summary_one.single_request().input();
+    let call = first_input
+        .iter()
+        .find(|item| item["type"] == "function_call" && item["call_id"] == "current-status")
+        .expect("the genuine current status call")
+        .clone();
+    let mut output = summary_one
+        .single_request()
+        .function_call_output("current-status");
+    let mut payload: FunctionCallOutputPayload = serde_json::from_value(output["output"].clone())?;
+    let retained_image = match fixture {
+        ReceiptFixture::TextOnly => None,
+        ReceiptFixture::MixedImages => {
+            let items = payload
+                .content_items_mut()
+                .expect("structured mixed-image output");
+            assert_eq!(
+                items
+                    .iter()
+                    .filter(|item| matches!(item, FunctionCallOutputContentItem::InputImage { .. }))
+                    .count(),
+                1
+            );
+            let image = items
+                .iter()
+                .find(|item| matches!(item, FunctionCallOutputContentItem::InputImage { .. }))
+                .expect("the latest tool observation image is retained")
+                .clone();
+            items.retain(|item| matches!(item, FunctionCallOutputContentItem::InputText { .. }));
+            Some(image)
+        }
+    };
+    // The current observation receives the newest-output budget on the first compaction.
+    truncate_function_output_payload(&mut payload, TruncationPolicy::Bytes(3968), |_| 0);
+    let text = payload.body.to_text().expect("retained genuine tool text");
+    assert!(
+        text.contains("truncated")
+            && text.starts_with("actual failure prefix:")
+            && text.ends_with(":actual failure suffix")
+    );
+    assert!(text.len() <= 4096);
+    if let Some(image) = retained_image {
+        payload
+            .content_items_mut()
+            .expect("structured output after native truncation")
+            .push(image);
+    }
+    output["output"] = serde_json::to_value(payload)?;
+    let expected_first = vec![call.clone(), output.clone()];
+    assert_eq!(
+        tool_items(continuation.single_request().input()),
+        expected_first
+    );
+    let second_input = summary_two.single_request().input();
+    let plan_call = second_input
+        .iter()
+        .find(|item| item["type"] == "function_call" && item["call_id"] == "current-plan")
+        .expect("the genuine current planning call")
+        .clone();
+    let plan_output = summary_two
+        .single_request()
+        .function_call_output("current-plan");
+    assert_eq!(plan_output["output"], "Plan updated");
+    let final_receipts = tool_items(final_request.single_request().input());
+    match fixture {
+        ReceiptFixture::TextOnly => {
+            // Once the planning call completes, the prior observation uses the older-output
+            // budget. Derive its exact expected excerpt from the genuine first retained receipt.
+            let mut historical_payload: FunctionCallOutputPayload =
+                serde_json::from_value(output["output"].clone())?;
+            truncate_function_output_payload(
+                &mut historical_payload,
+                TruncationPolicy::Bytes(1920),
+                |_| 0,
+            );
+            assert!(
+                historical_payload
+                    .body
+                    .to_text()
+                    .expect("historical text remains")
+                    .len()
+                    <= 2048
+            );
+            output["output"] = serde_json::to_value(historical_payload)?;
+            assert_eq!(final_receipts, vec![call, output, plan_call, plan_output])
+        }
+        ReceiptFixture::MixedImages => {
+            assert_eq!(final_receipts.len(), 4);
+            assert_eq!(final_receipts[0], call);
+            assert_eq!(final_receipts[2..], [plan_call, plan_output]);
+            let final_output: FunctionCallOutputPayload =
+                serde_json::from_value(final_receipts[1]["output"].clone())?;
+            let text = final_output
+                .body
+                .to_text()
+                .expect("historical text remains");
+            assert!(text.contains("[omitted 1 historical image items during context compaction; obtain a fresh capture for image-dependent actions]"));
+            assert!(
+                text.contains("actual failure prefix:") && text.ends_with(":actual failure suffix")
+            );
+            assert!(text.len() <= 2048);
+            assert!(!serde_json::to_string(&final_receipts)?.contains("input_image"));
+        }
+    }
+    let original_reply = current
+        .single_request()
+        .input()
+        .into_iter()
+        // Native request construction intentionally strips unprefixed legacy IDs (e.g. "m0").
+        // Supply a valid ID and require that same genuine identity through both replacements.
+        .find(|item| item["role"] == "assistant" && item["id"] == "msg_previous")
+        .expect("the original completed prior assistant reply");
+    for request in [
+        continuation.single_request(),
+        final_request.single_request(),
+    ] {
+        let input = request.input();
+        let text_position = |text: &str| {
+            input
+                .iter()
+                .position(|item| {
+                    item["content"]
+                        .as_array()
+                        .is_some_and(|parts| parts.iter().any(|part| part["text"] == text))
+                })
+                .expect("the unchanged historical or current user message")
+        };
+        let matching_replies: Vec<_> = input
+            .iter()
+            .enumerate()
+            .filter(|(_, item)| **item == original_reply)
+            .collect();
+        assert_eq!(matching_replies.len(), 1);
+        let reply_position = matching_replies[0].0;
+        assert!(text_position("Previous task") < reply_position);
+        assert!(
+            reply_position < text_position("New task: status once, then update plan and report")
+        );
+    }
+    Ok(())
+}
+
+fn tool_items(input: Vec<Value>) -> Vec<Value> {
+    input
+        .into_iter()
+        .filter(|item| {
+            matches!(
+                item["type"].as_str(),
+                Some("function_call" | "function_call_output")
+            )
+        })
+        .collect()
+}
