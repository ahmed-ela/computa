+    stdout_tx.send(b"LATE".to_vec()).expect("late output");
+    wait_for_captured_output(&process, b"EARLY-LATE".len()).await;
+    let second_poll = UnifiedExecProcessManager::collect_output_until_deadline(
+        process.output_handles(),
+        /*pause_state*/ None,
