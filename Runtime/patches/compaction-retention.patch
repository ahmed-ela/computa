+}
+
+#[test]
+fn steering_and_ambiguous_same_turn_users_cannot_inherit_an_older_reply() {
+    let first = message("user", "old", "First request");
+    let reply = message("assistant", "old", "First answer");
+    for second in [message("user", "old", "Steered request"), first.clone()] {
+        let original = vec![first.clone(), reply.clone(), second.clone()];
+        let mut replacement = vec![first.clone(), second];
+        let expected = replacement.clone();
+        assert_eq!(
+            restore_prior_replies(&mut replacement, &original, "current"),
