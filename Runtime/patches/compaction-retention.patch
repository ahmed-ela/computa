+#[test]
+fn native_read_ledger_never_shadows_a_real_reply_or_becomes_a_summary() {
+    use codex_history::CodexHarnessMetadata;
+    use codex_history::native_browser_reads::{NativeCompletedRead, NativeCompletedReads};
+    use codex_protocol::dynamic_tools::NativeBrowserRead;
+    let user = message("user", "old", "Question");
+    let answer = message("assistant", "old", "Actual answer");
+    let run = NativeCompletedReads { version: 1, turn_id: "old".into(), output_token_limit: None, notice: true,
+        records: vec![NativeCompletedRead { ordinal: 0, kind: NativeBrowserRead::ReadV1, call_id: "old-read".into(),
+            call_item_id: None, output_item_id: None, arguments: "{}".into(), call_time: None, output_time: None,
+            call_metadata_present: false, success_present: true }] };
+    let mut ledger = message("assistant", "old", &run.display().unwrap());
+    ledger.metadata = Some(CodexHarnessMetadata { native_completed_reads: Some(run), ..Default::default() });
+    let original = vec![user.clone(), answer.clone(), ledger.clone()];
+    let mut replacement = vec![user.clone()];
+    assert_eq!(restore_prior_replies(&mut replacement, &original, "current"), 1);
+    assert_eq!(replacement, vec![user, answer.clone()]);
+    let last = without_native_read_records(&original).rev().find(|item| matches!(item, ResponseItem::Message { role, .. } if role == "assistant"));
+    assert_eq!(last, Some(&answer.item));
+    assert!(without_native_read_records(&[ledger]).next().is_none());
+}
