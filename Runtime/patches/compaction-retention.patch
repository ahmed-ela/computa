+        json!({"type":"input_image", "image_url":format!("data:image/png;base64,{}", "A".repeat(MAX_LATEST_IMAGE_BYTES))}),
+    ];
+    for value in image_values {
+        let mut history = pair("image", "current", "unused");
+        if let ResponseItem::FunctionCallOutput { output, .. } = &mut history[1].item {
