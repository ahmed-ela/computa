+fn complete_browser_pair(id: &str, page: &str) -> Vec<ResponseItemEnvelope> {
+    let mut history = pair(id, "current", "unused");
+    if let ResponseItem::FunctionCall { name, arguments, .. } = &mut history[0].item {
+        *name = "browser_read".to_string();
+        *arguments = r#"{"view":"links"}"#.to_string();
+    }
