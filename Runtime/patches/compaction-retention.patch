+}
+
+impl ToolOutput for NativeReadProofTestOutput {
+    fn log_output(&self) -> String { "unchanged observed result".to_string() }
+    fn success_for_logging(&self) -> bool { true }
+    fn fallback_token_limit_override(&self) -> Option<usize> { Some(123) }
+    fn native_browser_read(&self) -> Option<codex_protocol::dynamic_tools::NativeBrowserRead> { self.proof }
+    fn to_response_item(&self, call_id: &str, payload: &ToolPayload) -> ResponseInputItem {
+        crate::tools::context::FunctionToolOutput::from_text("unchanged observed result".to_string(), Some(true))
