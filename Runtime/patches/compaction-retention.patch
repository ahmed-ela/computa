+#[test]
+fn native_read_ledger_survives_history_id_assignment_and_repeated_serialized_compaction() {
+    use crate::compact_tool_receipts::{ReceiptProvider, current_turn_receipts};
+    use codex_history::{CodexHarnessMetadata, ResponseItemEnvelope};
+    use codex_protocol::dynamic_tools::NativeBrowserRead;
+    use codex_protocol::models::{ContentItem, FunctionCallOutputPayload};
+
+    let turn = "native-ledger-assigned-message-id";
+    let mut original = Vec::new();
+    for index in 0..8 {
+        let call_id = format!("read-{index}");
+        for value in [
+            serde_json::json!({"type":"function_call", "id":format!("fc_{index}"),
+                "call_id":call_id, "name":"browser_read", "arguments":"{\"view\":\"content\"}"}),
+            serde_json::json!({"type":"function_call_output", "id":format!("fco_{index}"),
+                "call_id":call_id, "output":"observed content ".repeat(160)}),
+        ] {
+            let mut item: ResponseItem = serde_json::from_value(value).unwrap();
+            item.set_turn_id_if_missing(turn);
+            let mut metadata = CodexHarnessMetadata::default();
+            if let ResponseItem::FunctionCallOutput {
+                output: FunctionCallOutputPayload { success, .. }, ..
+            } = &mut item {
+                *success = Some(true);
+                metadata.native_browser_read = Some(NativeBrowserRead::ReadV1);
+            }
+            original.push(ResponseItemEnvelope { item, metadata: Some(metadata) });
+        }
+    }
+    let mut compacted = current_turn_receipts(&original, turn, ReceiptProvider::External).unwrap();
+    let records = compacted.iter().filter_map(|item| item.metadata.as_ref()?.native_completed_reads.clone()).collect::<Vec<_>>();
+    assert!(!records.is_empty(), "fixture must exercise real native read packing");
+    assert_eq!(records.iter().map(|run| run.records.len()).sum::<usize>(), 7);
+    for (index, record) in records.iter().flat_map(|run| &run.records).enumerate() {
+        assert_eq!(record.call_id, format!("read-{index}"));
+        assert_eq!(record.call_item_id.as_ref().unwrap().as_str(), format!("fc_{index}"));
+        assert_eq!(record.output_item_id.as_ref().unwrap().as_str(), format!("fco_{index}"));
+        assert_eq!(record.arguments, "{\"view\":\"content\"}");
+    }
+    for _ in 0..2 {
+        // The actual history admission step must add no previously uncharged
+        // presentation bytes after the receipt bounds have already been checked.
+        let persisted_size = |history: &[ResponseItemEnvelope]| {
+            serde_json::to_vec(&history.iter().map(|e| &e.item).collect::<Vec<_>>()).unwrap().len()
+                + serde_json::to_vec(&history.iter().map(|e| &e.metadata).collect::<Vec<_>>()).unwrap().len()
+        };
+        let projected_size = |history: &[ResponseItemEnvelope]| {
+            let mut items = history.iter().map(|e| e.item.clone()).collect::<Vec<_>>();
+            crate::client::prepare_input_for_non_openai_provider(&mut items);
+            serde_json::to_vec(&items).unwrap().len()
+        };
+        let before_assignment = (persisted_size(&compacted), projected_size(&compacted));
+        for envelope in &mut compacted {
+            Session::assign_missing_response_item_id(&mut envelope.item);
+        }
+        assert_eq!((persisted_size(&compacted), projected_size(&compacted)), before_assignment,
+            "history ID assignment must add zero bytes after receipt admission");
+        assert!(persisted_size(&compacted) <= 24 * 1024);
+        assert!(projected_size(&compacted) <= 12 * 1024);
+        let ledger = compacted.iter().find(|item| item.metadata.as_ref().is_some_and(|m| m.native_completed_reads.is_some())).unwrap();
+        assert!(ledger.item.id().is_some_and(|id| id.starts_with("msg_")));
+        let (items, metadata): (Vec<_>, Vec<_>) = compacted.iter().map(|item| (item.item.clone(), item.metadata.clone())).unzip();
+        let items: Vec<ResponseItem> = serde_json::from_slice(&serde_json::to_vec(&items).unwrap()).unwrap();
+        let metadata: Vec<Option<CodexHarnessMetadata>> = serde_json::from_slice(&serde_json::to_vec(&metadata).unwrap()).unwrap();
+        let reloaded: Vec<_> = items.into_iter().zip(metadata).map(|(item, metadata)| ResponseItemEnvelope { item, metadata }).collect();
+        let before = serde_json::to_vec(&reloaded.iter().map(|item| &item.item).collect::<Vec<_>>()).unwrap();
+        let next = current_turn_receipts(&reloaded, turn, ReceiptProvider::External).unwrap();
+        assert_eq!(serde_json::to_vec(&reloaded.iter().map(|item| &item.item).collect::<Vec<_>>()).unwrap(), before, "validation must not rewrite saved item IDs");
+        assert_eq!(next.iter().filter_map(|item| item.metadata.as_ref()?.native_completed_reads.clone()).collect::<Vec<_>>(), records);
+        assert_eq!(&next[next.len()-2..], &reloaded[reloaded.len()-2..], "latest ordinary pair remains exact");
+        for variation in 0..7 {
+            let mut changed = reloaded.clone();
+            let item = changed.iter_mut().find(|item| item.metadata.as_ref().is_some_and(|m| m.native_completed_reads.is_some())).unwrap();
+            match variation {
+                0 => if let ResponseItem::Message { content, .. } = &mut item.item {
+                    let ContentItem::OutputText { text } = &mut content[0] else { unreachable!() };
+                    text.push_str(" fabricated observation");
+                },
+                1 => if let ResponseItem::Message { role, .. } = &mut item.item { *role = "user".into(); },
+                2 => item.metadata.as_mut().unwrap().client_authored = true,
+                3 => if let ResponseItem::Message { phase, .. } = &mut item.item {
+                    *phase = Some(serde_json::from_str("\"commentary\"").unwrap());
+                },
+                4 => if let ResponseItem::Message { internal_chat_message_metadata_passthrough: Some(metadata), .. } = &mut item.item {
+                    metadata.turn_id = Some("foreign-turn".into());
+                },
+                5 => if let ResponseItem::Message { internal_chat_message_metadata_passthrough: Some(metadata), .. } = &mut item.item {
+                    metadata.create_time = Some(serde_json::Number::from(1));
+                },
+                _ => if let ResponseItem::Message { content, .. } = &mut item.item {
+                    let ContentItem::OutputText { text } = &content[0] else { unreachable!() };
+                    content[0] = ContentItem::InputText { text: text.clone() };
+                },
+            }
+            assert!(current_turn_receipts(&changed, turn, ReceiptProvider::External).is_err(), "only the enclosing ID may differ: variation {variation}");
+        }
+        compacted = next;
+    }
+}
