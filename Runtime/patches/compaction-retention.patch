index 0000000..99cf802
--- /dev/null
+++ b/codex-rs/core/src/unified_exec/execution_completion.rs
@@ -0,0 +1,109 @@
+use std::sync::Arc;
+use std::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ExecutionOutcome {
+    ProcessExit,
+    UserCancelled,
+}
+
+#[derive(Debug)]
+enum CompletionState {
+    Pending,
+    UserCancelled,
+    Completing,
+    Completed,
+}
+
+#[derive(Debug)]
+struct SharedCompletion {
+    state: Mutex<CompletionState>,
+    cancellation: CancellationToken,
+    completed: CancellationToken,
+    owner_ready: CancellationToken,
+}
+
+/// Coordinates an intercepted approval with its owning command's sole completion.
+/// Cancellation wakes the emitter independently of process exit or turn cleanup.
+#[derive(Clone, Debug)]
+pub(crate) struct ExecutionCompletion(Arc<SharedCompletion>);
+
+pub(crate) struct CompletionGuard(ExecutionCompletion);
+
+impl Drop for CompletionGuard {
+    fn drop(&mut self) {
+        self.0.finish();
+    }
+}
+
+impl PartialEq for ExecutionCompletion {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+}
+
+impl Default for ExecutionCompletion {
+    fn default() -> Self {
+        Self(Arc::new(SharedCompletion {
+            state: Mutex::new(CompletionState::Pending),
+            cancellation: CancellationToken::new(),
+            completed: CancellationToken::new(),
+            owner_ready: CancellationToken::new(),
+        }))
+    }
+}
+
+impl ExecutionCompletion {
+    pub(crate) fn owner_ready(&self) {
+        self.0.owner_ready.cancel();
+    }
+
+    pub(crate) async fn wait_for_owner(&self) -> bool {
+        tokio::select! {
+            biased;
+            _ = self.0.completed.cancelled() => false,
+            _ = self.0.owner_ready.cancelled() => true,
+        }
+    }
+
+    pub(crate) fn cancel(&self) {
+        let mut state = self.0.state.lock().expect("execution completion state");
+        if matches!(*state, CompletionState::Pending) {
+            *state = CompletionState::UserCancelled;
+            self.0.cancellation.cancel();
+        }
+    }
+
+    pub(crate) async fn cancelled(&self) {
+        self.0.cancellation.cancelled().await;
+    }
+
+    pub(crate) async fn completed(&self) {
+        self.0.completed.cancelled().await;
+    }
+
+    pub(crate) fn finish_on_drop(&self) -> CompletionGuard {
+        CompletionGuard(self.clone())
+    }
+
+    pub(crate) fn claim(&self) -> Option<ExecutionOutcome> {
+        let mut state = self.0.state.lock().expect("execution completion state");
+        let outcome = match *state {
+            CompletionState::Pending => ExecutionOutcome::ProcessExit,
+            CompletionState::UserCancelled => ExecutionOutcome::UserCancelled,
+            CompletionState::Completing | CompletionState::Completed => return None,
+        };
+        *state = CompletionState::Completing;
+        Some(outcome)
+    }
+
+    pub(crate) fn finish(&self) {
+        *self.0.state.lock().expect("execution completion state") = CompletionState::Completed;
+        self.0.completed.cancel();
+    }
+}
+
+#[cfg(test)]
+#[path = "execution_completion_tests.rs"]
+mod tests;
diff --git a/codex-rs/core/src/unified_exec/execution_completion_tests.rs b/codex-rs/core/src/unified_exec/execution_completion_tests.rs
