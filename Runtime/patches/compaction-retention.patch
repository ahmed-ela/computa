+fn packed_native_reads(history: &[ResponseItemEnvelope], turn: &str, protected: &[usize]) -> Vec<ResponseItemEnvelope> {
+    let indexed: Vec<_> = history.iter().cloned().enumerate().collect();
+    native_read_ledger::pack(&indexed, history, turn, protected, &HashSet::new(), &HashSet::new(), &HashMap::new()).unwrap().into_iter().map(|(_, item)| item).collect()
+}
