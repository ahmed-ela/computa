+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    assert_eq!(
+        dispatched,
+        (0..pair_count)
+            .map(|index| format!("call_{index:016}"))
+            .collect::<Vec<_>>()
