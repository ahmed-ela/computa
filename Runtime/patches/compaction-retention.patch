+#[test]
+fn external_provider_retains_twenty_realistic_pairs_without_charging_unsent_metadata() {
+    let original =
+        realistic_mixed_receipts(20, &format!("observed:{}:end", "diagnostic ".repeat(220)));
+    assert!(current_turn_receipts(&original, REALISTIC_TURN).is_err());
+    let retained =
+        super::current_turn_receipts(&original, REALISTIC_TURN, ReceiptProvider::External).unwrap();
+    assert_receipt_identity(&original, &retained);
+    assert_external_receipt_bounds(&retained);
+    assert_eq!(
+        super::current_turn_receipts(&retained, REALISTIC_TURN, ReceiptProvider::External).unwrap(),
+        retained
+    );
+    assert_eq!(
+        super::current_turn_receipts(&retained, "next-turn", ReceiptProvider::External).unwrap(),
+        vec![]
+    );
+    let ResponseItem::FunctionCallOutput { output, .. } = &retained.last().unwrap().item else {
+        unreachable!()
+    };
+    assert!(
+        output
+            .content_items()
+            .unwrap()
+            .contains(&observation_image())
+    );
+}
