+// Subscribe to the producer notification before checking the retained count.
+// This observes actual producer progress without sleeping or feeding the buffer.
+async fn wait_for_captured_output(process: &UnifiedExecProcess, expected_bytes: usize) {
+    tokio::time::timeout(Duration::from_secs(5), async {
+        let transcript = process.output_transcript();
+        loop {
+            let changed = process.output_handles().output_notify.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            let captured = transcript.lock().await.total_bytes() >= expected_bytes;
+            let published = process
+                .output_handles()
+                .output_buffer
+                .lock()
+                .await
+                .total_bytes()
+                > 0;
+            if captured && published {
+                return;
+            }
+            changed.await;
+        }
+    })
+    .await
+    .expect("producer captured output");
+}
+
+async fn wait_for_output_closed(process: &UnifiedExecProcess) {
+    tokio::time::timeout(Duration::from_secs(5), async {
+        let output = process.output_handles();
+        let closed = output.output_closed_notify.notified();
+        tokio::pin!(closed);
+        closed.as_mut().enable();
+        if !output.output_closed.load(Ordering::Acquire) {
+            closed.await;
+        }
+        assert!(output.output_closed.load(Ordering::Acquire));
+    })
+    .await
+    .expect("producer closed output");
+}
+
