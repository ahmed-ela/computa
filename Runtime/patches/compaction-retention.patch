+    };
+    let page = FunctionCallOutputContentItem::InputText { text: "observed page".to_string() };
+    for body in [
+        FunctionCallOutputBody::Text(COMPLETE_BROWSER_OBSERVATION_MARKER.to_string()),
+        FunctionCallOutputBody::ContentItems(vec![marker.clone()]),
+        FunctionCallOutputBody::ContentItems(vec![marker.clone(), page.clone(), page.clone()]),
+        FunctionCallOutputBody::ContentItems(vec![marker.clone(), observation_image()]),
+        FunctionCallOutputBody::ContentItems(vec![marker.clone(), FunctionCallOutputContentItem::InputText {
+            text: " \n\t".to_string(),
+        }]),
+    ] {
+        let mut history = complete_browser_pair("invalid", "page");
+        if let ResponseItem::FunctionCallOutput { output, .. } = &mut history[1].item {
+            output.body = body;
+        }
+        assert!(current_turn_receipts(&history, "current").unwrap_err().to_string()
+            .contains("invalid result shape or failure status"));
+    }
+    let mut failed = complete_browser_pair("failed", "page");
+    if let ResponseItem::FunctionCallOutput { output, .. } = &mut failed[1].item {
+        output.success = Some(false);
+    }
+    assert!(current_turn_receipts(&failed, "current").unwrap_err().to_string()
+        .contains("failure status"));
+    // Native names alone, page prefixes, and foreign namespaces never opt in.
+    for foreign in [false, true] {
+        let mut ordinary = complete_browser_pair("ordinary", &"long output ".repeat(1_000));
+        if let ResponseItem::FunctionCall { name, namespace, .. } = &mut ordinary[0].item {
+            if foreign { *namespace = Some("mcp_custom".to_string()); }
+            else { *name = "generic_read".to_string(); }
+        }
+        let retained = current_turn_receipts(&ordinary, "current").unwrap();
+        assert_receipt_identity(&ordinary, &retained);
