+use super::*;
+use codex_protocol::models::ContentItemKind;
+use codex_protocol::models::InternalChatMessageMetadataPassthrough;
+use serde_json::Value;
+use serde_json::json;
+
+const THREAD: &str = "11111111-1111-4111-8111-111111111111";
+const TURN: &str = "22222222-2222-4222-8222-222222222222";
+const OTHER: &str = "33333333-3333-4333-8333-333333333333";
+
+fn message(role: &str, turn: Option<&str>, parts: &[(&str, &str)]) -> ResponseItem {
+    ResponseItem::Message {
+        id: None,
+        role: role.to_string(),
+        content: parts
+            .iter()
+            .map(|(_, text)| ContentItem::InputText {
+                text: (*text).to_string(),
+            })
+            .collect(),
+        phase: None,
+        internal_chat_message_metadata_passthrough: Some(InternalChatMessageMetadataPassthrough {
+            turn_id: turn.map(str::to_string),
+            content_item_kinds: Some(
+                parts
+                    .iter()
+                    .map(|(kind, _)| ContentItemKind((*kind).to_string()))
+                    .collect(),
+            ),
+            ..Default::default()
+        }),
+    }
+}
+
+fn human(text: &str) -> ResponseItem {
+    message("user", Some(TURN), &[("user.text", text)])
+}
+
+fn parsed(input: &[ResponseItem]) -> Value {
+    serde_json::from_str(&proof(input, THREAD, TURN).expect("native proof")).unwrap()
+}
+
+#[test]
+fn proof_matches_independent_utf8_framing_vector_and_precise_positions() {
+    let input = vec![
+        message("user", Some(TURN), &[("environments.environment_context", "environment")]),
+        human("  e\u{301} 🧭\n\0\"quoted\"  "),
+        serde_json::from_value(json!({"type":"function_call","call_id":"call-1","name":"browser_read","arguments":"{}"})).unwrap(),
+        serde_json::from_value(json!({"type":"function_call_output","call_id":"call-1","output":"observed page"})).unwrap(),
+        human("Keep it read-only.\nNo sending."),
+    ];
+    let before = serde_json::to_vec(&input).unwrap();
+    let value = parsed(&input);
+    assert_eq!(
+        value,
+        json!({"indices":[1,4], "sha256":"1f83b894cedf6049f768ada9c879c83686569d5d33e296dd7f437be3032b06f8"})
+    );
+    assert_eq!(serde_json::to_vec(&input).unwrap(), before);
+    let mut moved = input.clone();
+    moved.insert(
+        0,
+        message("assistant", Some(TURN), &[("assistant.text", "context")]),
+    );
+    assert_ne!(parsed(&moved)["sha256"], value["sha256"]);
+    assert_ne!(proof(&input, OTHER, TURN), proof(&input, THREAD, TURN));
+}
+
+#[test]
+fn proof_requires_native_current_user_text_and_rejects_mixed_messages() {
+    let mut input = vec![
+        message("user", Some(OTHER), &[("user.text", "same")]),
+        message("user", None, &[("user.text", "same")]),
+        message("assistant", Some(TURN), &[("user.text", "same")]),
+        message("user", Some(TURN), &[("compaction.summary", "same")]),
+        human("same"),
+    ];
+    assert_eq!(parsed(&input)["indices"], json!([4]));
+    input.pop();
+    assert!(proof(&input, THREAD, TURN).is_none());
+    for parts in [
+        vec![("user.text", "same"), ("user.text", "steer")],
+        vec![
+            ("user.text", "same"),
+            ("environments.environment_context", "environment"),
+        ],
+    ] {
+        input.push(message("user", Some(TURN), &parts));
+        assert!(proof(&input, THREAD, TURN).is_none());
+        input.pop();
+    }
+    let mut missing_kind = human("same");
+    if let ResponseItem::Message {
+        internal_chat_message_metadata_passthrough: Some(native),
+        ..
+    } = &mut missing_kind
+    {
+        native.content_item_kinds = None;
+    }
+    input.extend([human("valid"), missing_kind]);
+    assert!(proof(&input, THREAD, TURN).is_none());
+}
