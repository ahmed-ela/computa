+fn later_compaction_can_reduce_excerpts_without_erasing_prior_image_omission() {
+    let text = format!("actual prefix:{}:actual suffix", "診断".repeat(3000));
+    let mut history = image_pair("old-image", &text);
+    history.extend(pair("later", "current", "ok"));
+    let first = current_turn_receipts(&history, "current").unwrap();
+    let ResponseItem::FunctionCallOutput { output, .. } = &first[1].item else {
+        unreachable!()
+    };
+    let original_marker = output.content_items().unwrap()[0].clone();
+    let original_size = output_text_bytes(&output.body);
+    let mut extended = first;
+    for index in 0..14 {
+        extended.extend(pair(&format!("new-{index}"), "current", &text));
+    }
+    let reduced = current_turn_receipts(&extended, "current").unwrap();
+    assert_receipt_identity(&extended, &reduced);
+    assert_receipt_bounds(&reduced);
+    let ResponseItem::FunctionCallOutput { output, .. } = &reduced[1].item else {
+        unreachable!()
+    };
+    assert!(output_text_bytes(&output.body) < original_size);
+    assert_eq!(output.content_items().unwrap()[0], original_marker);
+    assert_eq!(current_turn_receipts(&reduced, "current").unwrap(), reduced);
+    assert_eq!(
+        current_turn_receipts(&reduced, "next-turn").unwrap(),
+        vec![]
