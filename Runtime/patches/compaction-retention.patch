+#[test]
+fn malformed_marked_browser_inputs_never_gain_complete_observation_retention() {
+    for kind in ["click", "fill"] {
+        for variant in ["failure", "missing_cue", "extra_item", "wrong_kind", "cue_extra_field",
+                        "cue_too_large", "label_type", "partial_type", "not_dispatched", "verified_cue",
+                        "invalid_json", "body_wrong_kind", "body_not_dispatched", "replay", "verified_result", "unavailable", "empty_page"] {
+            let mut history = complete_browser_action_pair("invalid", kind, "actual post-input page");
+            let ResponseItem::FunctionCallOutput { output, .. } = &mut history[1].item else { unreachable!() };
+            if variant == "failure" { output.success = Some(false); }
+            let FunctionCallOutputBody::ContentItems(items) = &mut output.body else { unreachable!() };
+            if variant == "missing_cue" { items.remove(1); }
+            else if variant == "extra_item" { items.push(observation_image()); }
+            else {
+                let FunctionCallOutputContentItem::InputText { text: cue_text } = &mut items[1] else { unreachable!() };
+                let mut cue: serde_json::Value = serde_json::from_str(cue_text).unwrap();
+                match variant {
+                    "wrong_kind" => cue["kind"] = json!(if kind == "click" { "fill" } else { "click" }),
+                    "cue_extra_field" => cue["extra"] = json!(true),
+                    "cue_too_large" => cue["label"] = json!("x".repeat(129)),
+                    "label_type" => cue["label"] = json!(null),
+                    "partial_type" => cue["partial"] = json!("false"),
+                    "not_dispatched" => cue["dispatched"] = json!(false),
+                    "verified_cue" => cue["outcome"] = json!("verified"),
+                    _ => {},
+                }
+                *cue_text = cue.to_string();
+                let FunctionCallOutputContentItem::InputText { text: body_text } = &mut items[2] else { unreachable!() };
+                let mut body: serde_json::Value = serde_json::from_str(body_text).unwrap();
+                match variant {
+                    "body_wrong_kind" => body["input_kind"] = json!(if kind == "click" { "fill" } else { "click" }),
+                    "body_not_dispatched" => body["dispatched"] = json!(false),
+                    "replay" => body["no_replay"] = json!(false),
+                    "verified_result" => body["result_verified"] = json!(true),
+                    "unavailable" => body["current_observation"]["status"] = json!("unavailable"),
+                    "empty_page" => body["current_observation"]["text"] = json!(" \n\t"),
+                    _ => {},
+                }
+                *body_text = if variant == "invalid_json" { "{broken".to_string() } else { body.to_string() };
+            }
+            assert!(current_turn_receipts(&history, "current").unwrap_err().to_string()
+                .contains("invalid result shape or failure status"), "{kind} {variant}");
+        }
+        for foreign in [false, true] {
+            let mut ordinary = complete_browser_action_pair("foreign", kind, &"large page ".repeat(800));
+            if let ResponseItem::FunctionCall { name, namespace, .. } = &mut ordinary[0].item {
+                if foreign { *namespace = Some("mcp_custom".to_string()); }
+                else { *name = "custom_action".to_string(); }
+            }
+            let retained = current_turn_receipts(&ordinary, "current").unwrap();
+            assert_receipt_identity(&ordinary, &retained);
+            assert_ne!(retained[1].item, ordinary[1].item);
+        }
+    }
+}
