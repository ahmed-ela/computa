+fn assert_receipt_identity(original: &[ResponseItemEnvelope], retained: &[ResponseItemEnvelope]) {
+    let mut expected = original.to_vec();
+    assert_eq!(expected.len(), retained.len());
+    for (expected, actual) in expected.iter_mut().zip(retained) {
+        if let (
+            ResponseItem::FunctionCallOutput {
+                output: expected_output,
+                ..
+            },
+            ResponseItem::FunctionCallOutput {
+                output: actual_output,
+                ..
+            },
+        ) = (&mut expected.item, &actual.item)
+        {
+            expected_output.body = actual_output.body.clone();
+        }
+    }
+    assert_eq!(retained, expected);
