+//! Native-only historical read records. Rehydration is for receipt validation,
+//! never execution or provider tool replies. Model prose is generated from the
+//! typed records and is never parsed to recover provenance.
+
+use super::receipt_error;
+use codex_history::native_browser_reads::{
+    NATIVE_READ_OMISSION, NativeCompletedRead, NativeCompletedReads,
+};
+use codex_history::{CodexHarnessMetadata, ResponseItemEnvelope};
+use codex_protocol::ResponseItemId;
+use codex_protocol::error::Result;
+use codex_protocol::models::{
+    ContentItem, FunctionCallOutputBody, FunctionCallOutputPayload,
+    InternalChatMessageMetadataPassthrough, ResponseItem,
+};
+use std::collections::{HashMap, HashSet};
+
+pub(super) struct ExpandedHistory {
+    pub items: Vec<ResponseItemEnvelope>,
+    pub previously_omitted: HashSet<String>,
+    pub prior_run_starts: HashSet<String>,
+    pub prior_run_ids: HashMap<String, ResponseItemId>,
+}
+
+fn passthrough(
+    turn: &str,
+    time: Option<serde_json::Number>,
+) -> InternalChatMessageMetadataPassthrough {
+    InternalChatMessageMetadataPassthrough {
+        turn_id: Some(turn.to_string()),
+        create_time: time,
+        ..Default::default()
+    }
+}
+
+fn output_metadata(
+    run: &NativeCompletedReads,
+    record: &NativeCompletedRead,
+) -> CodexHarnessMetadata {
+    CodexHarnessMetadata {
+        history_truncation_token_limit: run.output_token_limit,
+        native_browser_read: Some(record.kind),
+        ..Default::default()
+    }
+}
+
+/// Only the trusted local envelope carries this record. Public/imported Responses
+/// items have no such envelope metadata and therefore cannot manufacture a ledger.
+pub(super) fn expand(history: &[ResponseItemEnvelope], turn: &str) -> Result<ExpandedHistory> {
+    let mut expanded = ExpandedHistory {
+        items: Vec::new(),
+        previously_omitted: HashSet::new(),
+        prior_run_starts: HashSet::new(),
+        prior_run_ids: HashMap::new(),
+    };
+    let mut ordinal = 0usize;
+    let mut saw_notice = false;
+    for envelope in history {
+        let ledger = envelope
+            .metadata
+            .as_ref()
+            .and_then(|metadata| metadata.native_completed_reads.as_ref());
+        if let Some(run) = ledger {
+            if run.turn_id != turn && envelope.turn_id() != Some(turn) {
+                expanded.items.push(envelope.clone());
+                continue;
+            }
+            run.validate().map_err(receipt_error)?;
+            let expected_metadata = CodexHarnessMetadata {
+                native_completed_reads: Some(run.clone()),
+                ..Default::default()
+            };
+            let expected_item = ResponseItem::Message {
+                // Session assigns the enclosing presentation ID when saving a
+                // replacement. Original call/output IDs remain in typed records.
+                id: envelope.item.id().cloned(),
+                role: "assistant".into(),
+                phase: None,
+                content: vec![ContentItem::OutputText {
+                    text: run.display().map_err(receipt_error)?,
+                }],
+                internal_chat_message_metadata_passthrough: Some(passthrough(turn, None)),
+            };
+            if run.turn_id != turn
+                || envelope.metadata.as_ref() != Some(&expected_metadata)
+                || envelope.item != expected_item
+                || run.notice == saw_notice
+            {
+                return Err(receipt_error(
+                    "native read ledger provenance or display is inconsistent",
+                ));
+            }
+            saw_notice = true;
+            expanded
+                .prior_run_starts
+                .insert(run.records[0].call_id.clone());
+            if let Some(id) = envelope.item.id().filter(|id| !id.is_empty()) {
+                expanded
+                    .prior_run_ids
+                    .insert(run.records[0].call_id.clone(), id.clone());
+            }
+            for record in &run.records {
+                if usize::from(record.ordinal) != ordinal
+                    || !expanded.previously_omitted.insert(record.call_id.clone())
+                {
+                    return Err(receipt_error(
+                        "native read ledger call order or identity is inconsistent",
+                    ));
+                }
+                expanded.items.push(ResponseItemEnvelope {
+                    item: ResponseItem::FunctionCall {
+                        id: record.call_item_id.clone(),
+                        name: record.tool_name().into(),
+                        namespace: None,
+                        arguments: record.arguments.clone(),
+                        encrypted_function_args: None,
+                        call_id: record.call_id.clone(),
+                        internal_chat_message_metadata_passthrough: Some(passthrough(
+                            turn,
+                            record.call_time.clone(),
+                        )),
+                    },
+                    metadata: record
+                        .call_metadata_present
+                        .then(CodexHarnessMetadata::default),
+                });
+                expanded.items.push(ResponseItemEnvelope {
+                    item: ResponseItem::FunctionCallOutput {
+                        id: record.output_item_id.clone(),
+                        call_id: Some(record.call_id.clone()),
+                        name: None,
+                        namespace: None,
+                        output: FunctionCallOutputPayload {
+                            body: FunctionCallOutputBody::Text(NATIVE_READ_OMISSION.into()),
+                            success: record.success_present.then_some(true),
+                        },
+                        internal_chat_message_metadata_passthrough: Some(passthrough(
+                            turn,
+                            record.output_time.clone(),
+                        )),
+                    },
+                    metadata: Some(output_metadata(run, record)),
+                });
+                ordinal += 1;
+            }
+        } else {
+            if envelope.turn_id() == Some(turn)
+                && matches!(envelope.item, ResponseItem::FunctionCall { .. })
+            {
+                ordinal += 1;
+            }
+            expanded.items.push(envelope.clone());
+        }
+    }
+    Ok(expanded)
+}
+
+/// Unrecognized metadata combinations retain ordinary pairs, never a partial record.
+/// The output's ingest-time native proof is mandatory; a tool name or page marker
+/// on its own is insufficient. The parser below extracts only genuine call args.
+fn record(
+    call: &ResponseItemEnvelope,
+    output: &ResponseItemEnvelope,
+    turn: &str,
+    ordinal: usize,
+) -> Option<(NativeCompletedRead, Option<usize>)> {
+    let metadata = output.metadata.as_ref()?;
+    let kind = metadata.native_browser_read?;
+    let token_limit = metadata.history_truncation_token_limit;
+    if metadata
+        != &(CodexHarnessMetadata {
+            native_browser_read: Some(kind),
+            history_truncation_token_limit: token_limit,
+            ..Default::default()
+        })
+        || call
+            .metadata
+            .as_ref()
+            .is_some_and(|value| value != &CodexHarnessMetadata::default())
+    {
+        return None;
+    }
+    let ResponseItem::FunctionCall {
+        id: call_item_id,
+        name,
+        namespace: None,
+        arguments,
+        encrypted_function_args: None,
+        call_id,
+        internal_chat_message_metadata_passthrough: Some(call_metadata),
+    } = &call.item
+    else {
+        return None;
+    };
+    let ResponseItem::FunctionCallOutput {
+        id: output_item_id,
+        call_id: Some(output_call_id),
+        name: None,
+        namespace: None,
+        output,
+        internal_chat_message_metadata_passthrough: Some(result_metadata),
+    } = &output.item
+    else {
+        return None;
+    };
+    if call_id != output_call_id
+        || output.success == Some(false)
+        || call_metadata != &passthrough(turn, call_metadata.create_time.clone())
+        || result_metadata != &passthrough(turn, result_metadata.create_time.clone())
+    {
+        return None;
+    }
+    let record = NativeCompletedRead {
+        ordinal: u8::try_from(ordinal).ok()?,
+        kind,
+        call_id: call_id.clone(),
+        call_item_id: call_item_id.clone(),
+        output_item_id: output_item_id.clone(),
+        arguments: arguments.clone(),
+        call_time: call_metadata.create_time.clone(),
+        output_time: result_metadata.create_time.clone(),
+        call_metadata_present: call.metadata.is_some(),
+        success_present: output.success.is_some(),
+    };
+    if name != record.tool_name() {
+        return None;
+    }
+    let run = NativeCompletedReads {
+        version: 1,
+        turn_id: turn.into(),
+        output_token_limit: token_limit,
+        notice: true,
+        records: vec![record.clone()],
+    };
+    run.validate().ok()?;
+    Some((record, token_limit))
+}
+
+// Receipt projection already omits reasoning. Only that exact typed gap may
+// join serial read pairs; messages or unknown/foreign items remain boundaries.
+fn only_reasoning_between(
+    source: &[ResponseItemEnvelope],
+    previous_output: usize,
+    next_call: usize,
+    turn: &str,
+) -> bool {
+    if source.get(previous_output).is_none() || source.get(next_call).is_none() {
+        return false;
+    }
+    let Some(start) = previous_output.checked_add(1) else {
+        return false;
+    };
+    let Some(gap) = source.get(start..next_call) else {
+        return false;
+    };
+    gap.iter().all(|item| {
+        matches!(item.item, ResponseItem::Reasoning { .. })
+            && item.turn_id() == Some(turn)
+            && item
+                .metadata
+                .as_ref()
+                .is_none_or(|metadata| metadata == &CodexHarnessMetadata::default())
+    })
+}
+
+/// Replaces only serial runs of proven reads separated by omitted reasoning. Mutations, failures,
+/// parallel interleavings, and protected latest observations retain exact pairs.
+pub(super) fn pack(
+    retained: &[(usize, ResponseItemEnvelope)],
+    source: &[ResponseItemEnvelope],
+    turn: &str,
+    protected_outputs: &[usize],
+    previously_omitted: &HashSet<String>,
+    prior_run_starts: &HashSet<String>,
+    prior_run_ids: &HashMap<String, ResponseItemId>,
+) -> Result<Vec<(usize, ResponseItemEnvelope)>> {
+    let mut ordinals = HashMap::new();
+    for (_, envelope) in retained {
+        if let ResponseItem::FunctionCall { call_id, .. } = &envelope.item {
+            let ordinal = ordinals.len();
+            ordinals.insert(call_id.as_str(), ordinal);
+        }
+    }
+    let mut result = Vec::new();
+    let mut index = 0;
+    let mut notice = true;
+    let mut packed_prior = HashSet::new();
+    while index < retained.len() {
+        let start = index;
+        let mut run: Option<NativeCompletedReads> = None;
+        let mut last_source = None;
+        while index + 1 < retained.len() {
+            let (call_index, call) = &retained[index];
+            let (output_index, output) = &retained[index + 1];
+            let ResponseItem::FunctionCall { call_id, .. } = &call.item else {
+                break;
+            };
+            // Source-gap items disappear from receipt-only replacement history.
+            // Persisted run starts preserve those boundaries on later compactions.
+            if run.is_some() && prior_run_starts.contains(call_id) {
+                break;
+            }
+            if *output_index != *call_index + 1
+                || protected_outputs.contains(output_index)
+                || last_source
+                    .is_some_and(|last| !only_reasoning_between(source, last, *call_index, turn))
+            {
+                break;
+            }
+            let Some((record, token_limit)) =
+                record(call, output, turn, ordinals[call_id.as_str()])
+            else {
+                break;
+            };
+            let current = run.get_or_insert_with(|| NativeCompletedReads {
+                version: 1,
+                turn_id: turn.into(),
+                output_token_limit: token_limit,
+                notice,
+                records: Vec::new(),
+            });
+            if current.output_token_limit != token_limit {
+                break;
+            }
+            if previously_omitted.contains(call_id) {
+                packed_prior.insert(call_id.clone());
+            }
+            current.records.push(record);
+            last_source = Some(*output_index);
+            index += 2;
+        }
+        if let Some(run) = run {
+            let text = run.display().map_err(receipt_error)?;
+            // Charge the actual presentation ID before sizing. History admission
+            // then leaves it unchanged; repeated compaction reuses its prior ID.
+            let id = prior_run_ids
+                .get(&run.records[0].call_id)
+                .cloned()
+                .unwrap_or_else(|| ResponseItemId::new("msg"));
+            result.push((
+                retained[start].0,
+                ResponseItemEnvelope {
+                    item: ResponseItem::Message {
+                        id: Some(id),
+                        role: "assistant".into(),
+                        phase: None,
+                        content: vec![ContentItem::OutputText { text }],
+                        internal_chat_message_metadata_passthrough: Some(passthrough(turn, None)),
+                    },
+                    metadata: Some(CodexHarnessMetadata {
+                        native_completed_reads: Some(run),
+                        ..Default::default()
+                    }),
+                },
+            ));
+            notice = false;
+        } else {
+            result.push(retained[index].clone());
+            index += 1;
+        }
+    }
+    if packed_prior != *previously_omitted {
+        return Err(receipt_error(
+            "native read ledger could not preserve its original receipt set",
+        ));
+    }
+    Ok(result)
+}
diff --git a/codex-rs/core/src/compact_tool_receipts.rs b/codex-rs/core/src/compact_tool_receipts.rs
new file mode 100644
index 0000000..d94e9d9
--- /dev/null
+++ b/codex-rs/core/src/compact_tool_receipts.rs
@@ -0,0 +1,815 @@
+//! Bounded, genuine current-turn receipts for local mid-turn compaction.
+//!
+//! Mutations and failures remain paired tool history. Older proven native reads may become
+//! typed historical data with omitted page detail, never instructions, authorization, or a
+//! replay queue. Capture before sampling and commit with replacement history before inference.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+
+#[path = "compact_native_read_ledger.rs"]
+mod native_read_ledger;
+
+use crate::client::prepare_input_for_non_openai_provider;
+use base64::Engine;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ImageReference;
+use codex_protocol::models::ResponseItem;
+use codex_utils_output_truncation::TruncationPolicy;
+use codex_utils_output_truncation::truncate_function_output_payload;
+
+const MAX_PAIRS: usize = 32;
+const MAX_OUTPUT_TEXT_BYTES: usize = 2048;
+const MAX_OUTPUT_BYTES: usize = 3072;
+const MAX_LATEST_OUTPUT_TEXT_BYTES: usize = 4096;
+const MAX_LATEST_OUTPUT_BYTES: usize = 6144;
+const MAX_RECEIPT_BYTES: usize = 12 * 1024;
+// Local-only identities and timestamps do not consume the external provider's prompt budget,
+// but they still need a separate hard bound in the canonical replacement history.
+const MAX_CANONICAL_RECEIPT_BYTES: usize = 24 * 1024;
+const MAX_LATEST_IMAGE_BYTES: usize = 2 * 1024 * 1024;
+// The native browser producer pages before issuing this closed marker. It is
+// retention metadata, never observation, authorization, or a capability. Matching
+// it can only prevent lossy continuation; target validation stays with the host.
+const COMPLETE_BROWSER_OBSERVATION_MARKER: &str =
+    r#"{"retention":"complete_browser_observation_v1"}"#;
+const HISTORICAL_BROWSER_OBSERVATION_MARKER: &str =
+    r#"{"retention":"browser_observation_excerpt_v1"}"#;
+const HISTORICAL_BROWSER_ROW_DEFAULTS: &str = "ROW_DEFAULTS enabled=true settable=false actions=[]";
+const HISTORICAL_BROWSER_NOTICE: &str =
+    "Historical excerpt; incomplete, no pagination. Revalidate refs.";
+
+struct BrowserObservationRetention {
+    complete: bool,
+    cue: Option<String>,
+    lines: Vec<String>,
+}
+// Every result keeps a genuine excerpt rather than dropping older actions. Give the latest
+// completed observation more room before shrinking it: a uniform cap can erase the newest
+// observation's header/identity while retaining stale identifiers from older observations.
+// Text/header budgets include JSON escaping and array separators. The latest image payload is
+// separately bounded and counted by the final candidate-history context estimator.
+const OUTPUT_TEXT_CAPS: [usize; 7] = [MAX_OUTPUT_TEXT_BYTES, 1536, 1024, 768, 512, 384, 256];
+const LATEST_OUTPUT_TEXT_CAPS: [usize; 9] = [
+    MAX_LATEST_OUTPUT_TEXT_BYTES,
+    3072,
+    MAX_OUTPUT_TEXT_BYTES,
+    1536,
+    1024,
+    768,
+    512,
+    384,
+    256,
+];
+
+#[derive(Clone, Copy)]
+pub(super) enum ReceiptProvider {
+    OpenAI,
+    External,
+}
+
+pub(super) fn current_turn_receipts(
+    history: &[ResponseItemEnvelope],
+    turn_id: &str,
+    provider: ReceiptProvider,
+) -> Result<Vec<ResponseItemEnvelope>> {
+    if turn_id.is_empty() {
+        return Err(receipt_error("current turn identity is unavailable"));
+    }
+    let expanded = native_read_ledger::expand(history, turn_id)?;
+    let history = &expanded.items;
+    let mut pending = HashMap::new();
+    let mut seen = HashSet::new();
+    let mut pairs = Vec::new();
+    for (index, envelope) in history.iter().enumerate() {
+        if envelope.turn_id() != Some(turn_id) {
+            continue;
+        }
+        match &envelope.item {
+            ResponseItem::FunctionCall { call_id, .. } => {
+                if call_id.is_empty() {
+                    return Err(receipt_error("empty function call identity"));
+                }
+                if !seen.insert(call_id) {
+                    return Err(receipt_error("duplicate function call identity"));
+                }
+                if seen.len() > MAX_PAIRS {
+                    return Err(receipt_error(
+                        "current turn exceeds the 32 completed-function-call bound",
+                    ));
+                }
+                // Calls remain exact, including code-writing arguments and local metadata.
+                // Reject only a call that cannot fit the existing canonical receipt budget;
+                // provider projection and the complete call/result set are budgeted below.
+                if serde_json::to_vec(&envelope.item)?.len() > MAX_CANONICAL_RECEIPT_BYTES {
+                    return Err(receipt_error(
+                        "function call exceeds the 24 KiB canonical receipt budget",
+                    ));
+                }
+                pending.insert(call_id.as_str(), (index, envelope));
+            }
+            ResponseItem::FunctionCallOutput { call_id, .. } => {
+                let Some((call_index, call)) = call_id.as_deref().and_then(|id| pending.remove(id))
+                else {
+                    return Err(receipt_error(
+                        "function output has no unique preceding current-turn call",
+                    ));
+                };
+                pairs.push((call_index, call, index, envelope));
+            }
+            ResponseItem::LocalShellCall { .. }
+            | ResponseItem::CustomToolCall { .. }
+            | ResponseItem::CustomToolCallOutput { .. }
+            | ResponseItem::ToolSearchCall { .. }
+            | ResponseItem::ToolSearchOutput { .. }
+            | ResponseItem::WebSearchCall { .. }
+            | ResponseItem::ImageGenerationCall { .. } => {
+                return Err(receipt_error("unsupported tool family in the current turn"));
+            }
+            _ => {}
+        }
+    }
+    if !pending.is_empty() {
+        return Err(receipt_error(
+            "function call has no completed current-turn output",
+        ));
+    }
+    // Later terminal/inventory results do not make the most recent complete
+    // browser page safe to split. This protects evidence only: subsequent input
+    // can still consume its references, and native freshness checks are unchanged.
+    let latest_browser_output_index = pairs.iter().rev().find_map(|(_, call, index, envelope)| {
+        let ResponseItem::FunctionCallOutput { output, .. } = &envelope.item else { return None };
+        has_complete_browser_marker(&call.item, output).then_some(*index)
+    });
+    let mut browser_outputs = HashMap::new();
+    for &(_, call, output_index, envelope) in &pairs {
+        let ResponseItem::FunctionCallOutput { output, .. } = &envelope.item else {
+            unreachable!("validated function output");
+        };
+        if let Some(observation) = browser_observation_retention(&call.item, output, Some(output_index) == latest_browser_output_index)? {
+            browser_outputs.insert(output_index, observation);
+        }
+    }
+    // Do not erase an observation before continuation can consume it. Only the final completed
+    // output may supply one image: a later text result invalidates this retention opportunity.
+    // This preserves model evidence, not capture freshness or authority to act on it.
+    let latest_image = pairs.last().and_then(|(_, _, index, envelope)| {
+        if let ResponseItem::FunctionCallOutput { output, .. } = &envelope.item {
+            Some((*index, output))
+        } else {
+            None
+        }
+    });
+    let latest_image = match latest_image {
+        Some((index, output)) => latest_observation_image(output)?.map(|image| (index, image)),
+        None => None,
+    };
+    let latest_output_index = pairs.last().map(|(_, _, index, _)| *index);
+    let has_complete_browser_observation = latest_browser_output_index.is_some();
+    // Try all bounded historical excerpts before reducing the latest observation. No receipt
+    // is reordered, replayed, or promoted to authority, and global budgets remain unchanged.
+    for (latest_text_cap, older_text_cap, omit_optional_context) in
+        LATEST_OUTPUT_TEXT_CAPS.into_iter().flat_map(|latest| {
+            OUTPUT_TEXT_CAPS
+                .into_iter()
+                .filter(move |older| *older <= latest)
+                .map(move |older| (latest, older, false))
+        }).chain(std::iter::once((
+            MAX_LATEST_OUTPUT_TEXT_BYTES,
+            OUTPUT_TEXT_CAPS[OUTPUT_TEXT_CAPS.len() - 1],
+            true,
+        )))
+    {
+        let mut retained = Vec::new();
+        let mut fits = true;
+        for &(call_index, call, output_index, envelope) in &pairs {
+            let ResponseItem::FunctionCallOutput {
+                id,
+                call_id,
+                name,
+                namespace,
+                output,
+                internal_chat_message_metadata_passthrough,
+            } = &envelope.item
+            else {
+                unreachable!("validated function output");
+            };
+            // Do not clone discarded screenshots or their references. Preserve the original
+            // result envelope/identity and failure state, replacing only its bounded body.
+            let keep_image = latest_image.is_some_and(|(index, _)| index == output_index);
+            let is_latest = latest_output_index == Some(output_index);
+            let protects_browser_page = latest_browser_output_index == Some(output_index);
+            let text_cap = if protects_browser_page {
+                MAX_LATEST_OUTPUT_TEXT_BYTES
+            } else if is_latest {
+                latest_text_cap
+            } else {
+                older_text_cap
+            };
+            let serialized_cap = if is_latest || protects_browser_page {
+                MAX_LATEST_OUTPUT_BYTES
+            } else {
+                MAX_OUTPUT_BYTES
+            };
+            let output = if protects_browser_page {
+                // A character/line excerpt would sever a row from its target or
+                // keep a continuation cursor that skips the removed rows. Keep
+                // the producer's complete page, or fail within existing bounds.
+                output.clone()
+            } else if let Some(observation) = browser_outputs.get(&output_index) {
+                let mut excerpt = historical_browser_output(output, observation, text_cap);
+                if omit_optional_context {
+                    omit_historical_browser_context(&mut excerpt);
+                }
+                excerpt
+            } else {
+                bounded_output(output, text_cap, keep_image)?
+            };
+            let text_bytes = output_text_bytes(&output.body);
+            let receipt = ResponseItemEnvelope {
+                item: ResponseItem::FunctionCallOutput {
+                    id: id.clone(),
+                    call_id: call_id.clone(),
+                    name: name.clone(),
+                    namespace: namespace.clone(),
+                    output,
+                    internal_chat_message_metadata_passthrough:
+                        internal_chat_message_metadata_passthrough.clone(),
+                },
+                metadata: envelope.metadata.clone(),
+            };
+            let output_bytes = serde_json::to_vec(&receipt.item)?.len();
+            if text_bytes > text_cap || output_bytes > serialized_cap
+            {
+                fits = false;
+                break;
+            }
+            retained.push((call_index, call.clone()));
+            retained.push((output_index, receipt));
+        }
+        if fits {
+            retained.sort_by_key(|(index, _)| *index);
+            // Native read records are an explicit lossy projection of old page
+            // detail, not new tool replies. Both their display and local metadata
+            // are charged. Rehydrated records may never escape as invented pairs.
+            if !expanded.previously_omitted.is_empty() || !receipt_set_fits(&retained, provider)? {
+                let protected: Vec<_> = [latest_output_index, latest_browser_output_index].into_iter().flatten().collect();
+                retained = native_read_ledger::pack(&retained, history, turn_id, &protected, &expanded.previously_omitted, &expanded.prior_run_starts, &expanded.prior_run_ids)?;
+            }
+            if !receipt_set_fits(&retained, provider)? { continue; }
+            if let Some((index, image)) = latest_image {
+                let (_, receipt) = retained
+                    .iter_mut()
+                    .find(|(output_index, _)| *output_index == index)
+                    .ok_or_else(|| receipt_error("latest observation output was not retained"))?;
+                let ResponseItem::FunctionCallOutput { output, .. } = &mut receipt.item else {
+                    return Err(receipt_error("latest observation output changed shape"));
+                };
+                let FunctionCallOutputBody::ContentItems(items) = &mut output.body else {
+                    return Err(receipt_error("latest observation content changed shape"));
+                };
+                let placeholder = items
+                    .iter_mut()
+                    .find(|item| matches!(item, FunctionCallOutputContentItem::InputImage { .. }))
+                    .ok_or_else(|| {
+                        receipt_error("latest observation placeholder was not retained")
+                    })?;
+                // Clone the single validated image only after the text budget fits. Candidate
+                // history's native image token estimator still enforces the final context bound.
+                *placeholder = image.clone();
+            }
+            // Preserve actual interleaving, including parallel results completed out of order.
+            // The first fitting pass leaves already-bounded receipts unchanged on recompaction.
+            retained.sort_by_key(|(index, _)| *index);
+            return Ok(retained.into_iter().map(|(_, item)| item).collect());
+        }
+    }
+    Err(receipt_error(if has_complete_browser_observation {
+        "the complete latest browser observation and all genuine tool receipts cannot fit the existing text/output limits or 12 KiB provider-input/24 KiB canonical serialized bounds"
+    } else {
+        "all genuine tool receipts cannot fit the 12 KiB provider-input or 24 KiB canonical serialized bounds"
+    }))
+}
+
+fn receipt_set_fits(retained: &[(usize, ResponseItemEnvelope)], provider: ReceiptProvider) -> Result<bool> {
+    let items: Vec<_> = retained.iter().map(|(_, item)| &item.item).collect();
+    let metadata: Vec<_> = retained.iter().map(|(_, item)| &item.metadata).collect();
+    let canonical_bytes = serde_json::to_vec(&items)?.len() + serde_json::to_vec(&metadata)?.len();
+    let mut projected: Vec<_> = items.into_iter().cloned().collect();
+    if matches!(provider, ReceiptProvider::External) { prepare_input_for_non_openai_provider(&mut projected); }
+    Ok(canonical_bytes <= MAX_CANONICAL_RECEIPT_BYTES && serde_json::to_vec(&projected)?.len() <= MAX_RECEIPT_BYTES)
+}
+
+fn has_complete_browser_marker(call: &ResponseItem, output: &FunctionCallOutputPayload) -> bool {
+    matches!(call, ResponseItem::FunctionCall { name, namespace: None, .. }
+        if matches!(name.as_str(), "browser_read" | "browser_continue" | "browser_click" | "browser_fill" | "browser_open" | "browser_bind" | "browser_navigate"))
+        && matches!(&output.body, FunctionCallOutputBody::ContentItems(items)
+            if matches!(items.first(), Some(FunctionCallOutputContentItem::InputText { text })
+                if text == COMPLETE_BROWSER_OBSERVATION_MARKER))
+}
+
+fn browser_observation_retention(
+    call: &ResponseItem,
+    output: &FunctionCallOutputPayload,
+    latest: bool,
+) -> Result<Option<BrowserObservationRetention>> {
+    // Only paired native tools opt in. The marker grants no authority and never
+    // changes custom/MCP or unmarked output behavior.
+    let tool = match call {
+        ResponseItem::FunctionCall { name, namespace: None, .. }
+            if matches!(name.as_str(), "browser_read" | "browser_continue" | "browser_click" | "browser_fill" | "browser_open" | "browser_bind" | "browser_navigate") => name.as_str(),
+        _ => return Ok(None),
+    };
+    let marker = match &output.body {
+        FunctionCallOutputBody::Text(text) => Some(text.as_str()),
+        FunctionCallOutputBody::ContentItems(items) => match items.first() {
+            Some(FunctionCallOutputContentItem::InputText { text }) => Some(text.as_str()),
+            _ => None,
+        },
+    };
+    let complete = match marker {
+        Some(COMPLETE_BROWSER_OBSERVATION_MARKER) => true,
+        Some(HISTORICAL_BROWSER_OBSERVATION_MARKER) => false,
+        _ => return Ok(None),
+    };
+    let invalid = || receipt_error("the marked browser observation has an invalid result shape or failure status");
+    let FunctionCallOutputBody::ContentItems(items) = &output.body else { return Err(invalid()); };
+    let (cue, body, recovery) = match items.as_slice() {
+        [FunctionCallOutputContentItem::InputText { .. },
+         FunctionCallOutputContentItem::InputText { text }] if matches!(tool, "browser_read" | "browser_continue") && output.success != Some(false) => (None, text.as_str(), false),
+        [FunctionCallOutputContentItem::InputText { .. },
+         FunctionCallOutputContentItem::InputText { text: cue },
+         FunctionCallOutputContentItem::InputText { text: body }]
+            if output.success != Some(true) && valid_browser_rejection_cue(tool, cue) => (Some(cue.clone()), body.as_str(), true),
+        [FunctionCallOutputContentItem::InputText { .. },
+         FunctionCallOutputContentItem::InputText { text: cue },
+         FunctionCallOutputContentItem::InputText { text: body }]
+            if matches!(tool, "browser_click" | "browser_fill") && output.success != Some(false) && valid_browser_dispatch_cue(tool, cue) => (Some(cue.clone()), body.as_str(), false),
+        [FunctionCallOutputContentItem::InputText { .. },
+         FunctionCallOutputContentItem::InputText { text: cue },
+         FunctionCallOutputContentItem::InputText { text: body }]
+            if output.success != Some(false) && valid_browser_lifecycle_cue(tool, cue) => (Some(cue.clone()), body.as_str(), false),
+        _ => return Err(invalid()),
+    };
+    if body.trim().is_empty() { return Err(invalid()); }
+    let lines = if complete {
+        let page = if matches!(tool, "browser_read" | "browser_continue") && !recovery {
+            body.to_string()
+        } else {
+            let valid = if recovery {
+                complete_browser_recovery_observation(tool, cue.as_deref().unwrap_or_default(), body)
+            } else if matches!(tool, "browser_open" | "browser_bind" | "browser_navigate") {
+                complete_browser_lifecycle_observation(tool, cue.as_deref().unwrap_or_default(), body)
+            } else {
+                complete_browser_action_observation(tool, cue.as_deref().unwrap_or_default(), body)
+            };
+            if !valid {
+                return Err(invalid());
+            }
+            serde_json::from_str::<serde_json::Value>(body).ok()
+                .and_then(|body| body.get("current_observation")?.get("text")?.as_str().map(str::to_owned))
+                .ok_or_else(invalid)?
+        };
+        // The latest complete output is retained exactly, never excerpted.
+        if latest { Vec::new() } else { historical_browser_lines(&page)? }
+    } else {
+        let mut lines = body.split('\n');
+        if lines.next() != Some(HISTORICAL_BROWSER_NOTICE) { return Err(invalid()); }
+        let lines: Vec<String> = lines.map(str::to_owned).collect();
+        validate_historical_browser_lines(&lines)?;
+        lines.into_iter().filter(|line| line != HISTORICAL_BROWSER_ROW_DEFAULTS).collect()
+    };
+    Ok(Some(BrowserObservationRetention { complete, cue, lines }))
+}
+
+// Parse the native key=value line format without interpreting or stripping page
+// prose. JSON strings may contain escaped newlines/quotes; they remain one field
+// and one atomic row. Reject malformed rows rather than preserve orphan refs.
+fn native_browser_fields(line: &str) -> Option<Vec<(&str, &str)>> {
+    let mut fields = Vec::new();
+    let mut rest = line;
+    while !rest.trim_start_matches(' ').is_empty() {
+        rest = rest.trim_start_matches(' ');
+        let (key, value) = rest.split_once('=')?;
+        if key.is_empty() || !key.bytes().all(|byte| byte.is_ascii_lowercase() || byte == b'_' || byte.is_ascii_digit())
+            || fields.iter().any(|(previous, _)| *previous == key) { return None; }
+        let mut quoted = false;
+        let mut escaped = false;
+        let mut end = value.len();
+        for (index, byte) in value.bytes().enumerate() {
+            if byte.is_ascii_control() { return None; }
+            if escaped { escaped = false; continue; }
+            if quoted && byte == b'\\' { escaped = true; continue; }
+            if byte == b'"' { quoted = !quoted; continue; }
+            if !quoted && byte == b' ' { end = index; break; }
+        }
+        if quoted || escaped || end == 0 { return None; }
+        let raw = &value[..end];
+        if raw.starts_with('"') {
+            serde_json::from_str::<String>(raw).ok()?;
+        } else if raw.starts_with('[') {
+            serde_json::from_str::<Vec<String>>(raw).ok()?;
+        } else if raw.contains(['"', '\\']) { return None; }
+        fields.push((key, raw));
+        rest = &value[end..];
+    }
+    Some(fields)
+}
+
+fn valid_native_browser_row(line: &str) -> bool {
+    let Some((index, rest)) = line.strip_prefix('#').and_then(|line| line.split_once(' ')) else { return false };
+    if index.is_empty() || !index.bytes().all(|byte| byte.is_ascii_digit()) { return false; }
+    let Some(fields) = native_browser_fields(rest) else { return false };
+    matches!(fields.first(), Some(("role", value)) if serde_json::from_str::<String>(value).is_ok())
+        && ["content_scope", "content_kind"].iter().all(|key| fields.iter().any(|(name, _)| name == key))
+        && fields.iter().any(|(key, value)| matches!(*key, "label" | "value" | "href" | "href_fragment")
+            && serde_json::from_str::<String>(value).is_ok())
+        && fields.iter().filter(|(key, _)| matches!(*key, "click_ref" | "fill_ref"))
+            .all(|(_, value)| serde_json::from_str::<String>(value).is_ok())
+}
+
+fn historical_browser_lines(page: &str) -> Result<Vec<String>> {
+    let mut result = Vec::new();
+    // Retain only whole quoted URL/title fields, with historical names. No old
+    // snapshot IDs, count/completeness claims, or pagination cursor survives.
+    if let Some(header) = page.lines().next().and_then(|line| line.strip_prefix("AXSNAPSHOT "))
+        && let Some(fields) = native_browser_fields(header)
+    {
+        for key in ["url", "title"] {
+            if let Some((_, value)) = fields.iter().find(|(name, value)| *name == key && serde_json::from_str::<String>(value).is_ok()) {
+                result.push(format!("{}={value}", if key == "title" { "observed_title_fragment" } else { "observed_url" }));
+            }
+        }
+    }
+    for line in page.split('\n').filter(|line| line.starts_with('#')) {
+        if !valid_native_browser_row(line) {
+            return Err(receipt_error("the marked browser observation contains a malformed native row"));
+        }
+        result.push(line.to_string());
+    }
+    Ok(result)
+}
+
+fn validate_historical_browser_lines(lines: &[String]) -> Result<()> {
+    let mut metadata = HashSet::new();
+    let mut saw_row = false;
+    let mut defaults = false;
+    for line in lines {
+        if line == HISTORICAL_BROWSER_ROW_DEFAULTS && !defaults && !saw_row {
+            defaults = true;
+        } else if defaults && line.starts_with('#') && valid_native_browser_row(line) {
+            saw_row = true;
+        } else if !defaults && ["observed_url=", "observed_title_fragment="].iter().any(|prefix| {
+            line.strip_prefix(prefix).is_some_and(|value| serde_json::from_str::<String>(value).is_ok())
+                && metadata.insert(*prefix)
+        }) {
+        } else {
+            return Err(receipt_error("the historical browser observation has an invalid row or metadata shape"));
+        }
+    }
+    if defaults != saw_row {
+        return Err(receipt_error("the historical browser observation has inconsistent row defaults"));
+    }
+    Ok(())
+}
+
+fn historical_browser_output(
+    source: &FunctionCallOutputPayload,
+    observation: &BrowserObservationRetention,
+    text_cap: usize,
+) -> FunctionCallOutputPayload {
+    let mut items = vec![FunctionCallOutputContentItem::InputText {
+        text: HISTORICAL_BROWSER_OBSERVATION_MARKER.to_string(),
+    }];
+    if let Some(cue) = &observation.cue {
+        items.push(FunctionCallOutputContentItem::InputText { text: cue.clone() });
+    }
+    // The marker, cue, notice, and real item separators all consume the same
+    // existing text budget. Whole lines may be omitted; no line is ever sliced.
+    let mut used = HISTORICAL_BROWSER_OBSERVATION_MARKER.len()
+        + observation.cue.as_ref().map_or(0, String::len) + items.len()
+        + HISTORICAL_BROWSER_NOTICE.len();
+    let mut body = HISTORICAL_BROWSER_NOTICE.to_string();
+    let mut defaults = false;
+    for line in &observation.lines {
+        let add_defaults = line.starts_with('#') && !defaults;
+        let added = 1 + line.len() + if add_defaults { 1 + HISTORICAL_BROWSER_ROW_DEFAULTS.len() } else { 0 };
+        if used.saturating_add(added) <= text_cap {
+            if add_defaults {
+                body.push('\n');
+                body.push_str(HISTORICAL_BROWSER_ROW_DEFAULTS);
+                defaults = true;
+            }
+            body.push('\n');
+            body.push_str(line);
+            used += added;
+        }
+    }
+    items.push(FunctionCallOutputContentItem::InputText { text: body });
+    FunctionCallOutputPayload { body: FunctionCallOutputBody::ContentItems(items), success: source.success }
+}
+
+// A final, bounded candidate can omit optional historical context when the
+// ordinary candidates exhaust the aggregate budget. Apply this only to the
+// typed excerpt just produced above, after row selection: freed bytes are not
+// refilled with different rows, and the latest complete observation is untouched.
+fn omit_historical_browser_context(output: &mut FunctionCallOutputPayload) {
+    let FunctionCallOutputBody::ContentItems(items) = &mut output.body else { return };
+    if !matches!(items.first(), Some(FunctionCallOutputContentItem::InputText { text })
+        if text == HISTORICAL_BROWSER_OBSERVATION_MARKER) { return; }
+    let Some(FunctionCallOutputContentItem::InputText { text }) = items.last_mut() else { return };
+    *text = text.split('\n').filter(|line| {
+        !line.starts_with("observed_url=") && !line.starts_with("observed_title_fragment=")
+    }).collect::<Vec<_>>().join("\n");
+}
+
+fn valid_browser_dispatch_cue(tool: &str, receipt: &str) -> bool {
+    // The small native dispatch cue remains a separate item. It confirms input
+    // dispatch only, never that the website accepted or completed the action.
+    // Retention validates the producer contract; it grants no target authority.
+    if receipt.len() > 128 {
+        return false;
+    }
+    let Ok(cue) = serde_json::from_str::<serde_json::Value>(receipt) else { return false };
+    let Some(cue) = cue.as_object() else { return false };
+    if cue.len() != 5
+        || cue.get("kind").and_then(serde_json::Value::as_str) != tool.strip_prefix("browser_")
+        || cue.get("label").and_then(serde_json::Value::as_str).is_none()
+        || cue.get("partial").and_then(serde_json::Value::as_bool).is_none()
+        || cue.get("dispatched").and_then(serde_json::Value::as_bool) != Some(true)
+        || cue.get("outcome").and_then(serde_json::Value::as_str) != Some("unverified")
+    {
+        return false;
+    }
+    true
+}
+
+fn valid_browser_rejection_cue(tool: &str, receipt: &str) -> bool {
+    // A rejected operation may carry a separate successful observation. Its
+    // fixed cue keeps the rejection visible after that page becomes historical.
+    if receipt.len() > 128 { return false; }
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(receipt) else { return false };
+    let Some(cue) = value.as_object() else { return false };
+    cue.len() == 4
+        && cue.get("kind").and_then(serde_json::Value::as_str) == tool.strip_prefix("browser_")
+        && cue.get("dispatched").and_then(serde_json::Value::as_bool) == Some(false)
+        && cue.get("outcome").and_then(serde_json::Value::as_str) == Some("unverified")
+        && matches!((tool, cue.get("reason").and_then(serde_json::Value::as_str)),
+            ("browser_read", Some("continuation_filters_changed"))
+            | ("browser_click" | "browser_fill", Some("stale_snapshot" | "stale_document")))
+}
+
+fn complete_browser_recovery_observation(tool: &str, receipt: &str, observation: &str) -> bool {
+    if !valid_browser_rejection_cue(tool, receipt) { return false; }
+    let Ok(cue) = serde_json::from_str::<serde_json::Value>(receipt) else { return false };
+    let Ok(body) = serde_json::from_str::<serde_json::Value>(observation) else { return false };
+    body.get("success").and_then(serde_json::Value::as_bool) == Some(false)
+        && body.get("error").and_then(|error| error.get("code")) == cue.get("reason")
+        && body.get("dispatched").and_then(serde_json::Value::as_bool) == Some(false)
+        && body.get("no_replay").and_then(serde_json::Value::as_bool) == Some(true)
+        && body.get("result_verified").and_then(serde_json::Value::as_bool) == Some(false)
+        && body.get("current_observation").is_some_and(|current| {
+            current.get("status").and_then(serde_json::Value::as_str) == Some("available")
+                && current.get("source").and_then(serde_json::Value::as_str) == Some("separate_recovery_read")
+                && current.get("text").and_then(serde_json::Value::as_str)
+                    .is_some_and(|text| !text.trim().is_empty())
+        })
+}
+
+fn complete_browser_action_observation(tool: &str, receipt: &str, observation: &str) -> bool {
+    if !valid_browser_dispatch_cue(tool, receipt) { return false; }
+    let Ok(body) = serde_json::from_str::<serde_json::Value>(observation) else { return false };
+    body.get("dispatched").and_then(serde_json::Value::as_bool) == Some(true)
+        && body.get("input_kind").and_then(serde_json::Value::as_str) == tool.strip_prefix("browser_")
+        && body.get("no_replay").and_then(serde_json::Value::as_bool) == Some(true)
+        && body.get("result_verified").and_then(serde_json::Value::as_bool) == Some(false)
+        && body.get("current_observation").is_some_and(|current| {
+            current.get("status").and_then(serde_json::Value::as_str) == Some("available")
+                && current.get("text").and_then(serde_json::Value::as_str)
+                    .is_some_and(|text| !text.trim().is_empty())
+        })
+}
+
+// Lifecycle completion is a host operation receipt, not website success or a
+// passive-read proof. It remains an ordinary exact call/output pair, including
+// when the following observation is retained atomically across compaction.
+fn valid_browser_lifecycle_cue(tool: &str, receipt: &str) -> bool {
+    if !matches!(tool, "browser_open" | "browser_bind" | "browser_navigate") || receipt.len() > 128 {
+        return false;
+    }
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(receipt) else { return false };
+    let Some(cue) = value.as_object() else { return false };
+    cue.len() == 3
+        && cue.get("kind").and_then(serde_json::Value::as_str) == tool.strip_prefix("browser_")
+        && cue.get("completed").and_then(serde_json::Value::as_bool) == Some(true)
+        && cue.get("outcome").and_then(serde_json::Value::as_str) == Some("unverified")
+}
+
+fn complete_browser_lifecycle_observation(tool: &str, receipt: &str, observation: &str) -> bool {
+    if !valid_browser_lifecycle_cue(tool, receipt) { return false; }
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(observation) else { return false };
+    let Some(body) = value.as_object() else { return false };
+    let shared = ["operation_kind", "operation_complete", "no_replay", "result_verified", "current_observation", "next"];
+    let completion: &[&str] = if tool == "browser_navigate" { &["navigation_complete"] }
+        else { &["browser", "tab_id", "tab_handle", "bound", "ownership", "already_bound", "profile"] };
+    if body.len() != shared.len() + completion.len()
+        || !body.keys().all(|key| shared.contains(&key.as_str()) || completion.contains(&key.as_str()))
+        || body.get("operation_kind").and_then(serde_json::Value::as_str) != tool.strip_prefix("browser_")
+        || body.get("operation_complete").and_then(serde_json::Value::as_bool) != Some(true)
+        || body.get("no_replay").and_then(serde_json::Value::as_bool) != Some(true)
+        || body.get("result_verified").and_then(serde_json::Value::as_bool) != Some(false)
+        || !body.get("next").and_then(serde_json::Value::as_str).is_some_and(|text| !text.trim().is_empty())
+    { return false; }
+    let Some(current) = body.get("current_observation").and_then(serde_json::Value::as_object) else { return false };
+    if current.len() != 4
+        || current.get("status").and_then(serde_json::Value::as_str) != Some("available")
+        || current.get("view").and_then(serde_json::Value::as_str) != Some("overview")
+        || !current.get("snapshot_id").and_then(serde_json::Value::as_str).is_some_and(|id| !id.is_empty())
+        || !current.get("text").and_then(serde_json::Value::as_str).is_some_and(|text| !text.trim().is_empty())
+    { return false; }
+    if tool == "browser_navigate" {
+        return body.get("navigation_complete").and_then(serde_json::Value::as_bool) == Some(true);
+    }
+    body.get("browser").and_then(serde_json::Value::as_str) == Some("computa_builtin")
+        && body.get("profile").and_then(serde_json::Value::as_str) == Some("shared_human")
+        && body.get("bound").and_then(serde_json::Value::as_bool) == Some(true)
+        && ["tab_id", "tab_handle"].iter().all(|key| body.get(*key).and_then(serde_json::Value::as_str).is_some_and(|id| !id.is_empty()))
+        && matches!(body.get("ownership").and_then(serde_json::Value::as_str), Some("task_created" | "user_existing"))
+        && body.get("already_bound").and_then(serde_json::Value::as_bool).is_some()
+        && (tool != "browser_open" || (body.get("ownership").and_then(serde_json::Value::as_str) == Some("task_created")
+            && body.get("already_bound").and_then(serde_json::Value::as_bool) == Some(false)))
+}
+
+fn bounded_output(
+    source: &FunctionCallOutputPayload,
+    text_cap: usize,
+    keep_image: bool,
+) -> Result<FunctionCallOutputPayload> {
+    let mut omitted_images = 0usize;
+    let mut image_markers = Vec::new();
+    let body = match &source.body {
+        FunctionCallOutputBody::Text(text) => FunctionCallOutputBody::Text(text.clone()),
+        FunctionCallOutputBody::ContentItems(items) => {
+            let mut text_items = Vec::new();
+            for (index, item) in items.iter().enumerate() {
+                match item {
+                    FunctionCallOutputContentItem::InputText { text }
+                        if index == 0 && is_image_omission_marker(text) =>
+                    {
+                        // Keep the previous tool-role notice verbatim if new calls require a
+                        // smaller excerpt on a later compaction. It conveys no new authority.
+                        image_markers.push(text.clone());
+                    }
+                    FunctionCallOutputContentItem::InputText { .. } => {
+                        text_items.push(item.clone())
+                    }
+                    FunctionCallOutputContentItem::InputImage { detail, .. } if keep_image => {
+                        // Native truncation preserves media ordering. A small placeholder lets it
+                        // do so without repeatedly copying pixels during the bounded budget passes.
+                        text_items.push(FunctionCallOutputContentItem::InputImage {
+                            image: ImageReference::Inline {
+                                image_url: String::new(),
+                            },
+                            detail: *detail,
+                        });
+                    }
+                    FunctionCallOutputContentItem::InputImage { .. } => omitted_images += 1,
+                    FunctionCallOutputContentItem::InputAudio { .. }
+                    | FunctionCallOutputContentItem::EncryptedContent { .. } => {
+                        return Err(receipt_error(
+                            "audio or encrypted tool output cannot be retained safely",
+                        ));
+                    }
+                }
+            }
+            FunctionCallOutputBody::ContentItems(text_items)
+        }
+    };
+    let mut output = FunctionCallOutputPayload {
+        body,
+        success: source.success,
+    };
+    if omitted_images > 0 {
+        image_markers.push(format!(
+            "[omitted {omitted_images} historical image items during context compaction; obtain a fresh capture for image-dependent actions]"
+        ));
+    }
+    let marker_bytes: usize = image_markers.iter().map(|marker| marker.len() + 1).sum();
+    // Do not truncate an already bounded receipt again: the native omission marker is added
+    // outside its supplied byte budget, so unconditional re-truncation would change its evidence.
+    if output_text_bytes(&output.body).saturating_add(marker_bytes) > text_cap {
+        truncate_function_output_payload(
+            &mut output,
+            TruncationPolicy::Bytes(text_cap.saturating_sub(128 + marker_bytes)),
+            |_| 0,
+        );
+    }
+    if let FunctionCallOutputBody::ContentItems(items) = &mut output.body {
+        // Reserve this marker before text truncation and prepend it afterwards; otherwise a late
+        // image could disappear into the native generic "omitted text items" marker. This is a
+        // lossy tool-role receipt, not a success claim, visual observation, or renewed authority.
+        for marker in image_markers.into_iter().rev() {
+            items.insert(0, FunctionCallOutputContentItem::InputText { text: marker });
+        }
+    }
+    Ok(output)
+}
+
+fn latest_observation_image(
+    output: &FunctionCallOutputPayload,
+) -> Result<Option<&FunctionCallOutputContentItem>> {
+    let FunctionCallOutputBody::ContentItems(items) = &output.body else {
+        return Ok(None);
+    };
+    let mut images = items
+        .iter()
+        .filter(|item| matches!(item, FunctionCallOutputContentItem::InputImage { .. }));
+    let Some(image) = images.next() else {
+        return Ok(None);
+    };
+    if images.next().is_some() {
+        return Err(receipt_error(
+            "latest tool output contains multiple observation images",
+        ));
+    }
+    let FunctionCallOutputContentItem::InputImage {
+        image: ImageReference::Inline { image_url },
+        ..
+    } = image
+    else {
+        return Err(receipt_error(
+            "latest observation must be an inline PNG or JPEG image",
+        ));
+    };
+    if image_url.len() > MAX_LATEST_IMAGE_BYTES
+        || serde_json::to_vec(image)?.len() > MAX_LATEST_IMAGE_BYTES
+    {
+        return Err(receipt_error(
+            "latest observation exceeds the 2 MiB image bound",
+        ));
+    }
+    let (encoded, png) = if let Some(encoded) = image_url.strip_prefix("data:image/png;base64,") {
+        (encoded, true)
+    } else if let Some(encoded) = image_url.strip_prefix("data:image/jpeg;base64,") {
+        (encoded, false)
+    } else {
+        return Err(receipt_error(
+            "latest observation must be an inline PNG or JPEG image",
+        ));
+    };
+    let decoded = base64::engine::general_purpose::STANDARD
+        .decode(encoded)
+        .map_err(|_| receipt_error("latest observation has invalid base64 image data"))?;
+    if (png && !decoded.starts_with(b"\x89PNG\r\n\x1a\n"))
+        || (!png && !decoded.starts_with(&[0xff, 0xd8, 0xff]))
+    {
+        return Err(receipt_error(
+            "latest observation has invalid PNG or JPEG image data",
+        ));
+    }
+    Ok(Some(image))
+}
+
+fn is_image_omission_marker(text: &str) -> bool {
+    let Some(count) = text.strip_prefix("[omitted ").and_then(|text| {
+        text.strip_suffix(" historical image items during context compaction; obtain a fresh capture for image-dependent actions]")
+    }) else {
+        return false;
+    };
+    count
+        .parse::<usize>()
+        .is_ok_and(|value| value > 0 && value.to_string() == count)
+}
+
+fn output_text_bytes(body: &FunctionCallOutputBody) -> usize {
+    match body {
+        FunctionCallOutputBody::Text(text) => text.len(),
+        FunctionCallOutputBody::ContentItems(items) => {
+            items
+                .iter()
+                .fold(items.len().saturating_sub(1), |bytes, item| match item {
+                    FunctionCallOutputContentItem::InputText { text } => {
+                        bytes.saturating_add(text.len())
+                    }
+                    FunctionCallOutputContentItem::InputImage { .. }
+                    | FunctionCallOutputContentItem::InputAudio { .. }
+                    | FunctionCallOutputContentItem::EncryptedContent { .. } => bytes,
+                })
+        }
+    }
+}
+
+fn receipt_error(reason: &str) -> CodexErr {
+    CodexErr::InvalidRequest(format!(
+        "Local mid-turn compaction stopped to avoid forgetting completed actions: {reason}. Start a new turn with a smaller task."
+    ))
+}
