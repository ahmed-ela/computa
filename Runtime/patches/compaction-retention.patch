index 0000000..550661c
--- /dev/null
+++ b/codex-rs/core/src/compact_tool_receipts.rs
@@ -0,0 +1,487 @@
+//! Bounded, genuine current-turn receipts for local mid-turn compaction.
+//!
+//! These remain tool-role history, never instructions, authorization, or a replay queue. Capture
+//! before sampling the summary and commit them with its replacement history, before inference.
+
+use std::collections::HashMap;
+use std::collections::HashSet;
+
+use crate::client::prepare_input_for_non_openai_provider;
+use base64::Engine;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::ImageReference;
+use codex_protocol::models::ResponseItem;
+use codex_utils_output_truncation::TruncationPolicy;
+use codex_utils_output_truncation::truncate_function_output_payload;
+
+const MAX_PAIRS: usize = 32;
+const MAX_OUTPUT_TEXT_BYTES: usize = 2048;
+const MAX_OUTPUT_BYTES: usize = 3072;
+const MAX_LATEST_OUTPUT_TEXT_BYTES: usize = 4096;
+const MAX_LATEST_OUTPUT_BYTES: usize = 6144;
+const MAX_RECEIPT_BYTES: usize = 12 * 1024;
+// Local-only identities and timestamps do not consume the external provider's prompt budget,
+// but they still need a separate hard bound in the canonical replacement history.
+const MAX_CANONICAL_RECEIPT_BYTES: usize = 24 * 1024;
+const MAX_LATEST_IMAGE_BYTES: usize = 2 * 1024 * 1024;
+// The native browser producer pages before issuing this closed marker. It is
+// retention metadata, never observation, authorization, or a capability. Matching
+// it can only prevent lossy continuation; target validation stays with the host.
+const COMPLETE_BROWSER_OBSERVATION_MARKER: &str =
+    r#"{"retention":"complete_browser_observation_v1"}"#;
+// Every result keeps a genuine excerpt rather than dropping older actions. Give the latest
+// completed observation more room before shrinking it: a uniform cap can erase the newest
+// observation's header/identity while retaining stale identifiers from older observations.
+// Text/header budgets include JSON escaping and array separators. The latest image payload is
+// separately bounded and counted by the final candidate-history context estimator.
+const OUTPUT_TEXT_CAPS: [usize; 7] = [MAX_OUTPUT_TEXT_BYTES, 1536, 1024, 768, 512, 384, 256];
+const LATEST_OUTPUT_TEXT_CAPS: [usize; 9] = [
+    MAX_LATEST_OUTPUT_TEXT_BYTES,
+    3072,
+    MAX_OUTPUT_TEXT_BYTES,
+    1536,
+    1024,
+    768,
+    512,
+    384,
+    256,
+];
+
+#[derive(Clone, Copy)]
+pub(super) enum ReceiptProvider {
+    OpenAI,
+    External,
+}
+
+pub(super) fn current_turn_receipts(
+    history: &[ResponseItemEnvelope],
+    turn_id: &str,
+    provider: ReceiptProvider,
+) -> Result<Vec<ResponseItemEnvelope>> {
+    if turn_id.is_empty() {
+        return Err(receipt_error("current turn identity is unavailable"));
+    }
+    let mut pending = HashMap::new();
+    let mut seen = HashSet::new();
+    let mut pairs = Vec::new();
+    for (index, envelope) in history.iter().enumerate() {
+        if envelope.turn_id() != Some(turn_id) {
+            continue;
+        }
+        match &envelope.item {
+            ResponseItem::FunctionCall { call_id, .. } => {
+                if call_id.is_empty() {
+                    return Err(receipt_error("empty function call identity"));
+                }
+                if !seen.insert(call_id) {
+                    return Err(receipt_error("duplicate function call identity"));
+                }
+                if seen.len() > MAX_PAIRS {
+                    return Err(receipt_error(
+                        "current turn exceeds the 32 completed-function-call bound",
+                    ));
+                }
+                // Calls remain exact, including code-writing arguments and local metadata.
+                // Reject only a call that cannot fit the existing canonical receipt budget;
+                // provider projection and the complete call/result set are budgeted below.
+                if serde_json::to_vec(&envelope.item)?.len() > MAX_CANONICAL_RECEIPT_BYTES {
+                    return Err(receipt_error(
+                        "function call exceeds the 24 KiB canonical receipt budget",
+                    ));
+                }
+                pending.insert(call_id.as_str(), (index, envelope));
+            }
+            ResponseItem::FunctionCallOutput { call_id, .. } => {
+                let Some((call_index, call)) = call_id.as_deref().and_then(|id| pending.remove(id))
+                else {
+                    return Err(receipt_error(
+                        "function output has no unique preceding current-turn call",
+                    ));
+                };
+                pairs.push((call_index, call, index, envelope));
+            }
+            ResponseItem::LocalShellCall { .. }
+            | ResponseItem::CustomToolCall { .. }
+            | ResponseItem::CustomToolCallOutput { .. }
+            | ResponseItem::ToolSearchCall { .. }
+            | ResponseItem::ToolSearchOutput { .. }
+            | ResponseItem::WebSearchCall { .. }
+            | ResponseItem::ImageGenerationCall { .. } => {
+                return Err(receipt_error("unsupported tool family in the current turn"));
+            }
+            _ => {}
+        }
+    }
+    if !pending.is_empty() {
+        return Err(receipt_error(
+            "function call has no completed current-turn output",
+        ));
+    }
+    let mut complete_browser_outputs = HashSet::new();
+    for &(_, call, output_index, envelope) in &pairs {
+        let ResponseItem::FunctionCallOutput { output, .. } = &envelope.item else {
+            unreachable!("validated function output");
+        };
+        if is_complete_browser_observation(&call.item, output)? {
+            complete_browser_outputs.insert(output_index);
+        }
+    }
+    // Do not erase an observation before continuation can consume it. Only the final completed
+    // output may supply one image: a later text result invalidates this retention opportunity.
+    // This preserves model evidence, not capture freshness or authority to act on it.
+    let latest_image = pairs.last().and_then(|(_, _, index, envelope)| {
+        if let ResponseItem::FunctionCallOutput { output, .. } = &envelope.item {
+            Some((*index, output))
+        } else {
+            None
+        }
+    });
+    let latest_image = match latest_image {
+        Some((index, output)) => latest_observation_image(output)?.map(|image| (index, image)),
+        None => None,
+    };
+    let latest_output_index = pairs.last().map(|(_, _, index, _)| *index);
+    let latest_is_complete_browser_observation =
+        latest_output_index.is_some_and(|index| complete_browser_outputs.contains(&index));
+    // Try all bounded historical excerpts before reducing the latest observation. No receipt
+    // is reordered, replayed, or promoted to authority, and global budgets remain unchanged.
+    for (latest_text_cap, older_text_cap) in
+        LATEST_OUTPUT_TEXT_CAPS.into_iter().flat_map(|latest| {
+            OUTPUT_TEXT_CAPS
+                .into_iter()
+                .filter(move |older| *older <= latest)
+                .map(move |older| (latest, older))
+        })
+    {
+        let mut retained = Vec::new();
+        let mut retained_bytes = 2usize; // Provider input-array brackets.
+        let mut canonical_bytes = 4usize; // Parallel persisted item/metadata-array brackets.
+        let mut fits = true;
+        for &(call_index, call, output_index, envelope) in &pairs {
+            let ResponseItem::FunctionCallOutput {
+                id,
+                call_id,
+                name,
+                namespace,
+                output,
+                internal_chat_message_metadata_passthrough,
+            } = &envelope.item
+            else {
+                unreachable!("validated function output");
+            };
+            // Do not clone discarded screenshots or their references. Preserve the original
+            // result envelope/identity and failure state, replacing only its bounded body.
+            let keep_image = latest_image.is_some_and(|(index, _)| index == output_index);
+            let is_latest = latest_output_index == Some(output_index);
+            let text_cap = if is_latest {
+                latest_text_cap
+            } else {
+                older_text_cap
+            };
+            let serialized_cap = if is_latest {
+                MAX_LATEST_OUTPUT_BYTES
+            } else {
+                MAX_OUTPUT_BYTES
+            };
+            let output = if is_latest && latest_is_complete_browser_observation {
+                // A character/line excerpt would sever a row from its target or
+                // keep a continuation cursor that skips the removed rows. Keep
+                // the producer's complete page, or fail within existing bounds.
+                output.clone()
+            } else {
+                bounded_output(
+                    output,
+                    text_cap,
+                    keep_image,
+                    complete_browser_outputs.contains(&output_index),
+                )?
+            };
+            let text_bytes = output_text_bytes(&output.body);
+            let receipt = ResponseItemEnvelope {
+                item: ResponseItem::FunctionCallOutput {
+                    id: id.clone(),
+                    call_id: call_id.clone(),
+                    name: name.clone(),
+                    namespace: namespace.clone(),
+                    output,
+                    internal_chat_message_metadata_passthrough:
+                        internal_chat_message_metadata_passthrough.clone(),
+                },
+                metadata: envelope.metadata.clone(),
+            };
+            let output_bytes = serde_json::to_vec(&receipt.item)?.len();
+            canonical_bytes += serde_json::to_vec(&call.item)?.len()
+                + output_bytes
+                + serde_json::to_vec(&call.metadata)?.len()
+                + serde_json::to_vec(&receipt.metadata)?.len()
+                + if retained.is_empty() { 2 } else { 4 };
+            let mut projected = [call.item.clone(), receipt.item.clone()];
+            if matches!(provider, ReceiptProvider::External) {
+                prepare_input_for_non_openai_provider(&mut projected);
+            }
+            for item in &projected {
+                retained_bytes += serde_json::to_vec(item)?.len();
+            }
+            retained_bytes += if retained.is_empty() { 1 } else { 2 };
+            if text_bytes > text_cap
+                || output_bytes > serialized_cap
+                || retained_bytes > MAX_RECEIPT_BYTES
+                || canonical_bytes > MAX_CANONICAL_RECEIPT_BYTES
+            {
+                fits = false;
+                break;
+            }
+            retained.push((call_index, call.clone()));
+            retained.push((output_index, receipt));
+        }
+        if fits {
+            if let Some((index, image)) = latest_image {
+                let (_, receipt) = retained
+                    .iter_mut()
+                    .find(|(output_index, _)| *output_index == index)
+                    .ok_or_else(|| receipt_error("latest observation output was not retained"))?;
+                let ResponseItem::FunctionCallOutput { output, .. } = &mut receipt.item else {
+                    return Err(receipt_error("latest observation output changed shape"));
+                };
+                let FunctionCallOutputBody::ContentItems(items) = &mut output.body else {
+                    return Err(receipt_error("latest observation content changed shape"));
+                };
+                let placeholder = items
+                    .iter_mut()
+                    .find(|item| matches!(item, FunctionCallOutputContentItem::InputImage { .. }))
+                    .ok_or_else(|| {
+                        receipt_error("latest observation placeholder was not retained")
+                    })?;
+                // Clone the single validated image only after the text budget fits. Candidate
+                // history's native image token estimator still enforces the final context bound.
+                *placeholder = image.clone();
+            }
+            // Preserve actual interleaving, including parallel results completed out of order.
+            // The first fitting pass leaves already-bounded receipts unchanged on recompaction.
+            retained.sort_by_key(|(index, _)| *index);
+            return Ok(retained.into_iter().map(|(_, item)| item).collect());
+        }
+    }
+    Err(receipt_error(if latest_is_complete_browser_observation {
+        "the complete latest browser observation and all genuine tool receipts cannot fit the existing text/output limits or 12 KiB provider-input/24 KiB canonical serialized bounds"
+    } else {
+        "all genuine tool receipts cannot fit the 12 KiB provider-input or 24 KiB canonical serialized bounds"
+    }))
+}
+
+fn is_complete_browser_observation(
+    call: &ResponseItem,
+    output: &FunctionCallOutputPayload,
+) -> Result<bool> {
+    // Custom/MCP tools and ordinary unmarked results retain generic behavior.
+    // The marker is an intentionally conservative opt-in, not a content-prefix
+    // heuristic or proof of successful website action.
+    if !matches!(call, ResponseItem::FunctionCall { name, namespace: None, .. }
+        if name == "browser_read")
+    {
+        return Ok(false);
+    }
+    let marked = match &output.body {
+        FunctionCallOutputBody::Text(text) => text == COMPLETE_BROWSER_OBSERVATION_MARKER,
+        FunctionCallOutputBody::ContentItems(items) => matches!(items.first(),
+            Some(FunctionCallOutputContentItem::InputText { text })
+                if text == COMPLETE_BROWSER_OBSERVATION_MARKER),
+    };
+    if !marked {
+        return Ok(false);
+    }
+    // `success` is not persisted in the output body's wire representation, so a
+    // resumed genuine result may have None. Never reinterpret an explicit failure.
+    let valid = output.success != Some(false)
+        && matches!(&output.body, FunctionCallOutputBody::ContentItems(items)
+            if matches!(items.as_slice(), [FunctionCallOutputContentItem::InputText { .. },
+                FunctionCallOutputContentItem::InputText { text }] if !text.trim().is_empty()));
+    if !valid {
+        return Err(receipt_error(
+            "the marked complete browser observation has an invalid result shape or failure status",
+        ));
+    }
+    Ok(true)
+}
+
+fn bounded_output(
+    source: &FunctionCallOutputPayload,
+    text_cap: usize,
+    keep_image: bool,
+    historical_complete_browser_observation: bool,
+) -> Result<FunctionCallOutputPayload> {
+    let mut omitted_images = 0usize;
+    let mut image_markers = Vec::new();
+    let body = match &source.body {
+        FunctionCallOutputBody::Text(text) => FunctionCallOutputBody::Text(text.clone()),
+        FunctionCallOutputBody::ContentItems(items) => {
+            let mut text_items = Vec::new();
+            for (index, item) in items.iter().enumerate() {
+                // Older receipts remain genuine, bounded tool evidence. Remove
+                // only the host completeness claim before taking an excerpt;
+                // otherwise a truncated historical body would still claim to be
+                // an intact page. Calls, identities and failure state stay exact.
+                if index == 0 && historical_complete_browser_observation {
+                    continue;
+                }
+                match item {
+                    FunctionCallOutputContentItem::InputText { text }
+                        if index == 0 && is_image_omission_marker(text) =>
+                    {
+                        // Keep the previous tool-role notice verbatim if new calls require a
+                        // smaller excerpt on a later compaction. It conveys no new authority.
+                        image_markers.push(text.clone());
+                    }
+                    FunctionCallOutputContentItem::InputText { .. } => {
+                        text_items.push(item.clone())
+                    }
+                    FunctionCallOutputContentItem::InputImage { detail, .. } if keep_image => {
+                        // Native truncation preserves media ordering. A small placeholder lets it
+                        // do so without repeatedly copying pixels during the bounded budget passes.
+                        text_items.push(FunctionCallOutputContentItem::InputImage {
+                            image: ImageReference::Inline {
+                                image_url: String::new(),
+                            },
+                            detail: *detail,
+                        });
+                    }
+                    FunctionCallOutputContentItem::InputImage { .. } => omitted_images += 1,
+                    FunctionCallOutputContentItem::InputAudio { .. }
+                    | FunctionCallOutputContentItem::EncryptedContent { .. } => {
+                        return Err(receipt_error(
+                            "audio or encrypted tool output cannot be retained safely",
+                        ));
+                    }
+                }
+            }
+            FunctionCallOutputBody::ContentItems(text_items)
+        }
+    };
+    let mut output = FunctionCallOutputPayload {
+        body,
+        success: source.success,
+    };
+    if omitted_images > 0 {
+        image_markers.push(format!(
+            "[omitted {omitted_images} historical image items during context compaction; obtain a fresh capture for image-dependent actions]"
+        ));
+    }
+    let marker_bytes: usize = image_markers.iter().map(|marker| marker.len() + 1).sum();
+    // Do not truncate an already bounded receipt again: the native omission marker is added
+    // outside its supplied byte budget, so unconditional re-truncation would change its evidence.
+    if output_text_bytes(&output.body).saturating_add(marker_bytes) > text_cap {
+        truncate_function_output_payload(
+            &mut output,
+            TruncationPolicy::Bytes(text_cap.saturating_sub(128 + marker_bytes)),
+            |_| 0,
+        );
+    }
+    if let FunctionCallOutputBody::ContentItems(items) = &mut output.body {
+        // Reserve this marker before text truncation and prepend it afterwards; otherwise a late
+        // image could disappear into the native generic "omitted text items" marker. This is a
+        // lossy tool-role receipt, not a success claim, visual observation, or renewed authority.
+        for marker in image_markers.into_iter().rev() {
+            items.insert(0, FunctionCallOutputContentItem::InputText { text: marker });
+        }
+    }
+    Ok(output)
+}
+
+fn latest_observation_image(
+    output: &FunctionCallOutputPayload,
+) -> Result<Option<&FunctionCallOutputContentItem>> {
+    let FunctionCallOutputBody::ContentItems(items) = &output.body else {
+        return Ok(None);
+    };
+    let mut images = items
+        .iter()
+        .filter(|item| matches!(item, FunctionCallOutputContentItem::InputImage { .. }));
+    let Some(image) = images.next() else {
+        return Ok(None);
+    };
+    if images.next().is_some() {
+        return Err(receipt_error(
+            "latest tool output contains multiple observation images",
+        ));
+    }
+    let FunctionCallOutputContentItem::InputImage {
+        image: ImageReference::Inline { image_url },
+        ..
+    } = image
+    else {
+        return Err(receipt_error(
+            "latest observation must be an inline PNG or JPEG image",
+        ));
+    };
+    if image_url.len() > MAX_LATEST_IMAGE_BYTES
+        || serde_json::to_vec(image)?.len() > MAX_LATEST_IMAGE_BYTES
+    {
+        return Err(receipt_error(
+            "latest observation exceeds the 2 MiB image bound",
+        ));
+    }
+    let (encoded, png) = if let Some(encoded) = image_url.strip_prefix("data:image/png;base64,") {
+        (encoded, true)
+    } else if let Some(encoded) = image_url.strip_prefix("data:image/jpeg;base64,") {
+        (encoded, false)
+    } else {
+        return Err(receipt_error(
+            "latest observation must be an inline PNG or JPEG image",
+        ));
+    };
+    let decoded = base64::engine::general_purpose::STANDARD
+        .decode(encoded)
+        .map_err(|_| receipt_error("latest observation has invalid base64 image data"))?;
+    if (png && !decoded.starts_with(b"\x89PNG\r\n\x1a\n"))
+        || (!png && !decoded.starts_with(&[0xff, 0xd8, 0xff]))
+    {
+        return Err(receipt_error(
+            "latest observation has invalid PNG or JPEG image data",
+        ));
+    }
+    Ok(Some(image))
+}
+
+fn is_image_omission_marker(text: &str) -> bool {
+    let Some(count) = text.strip_prefix("[omitted ").and_then(|text| {
+        text.strip_suffix(" historical image items during context compaction; obtain a fresh capture for image-dependent actions]")
+    }) else {
+        return false;
+    };
+    count
+        .parse::<usize>()
+        .is_ok_and(|value| value > 0 && value.to_string() == count)
+}
+
+fn output_text_bytes(body: &FunctionCallOutputBody) -> usize {
+    match body {
+        FunctionCallOutputBody::Text(text) => text.len(),
+        FunctionCallOutputBody::ContentItems(items) => {
+            items
+                .iter()
+                .fold(items.len().saturating_sub(1), |bytes, item| match item {
+                    FunctionCallOutputContentItem::InputText { text } => {
+                        bytes.saturating_add(text.len())
+                    }
+                    FunctionCallOutputContentItem::InputImage { .. }
+                    | FunctionCallOutputContentItem::InputAudio { .. }
+                    | FunctionCallOutputContentItem::EncryptedContent { .. } => bytes,
+                })
+        }
+    }
+}
+
+fn receipt_error(reason: &str) -> CodexErr {
+    CodexErr::InvalidRequest(format!(
+        "Local mid-turn compaction stopped to avoid forgetting completed actions: {reason}. Start a new turn with a smaller task."
+    ))
+}
