+#[test]
+fn test_package_staging_preserves_hard_link_identity_and_alias() -> Result<()> {
+    let tmp = TempDir::new()?;
+    let source = tmp.path().join("source-app-server");
+    std::fs::write(&source, b"test executable contents")?;
+    std::fs::set_permissions(&source, std::fs::Permissions::from_mode(0o751))?;
+    let before = std::fs::metadata(&source)?;
+    let package_dir = tmp.path().join("test-package");
+    let bin_dir = package_dir.join("bin");
+    std::fs::create_dir_all(&bin_dir)?;
+    std::fs::write(package_dir.join("codex-package.json"), "{}")?;
+    let destination = bin_dir.join("codex-app-server");
+
+    stage_with_permissions(&source, &destination)?;
+
+    let staged = std::fs::metadata(&destination)?;
+    assert!(
+        std::fs::symlink_metadata(&destination)?
+            .file_type()
+            .is_file()
+    );
+    assert_eq!((staged.dev(), staged.ino()), (before.dev(), before.ino()));
+    assert_eq!(staged.permissions().mode(), before.permissions().mode());
+    assert_eq!(
+        (staged.mtime(), staged.mtime_nsec()),
+        (before.mtime(), before.mtime_nsec())
+    );
+    assert_eq!(staged.nlink(), before.nlink() + 1);
+    let canonical_package = std::fs::canonicalize(&package_dir)?;
+    assert_eq!(
+        std::fs::canonicalize(&destination)?,
+        canonical_package.join("bin").join("codex-app-server")
+    );
+    assert_ne!(
+        std::fs::canonicalize(&destination)?,
+        std::fs::canonicalize(&source)?
+    );
+    assert!(canonical_package.join("codex-package.json").is_file());
+    assert_eq!(std::fs::read(&destination)?, std::fs::read(&source)?);
+
+    std::fs::remove_file(&destination)?;
+    let after = std::fs::metadata(&source)?;
+    assert_eq!((after.dev(), after.ino()), (before.dev(), before.ino()));
+    assert_eq!(after.permissions().mode(), before.permissions().mode());
+    assert_eq!(
+        (after.mtime(), after.mtime_nsec()),
+        (before.mtime(), before.mtime_nsec())
+    );
+    assert_eq!(after.nlink(), before.nlink());
+    tmp.close()?;
+    Ok(())
+}
