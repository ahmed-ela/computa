+                    ev_function_call(
+                        &format!("call_{index:016}"),
+                        "computer_v2_snapshot",
+                        &json!({"sequence":index}).to_string(),
+                    ),
+                    ev_completed_with_tokens(
+                        &format!("response-{index}"),
+                        if index == pair_count - 1 { 7000 } else { 10 },
+                    ),
+                ]),
+            )
+            .await,
+        );
+    }
+    let summary = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message(
+                "summary",
+                "The observations completed; answer without repeating any tool.",
+            ),
+            ev_completed_with_tokens("summary", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let continuation = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("final", "ALL_RECEIPTS_RETAINED"),
+            ev_completed_with_tokens("final", /*total_tokens*/ 10),
+        ]),
+    )
+    .await;
+    let mut png = std::io::Cursor::new(Vec::new());
+    image::DynamicImage::new_rgb8(/*w*/ 1, /*h*/ 1).write_to(&mut png, image::ImageFormat::Png)?;
+    let image_url = format!(
+        "data:image/png;base64,{}",
+        BASE64_STANDARD.encode(png.into_inner())
+    );
+    // The latest result has distinct capture metadata, a synchronized AX tree,
+    // and pixels. Its AX text alone exceeds the former shared 2 KiB cap.
+    let capture_metadata = "CAPTURE id=synthetic-capture-12 width=1280 height=900 screenshot_freshness=retained_original";
+    let latest_ax = format!(
+        "AXSNAPSHOT id=synthetic-ax-12 capture_id=synthetic-capture-12 shown=37 total=37 source_truncated=0 output_truncated=0 parents=[0:-]\n#0 role=\"AXWebArea\" label=\"Records\" actions=[] parent=-\n{}",
+        (1..=36).map(|index| format!("#{index} role=\"AXStaticText\" value=\"Record {index:02} status: pending review\" actions=[] parent=0\n")).collect::<String>()
+    );
+    assert!(latest_ax.len() > 3 * 1024);
+    assert!(capture_metadata.len() + latest_ax.len() <= 4096);
+    let mut dispatched = Vec::new();
+    let mut compactions = 0;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: format!("Perform the {pair_count} synthetic observations once, then answer."),
+            text_elements: vec![],
