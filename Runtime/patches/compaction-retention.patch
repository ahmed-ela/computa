+fn proven_native_read(id: &str, turn: &str, inventory: bool) -> Vec<ResponseItemEnvelope> {
+    use codex_protocol::dynamic_tools::NativeBrowserRead;
+    let mut result = pair(id, turn, "genuine prior page detail");
+    if let ResponseItem::FunctionCall { name, arguments, .. } = &mut result[0].item {
+        *name = if inventory { "browser_tabs" } else { "browser_read" }.into();
+        *arguments = if inventory { "{}" } else { r#"{"view":"content","query":"exact \"query\""}"# }.into();
+    }
+    result[1].metadata.as_mut().unwrap().native_browser_read = Some(if inventory { NativeBrowserRead::InventoryV1 } else { NativeBrowserRead::ReadV1 });
+    if let ResponseItem::FunctionCallOutput { output, .. } = &mut result[1].item { output.success = Some(true); }
+    result
+}
+
+fn proven_native_continuation(id: &str, turn: &str, cursor: &str) -> Vec<ResponseItemEnvelope> {
+    let mut result = proven_native_read(id, turn, false);
+    if let ResponseItem::FunctionCall { name, arguments, .. } = &mut result[0].item {
+        *name = "browser_continue".into();
+        *arguments = format!("{{ \"cursor\" : {} }}", serde_json::to_string(cursor).unwrap());
+    }
+    result[1].metadata.as_mut().unwrap().native_browser_read = Some(codex_protocol::dynamic_tools::NativeBrowserRead::ContinueV1);
+    result
+}
