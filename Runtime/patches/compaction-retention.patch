+#[test]
+fn final_historical_context_candidate_recovers_recorded_seventeen_pair_byte_pressure() {
+    // Same native tool sequence and latest 3,905-byte text size as the recorded
+    // 227 failure, using public synthetic content. Whitespace-only argument
+    // padding calibrates its exact 12,982-byte pre-fallback provider total.
+    let names = ["browser_tabs", "browser_open", "browser_read", "browser_read", "browser_navigate",
+        "browser_click", "browser_read", "browser_read", "browser_read", "browser_navigate",
+        "browser_read", "browser_read", "browser_click", "browser_read", "browser_fill", "browser_read", "browser_click"];
+    let mut history = Vec::new();
+    for (index, name) in names.iter().enumerate() {
+        let id = format!("recorded-shape-{index:02}");
+        let mut entries = if [2, 6, 7, 8, 10, 11, 13, 15].contains(&index) {
+            complete_browser_pair(&id, &native_browser_page(&[native_browser_row(0, &"a sufficiently long observed label ".repeat(10), "old-target")]))
+        } else if index == 14 || index == 16 {
+            complete_browser_action_pair(&id, if index == 14 { "fill" } else { "click" }, "x")
+        } else { pair(&id, "current", &"bounded prior evidence ".repeat(50)) };
+        if let ResponseItem::FunctionCall { name: tool, .. } = &mut entries[0].item { *tool = name.to_string(); }
+        history.extend(entries);
+    }
+    let latest_index = history.len() - 1;
+    let ResponseItem::FunctionCallOutput { output, .. } = &mut history[latest_index].item else { unreachable!() };
+    let FunctionCallOutputBody::ContentItems(items) = &mut output.body else { unreachable!() };
+    let FunctionCallOutputContentItem::InputText { text: cue } = &mut items[1] else { unreachable!() };
+    let mut value: serde_json::Value = serde_json::from_str(cue).unwrap();
+    value["label"] = json!(""); let label_len = 128 - value.to_string().len(); value["label"] = json!("a".repeat(label_len)); *cue = value.to_string();
+    let FunctionCallOutputContentItem::InputText { text: body } = &mut items[2] else { unreachable!() };
+    let mut value: serde_json::Value = serde_json::from_str(body).unwrap(); value["current_observation"]["text"] = json!("");
+    let page_len = 3728 - value.to_string().len(); value["current_observation"]["text"] = json!("x".repeat(page_len)); *body = value.to_string();
+    assert_eq!(output_text_bytes(&output.body), 3905);
+    let base = external_receipt_bytes(&minimum_receipt_candidate(&history, false));
+    assert!(base < 12982);
+    if let ResponseItem::FunctionCall { arguments, .. } = &mut history[latest_index - 1].item { arguments.push_str(&" ".repeat(12982 - base)); }
+    let ordinary = minimum_receipt_candidate(&history, false);
+    assert_eq!(external_receipt_bytes(&ordinary), 12982);
+    let expected = minimum_receipt_candidate(&history, true);
+    assert!(external_receipt_bytes(&expected) <= MAX_RECEIPT_BYTES);
+    let retained = super::current_turn_receipts(&history, "current", ReceiptProvider::External).unwrap();
+    assert_eq!(retained, expected);
+    assert_receipt_identity(&history, &retained);
+    assert_eq!(retained.last(), history.last());
+    assert_external_receipt_bounds(&retained);
+    assert_eq!(super::current_turn_receipts(&retained, "current", ReceiptProvider::External).unwrap(), retained);
+    // Exactly fill the fixed provider budget, then exceed it by one byte. The
+    // final candidate must not erase any further call, cue, row, or latest text.
+    let spare = MAX_RECEIPT_BYTES - external_receipt_bytes(&expected);
+    let mut boundary = history.clone();
+    if let ResponseItem::FunctionCall { arguments, .. } = &mut boundary[latest_index - 1].item { arguments.push_str(&" ".repeat(spare)); }
+    let exact = super::current_turn_receipts(&boundary, "current", ReceiptProvider::External).unwrap();
+    assert_eq!(external_receipt_bytes(&exact), MAX_RECEIPT_BYTES);
+    if let ResponseItem::FunctionCall { arguments, .. } = &mut boundary[latest_index - 1].item { arguments.push(' '); }
+    assert!(super::current_turn_receipts(&boundary, "current", ReceiptProvider::External).unwrap_err().to_string().contains("12 KiB"));
+}
