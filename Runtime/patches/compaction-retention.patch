+    request.instructions.push_str(&"x".repeat(room));
+    // This field can be assigned after the request builder returns.
+    request.prompt_cache_key = Some("late\"\\\n🧭".to_string());
+    let mut legacy = request.clone();
+    legacy
+        .client_metadata
+        .as_mut()
+        .unwrap()
+        .remove(CURRENT_USER_TEXT_PROOF_KEY);
+    assert!(serde_json::to_vec(&request).unwrap().len() > MAX_HTTP_BODY_BYTES);
+    assert!(serde_json::to_vec(&legacy).unwrap().len() <= MAX_HTTP_BODY_BYTES);
+    enforce_http_body_budget(&mut request);
+    assert_eq!(request, legacy);
+
+    request.instructions.push_str(&"x".repeat(1_024));
+    assert!(serde_json::to_vec(&request).unwrap().len() > MAX_HTTP_BODY_BYTES);
+    let oversized_legacy = request.clone();
+    enforce_http_body_budget(&mut request);
+    assert_eq!(request, oversized_legacy);
+    request.client_metadata = None;
