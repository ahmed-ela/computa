+    // A malformed native row in an older complete result cannot become a safe excerpt.
+    let mut invalid = complete_browser_pair("old", "#0 role=\"AXButton\" label=\"cut off");
+    invalid.extend(complete_browser_pair("new", "latest complete page"));
+    assert!(current_turn_receipts(&invalid, "current").unwrap_err().to_string().contains("malformed native row"));
