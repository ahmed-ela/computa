+                }
+            }
+            let items: Vec<_> = receipts.iter().map(|envelope| &envelope.item).collect();
+            let metadata: Vec<_> = receipts.iter().map(|envelope| &envelope.metadata).collect();
+            let canonical_bytes =
+                serde_json::to_vec(&items)?.len() + serde_json::to_vec(&metadata)?.len();
+            assert!(canonical_bytes <= 24 * 1024);
+        }
+    }
+    assert_eq!(checkpoints, 1);
+    Ok(())
+}
