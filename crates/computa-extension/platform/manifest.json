{
  "manifest_version": 3,
  "name": "Computa Browser Bridge",
  "version": "0.2.0",
  "key": "",
  "description": "Connect your explicitly paired Computa app to existing Chrome tabs.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Computa Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
  }
}
